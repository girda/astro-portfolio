---
import DemoNotice from "../../../../packages/ui/DemoNotice.astro";
import ReviewCarousel from '../../../../packages/ui/ReviewCarousel.astro';
import SiteMotion from '../../../../packages/ui/SiteMotion.astro';
import {site} from '../data/site';
import Icon from '../components/Icon.astro';
import Brand from '../../../../packages/ui/ServiceBrand.astro';
import DemoMenu from '../../../../packages/ui/DemoMenu.astro';
import '../../../../packages/ui/service-base.css';
import '../styles/purehaven.css';
const image=(file:string)=>`${import.meta.env.BASE_URL}images/${file}`;
const services=[
 {icon:'house',title:'Regelmäßige Reinigung',text:'Staub, Böden, Bad und Küche in einem passenden Rhythmus. Persönliche Prioritäten und empfindliche Oberflächen werden vorher abgestimmt.',photo:'living-room-v2.webp',pos:'center'},
 {icon:'shield-check',title:'Grundreinigung',text:'Für Bereiche, die im Alltag zu kurz kommen. Verschmutzung, erreichbare Flächen und gewünschte Extras bestimmen den Umfang.',photo:'kitchen.webp',pos:'center'},
 {icon:'wrench',title:'Einzug & Auszug',text:'Eine leere Wohnung ist ein guter Anfang. Zustand, Räume und Übergabetermin besprechen — ohne pauschales Versprechen einer Abnahme.',photo:'living-room-v2.webp',pos:'85% center'},
 {icon:'columns-2',title:'Fenster & Glas',text:'Mehr Licht. Klare Sicht. Fenster und erreichbare Glasflächen als Extra.',photo:'cleaning-family.webp',pos:'15% center'},
 {icon:'heart',title:'Familien-Zuhause',text:'Mehr Zeit füreinander. Ein Rhythmus, der zu deinem Alltag passt.',photo:'cleaning-family.webp',pos:'80% center'},
 {icon:'sparkles',title:'Deine Wunsch-Extras',text:'Backofen, Kühlschrank oder Fenster: Stell deine Reinigung selbst zusammen.',photo:'cleaning-team.webp',pos:'80% center'},
];
const benefits=[{icon:'heart',title:'Mehr Wohlfühlen',text:'Ein frisches Zuhause. Ein klarer Kopf.'},{icon:'users',title:'Persönlich gedacht',text:'Deine Räume. Deine Wünsche. Dein Rhythmus.'},{icon:'leaf',title:'Bewusst geplant',text:'Reinigung passend zu deinen Oberflächen.'},{icon:'shield-check',title:'Alles im Blick',text:'Leistungen und Beispielpreis vorab sehen.'}];
const links=[{label:'Leistungen',href:'#leistungen'},{label:'So geht’s',href:'#ablauf'},{label:'Über uns',href:'#ueber'},{label:'Preis berechnen',href:'#rechner'},{label:'Fragen',href:'#fragen'}];
---
<!doctype html><html lang="de"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="KLAR – ein helles Website-Konzept für einen Reinigungsservice. Leistungen entdecken und unverbindlichen Demo-Preis berechnen."/><meta name="robots" content="noindex,follow"/><title>KLAR — Komm heim. Alles klar.</title><link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml"/></head>
<body data-demo="cleaning" class="cleaning"><a class="skip" href="#main">Zum Inhalt</a>
<div class="cleaning-hero-shell"><header class="shell site-header"><Brand name="KLAR" tagline="Reinigungsservice" kind="cleaning"/><nav class="desktop-nav" aria-label="Hauptnavigation">{links.slice(0,4).map(l=><a href={l.href}>{l.label}</a>)}</nav><a class="cta header-cta" href="#rechner">Reinigung planen <Icon name="arrow"/></a><DemoMenu name="KLAR" links={links}/></header>
<div id="main"><section class="main-hero"><img class="hero-photo" src={image('cleaning-family.webp')} alt="Familie beim Spielen im hellen Wohnzimmer" width="1672" height="941" fetchpriority="high"/><div class="hero-overlay"></div><div class="shell"><div class="hero-copy"><h1>KOMM HEIM.<br/>ALLES KLAR.</h1><p class="hero-subtitle">Ein sauberes Zuhause.<br/>Mehr Zeit für dein Leben.</p><p class="hero-description">Für die kleinen Pausen und die großen Momente. Stell deine Reinigung zusammen — passend zu deinem Zuhause und deinem Alltag.</p><div class="actions"><a href="#rechner" class="cta">Reinigung planen <Icon name="arrow"/></a><a href="#leistungen" class="cta ghost">Leistungen ansehen <Icon name="arrow"/></a></div></div></div></section>
<section class="shell trust-strip" aria-label="Das Servicekonzept">{benefits.map(b=><article><span class="trust-icon"><Icon name={b.icon}/></span><div><h3>{b.title}</h3><p>{b.text}</p></div></article>)}</section>
</div></div>
<main aria-label="Leistungen und Planung">
<section class="shell space cleaning-services" id="leistungen"><div class="section-intro"><p class="eyebrow">Unsere Leistungen</p><h2>Saubere Räume.<br/><span class="accent">Ein besserer Alltag.</span></h2><p>Wähle die Reinigung, die zu deinem Zuhause und deinem Leben passt.</p><a href="#rechner" class="text-link">Deine Reinigung zusammenstellen <Icon name="arrow"/></a></div><div class="cleaning-service-grid">{services.map(s=><a href="#rechner" class="photo-service"><img src={image(s.photo)} alt={`${s.title}`} width="600" height="400" style={`object-position:${s.pos}`} loading="lazy"/><div><span class="service-bubble"><Icon name={s.icon}/></span><h3>{s.title}</h3><p>{s.text}</p></div></a>)}</div></section>
<section id="ueber" class="shell space split cleaning-about"><img class="split-photo" src={image('kitchen.webp')} alt="hellen Küche mit Eichenholz und natürlichen Materialien" width="900" height="650" loading="lazy"/><div><p class="eyebrow">Warum KLAR</p><h2>Mehr als sauber.<br/><span class="accent">Einfach aufatmen.</span></h2><p>Ein Zuhause soll sich nach Zuhause anfühlen. Deshalb beginnt gute Reinigung bei deinen Prioritäten: Welche Räume sind dir besonders wichtig, welche Materialien brauchen Rücksicht und welcher Rhythmus passt zu deinem Alltag? Extras werden bewusst ausgewählt, statt stillschweigend vorausgesetzt.</p><ul class="check-list"><li><Icon name="check"/>Ein klarer Überblick über jede Leistung</li><li><Icon name="check"/>Einmalig oder in deinem Rhythmus</li><li><Icon name="check"/>Passende Extras statt pauschaler Pakete</li><li><Icon name="check"/>Deine Auswahl jederzeit anpassen</li></ul><a class="cta ghost" href="#inklusive">Was ist inklusive? <Icon name="arrow"/></a></div><div class="watermark" aria-hidden="true"><Icon name="heart"/></div></section>
<section class="shell space" id="ablauf"><div class="section-intro"><p class="eyebrow">So funktioniert’s</p><h2>Einfach. Klar. Für dich.</h2></div><div class="steps">{[{icon:'calendar',title:'Deine Reinigung planen',text:'Wähle Räume, Bäder und den passenden Rhythmus.'},{icon:'sparkle',title:'Details festlegen',text:'Ergänze die Extras, die dir gerade wichtig sind.'},{icon:'home',title:'In Ruhe prüfen',text:'Sieh dir deine Auswahl und den Demo-Preis an.'},{icon:'heart',title:'Mehr Zeit gewinnen',text:'So könnte sich Unterstützung im Alltag anfühlen.'}].map(s=><article><span class="step-icon"><Icon name={s.icon}/></span><h3>{s.title}</h3><p>{s.text}</p></article>)}</div></section>
<section class="shell calculator" id="rechner" aria-labelledby="calc-title">
 <form method="dialog" id="calculator" data-pricing={JSON.stringify(site.pricing)}>
  <div class="calc-heading"><div><p class="eyebrow">WENIGE KLICKS. ALLES KLAR.</p><h2 id="calc-title">Was darf’s sein?</h2></div><span class="subtle">Küche & Flur inklusive</span></div>
  <div class="calc-grid">
   <div class="counter-field"><label for="rooms">Zimmer</label><div class="stepper"><button type="button" data-step="-1" data-for="rooms" aria-label="Weniger Zimmer"><Icon name="minus"/></button><input id="rooms" name="rooms" type="number" min="1" max="8" value="2" readonly aria-label="Anzahl Zimmer"/><button type="button" data-step="1" data-for="rooms" aria-label="Mehr Zimmer"><Icon name="plus"/></button></div></div>
   <div class="counter-field"><label for="baths">Bäder</label><div class="stepper"><button type="button" data-step="-1" data-for="baths" aria-label="Weniger Bäder"><Icon name="minus"/></button><input id="baths" name="baths" type="number" min="1" max="4" value="1" readonly aria-label="Anzahl Bäder"/><button type="button" data-step="1" data-for="baths" aria-label="Mehr Bäder"><Icon name="plus"/></button></div></div>
   <div class="frequency-field"><label for="frequency">Wie oft?</label><select id="frequency" name="frequency"><option value="1">Einmalig</option><option value="0.9">Alle zwei Wochen · −10 %</option><option value="0.85">Wöchentlich · −15 %</option></select></div>
   <div class="total"><span>Demo-Preis pro Reinigung</span><output id="price" aria-live="polite">79,00 €</output><button class="button" type="submit">Reinigung zusammenstellen <Icon name="arrow"/></button></div>
  </div>
  <details id="extras"><summary>Ein bisschen mehr Frische? <span>Extras hinzufügen <svg class="accordion-chevron" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></span></summary><div class="extras-grid">{site.extras.map(extra => <label class="extra"><input type="checkbox" name="extra" value={extra.price} data-name={extra.name}/><span>{extra.name}<small>+ {extra.price},00 €</small></span></label>)}</div></details>
  <p class="calculator-note">Unverbindlicher Beispielpreis. Keine echte Buchung. <span id="discount-note">Extras werden separat berechnet.</span></p>
  <noscript><p>Bitte aktiviere JavaScript, um den Demo-Preis zu berechnen.</p></noscript>
 </form>
</section>

<section id="inklusive" class="soft-section space"><div class="shell split"><div class="section-intro"><p class="eyebrow">Mit Liebe zum Detail</p><h2>Raum für Raum.<br/><span class="accent">Ein gutes Gefühl.</span></h2><p>Hier siehst du, was im Servicekonzept eingeplant ist. Besondere Materialien würden vor einem echten Termin abgestimmt.</p></div><div class="room-list faq">{site.rooms.map((r,i)=><details open={i===0}><summary>{r.name}<Icon name="chevron-down"/></summary><div class="answer"><ul>{r.items.map(item=><li><Icon name="check"/>{item}</li>)}</ul></div></details>)}</div></div></section>
<section class="shell space split" id="fragen"><div class="section-intro"><p class="eyebrow">Gut zu wissen</p><h2>Noch Fragen?<br/><span class="accent">Alles klar.</span></h2><p>Ein paar Antworten rund um deine Reinigung und diese Demo.</p></div><div class="faq">{site.faq.map(f=><details><summary>{f.q}<Icon name="chevron-down"/></summary><div class="answer"><p>{f.a}</p></div></details>)}</div></section>
<section class="shell bottom-cta" id="kontakt"><img src={image('cleaning-team.webp')} alt="zwei Reinigungskräfte mit Pflegeprodukten" width="1672" height="941" loading="lazy"/><div><p class="eyebrow">Bereit für ein bisschen mehr Leichtigkeit?</p><h2>Dein Zuhause verdient<br/>ein gutes Gefühl.</h2><a class="cta" href="#rechner">Reinigung planen <Icon name="arrow"/></a></div></section>
<ReviewCarousel project="cleaning" />
</main><footer class="shell site-footer"><div class="footer-main"><div><Brand name="KLAR" tagline="Komm heim. Alles klar." kind="cleaning"/><p>Ein Servicekonzept für die Momente, die wirklich zählen.</p></div><div><strong>Leistungen</strong><nav><a href="#leistungen">Regelmäßige Reinigung</a><a href="#leistungen">Grundreinigung</a><a href="#leistungen">Einzug & Auszug</a><a href="#extras">Deine Extras</a></nav></div><div><strong>Entdecken</strong><nav><a href="#ueber">Über KLAR</a><a href="#ablauf">So funktioniert’s</a><a href="#fragen">Häufige Fragen</a><a href="#rechner">Preis berechnen</a></nav></div><div><strong>Beispielregion</strong><nav><span>München</span><span>Schwabing</span><span>Haidhausen</span><span>Sendling</span></nav></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} KLAR</span><span>Keine echte Buchung. Keine Datenübermittlung. Alle Preise sind Beispiele.</span><a href="#main">Nach oben</a></div></footer>
<dialog id="summary-dialog" aria-labelledby="summary-title"><div class="dialog-top"><span class="eyebrow">DEINE AUSWAHL</span><button type="button" id="close-dialog" aria-label="Zusammenfassung schließen"><Icon name="x"/></button></div><h2 id="summary-title">Alles auf einen Blick.</h2><p id="summary-text"></p><ul id="summary-extras"></ul><div class="dialog-price"><span>Demo-Preis pro Reinigung</span><strong id="summary-price"></strong></div><p class="demo-explanation">Das ist eine Vorschau. Es wurde nichts gebucht und es werden keine Daten übermittelt.</p><button type="button" class="button" id="back-to-calc">Auswahl bearbeiten</button></dialog>
<script>
 const form = document.querySelector<HTMLFormElement>('#calculator')!;
 const rooms = document.querySelector<HTMLInputElement>('#rooms')!;
 const baths = document.querySelector<HTMLInputElement>('#baths')!;
 const frequency = document.querySelector<HTMLSelectElement>('#frequency')!;
 const price = document.querySelector<HTMLOutputElement>('#price')!;
 const pricing = JSON.parse(form.dataset.pricing!);
 const extras = () => [...form.querySelectorAll<HTMLInputElement>('input[name="extra"]:checked')];
 const currency = new Intl.NumberFormat('de-DE',{style:'currency',currency:'EUR'});
 const calculate = () => (pricing.base + (Number(rooms.value)-1)*pricing.room + (Number(baths.value)-1)*pricing.bathroom) * Number(frequency.value) + extras().reduce((sum,item)=>sum+Number(item.value),0);
 const update = () => {
  price.value = currency.format(calculate());
  form.querySelectorAll<HTMLButtonElement>('[data-step]').forEach(button=>{const field=button.dataset.for==='rooms'?rooms:baths;button.disabled=Number(button.dataset.step)<0?Number(field.value)<=Number(field.min):Number(field.value)>=Number(field.max);});
 };
 form.querySelectorAll<HTMLButtonElement>('[data-step]').forEach(button=>button.addEventListener('click',()=>{const field=button.dataset.for==='rooms'?rooms:baths;field.value=String(Math.max(Number(field.min),Math.min(Number(field.max),Number(field.value)+Number(button.dataset.step))));update();}));
 form.addEventListener('change',update);update();
 const dialog = document.querySelector<HTMLDialogElement>('#summary-dialog')!;
 form.addEventListener('submit',event=>{event.preventDefault();document.querySelector('#summary-text')!.textContent=`${rooms.value} Zimmer · ${baths.value} ${Number(baths.value)===1?'Bad':'Bäder'} · Küche & Flur inklusive. ${frequency.selectedOptions[0].textContent}.`;document.querySelector('#summary-price')!.textContent=currency.format(calculate());const list=document.querySelector('#summary-extras')!;list.replaceChildren(...extras().map(extra=>{const li=document.createElement('li');li.textContent=`${extra.dataset.name}: ${currency.format(Number(extra.value))}`;return li;}));dialog.showModal();});
 document.querySelector('#close-dialog')!.addEventListener('click',()=>dialog.close());
 document.querySelector('#back-to-calc')!.addEventListener('click',()=>dialog.close());
 // Keep native details semantics and animate both opening and closing.
 document.querySelectorAll<HTMLDetailsElement>('.faq details,.room-list details').forEach(details=>{
  const summary=details.querySelector('summary')!;const answer=details.querySelector<HTMLElement>('.answer')!;let animation:Animation|null=null;let expanded=details.open;
  summary.addEventListener('click',event=>{if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;event.preventDefault();const start=details.getBoundingClientRect().height;expanded=animation?!expanded:!details.open;animation?.cancel();details.open=true;const end=summary.getBoundingClientRect().height+(expanded?answer.getBoundingClientRect().height:0);details.style.overflow='hidden';animation=details.animate({height:[`${start}px`,`${end}px`]},{duration:260,easing:'ease-out'});animation.onfinish=()=>{details.open=expanded;details.style.overflow='';animation=null;};});
 });
</script>
<SiteMotion /><DemoNotice/></body></html>
