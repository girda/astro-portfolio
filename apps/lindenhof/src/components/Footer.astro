---
import Logo from './Logo.astro';import {menuItems,menuHref} from '../data/navigation';const base=import.meta.env.BASE_URL;
---
<footer class="site-footer"><div class="container" data-motion="up"><div class="footer-invite"><p class="eyebrow">DEIN NÄCHSTER WEG</p><h2>Einsteigen beginnt<br/>mit einem Gespräch.</h2><a class="button footer-cta" href={`${base}#kontakt`}>Probefahrt anfragen <span>↗</span></a></div><div class="footer-top"><div><Logo light/><p>Autos entdecken. Möglichkeiten verstehen.<br/>Persönlich den nächsten Schritt gehen.</p></div><nav aria-label="Footernavigation">{menuItems.map(item=>item.path?<a href={menuHref(item.path,base)}>{item.label}</a>:<button data-development>{item.label}</button>)}</nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Autohaus Lindenhof</span><div><button data-development>Barrierefreiheit</button></div><a href="#top">Nach oben ↑</a></div></div></footer>
