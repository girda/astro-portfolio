---
import Logo from './Logo.astro';import Icon from './Icon.astro';import NavigationTree from './NavigationTree.astro';import {menuItems} from '../data/navigation';
const base=import.meta.env.BASE_URL;
---
<div class="header-sentinel" aria-hidden="true"></div><header class="site-header"><div class="header-top"><button class="menu-trigger" aria-label="Menü öffnen" aria-haspopup="dialog" aria-controls="navigation-dialog" aria-expanded="false"><Icon name="menu"/><span>Menü</span></button><Logo/><div class="header-actions"><a href={`${base}#fahrzeuge`}><Icon name="car"/><span>Fahrzeuge</span></a><a href={`${base}#kontakt`}><Icon name="calendar"/><span>Probefahrt</span></a><a href={`${base}#standorte`}><Icon name="pin"/><span>Kontakt</span></a></div></div><div class="header-nav-shell"><nav class="header-nav" aria-label="Hauptnavigation"><NavigationTree items={menuItems}/></nav></div></header><div class="header-space" aria-hidden="true"></div>
<dialog id="navigation-dialog" class="dialog navigation-dialog" aria-labelledby="menu-title"><div class="dialog-toolbar"><h2 id="menu-title">Entdecke Lindenhof.</h2><button class="close-button" data-close aria-label="Menü schließen"><Icon name="close"/></button></div><nav aria-label="Navigation"><NavigationTree items={menuItems} drawer/></nav><a class="drawer-contact" href={`${base}#kontakt`}>Deine Probefahrt beginnt hier. <span>↗</span></a></dialog>
<dialog id="development-dialog" class="dialog development-dialog" aria-labelledby="dialog-title"><div class="dialog-toolbar"><span>LINDENHOF / NÄCHSTER SCHRITT</span><button class="close-button" data-close aria-label="Fenster schließen"><Icon name="close"/></button></div><div class="workshop-gears" aria-hidden="true">{[1,2].map((n)=><svg class={`gear gear-${n}`} viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="9"><path d="M43 7h14l3 14 10 6 14-4 7 12-10 10v11l10 10-7 12-14-4-10 6-3 14H43l-3-14-10-6-14 4-7-12 10-10V45L9 35l7-12 14 4 10-6z"/><circle cx="50" cy="50" r="15" stroke-width="5"/></svg>)}</div><p class="eyebrow">GUTE DINGE BRAUCHEN FEINSCHLIFF</p><h2 id="dialog-title">Hier entsteht etwas Neues.</h2><p id="dialog-message">Dieser Bereich ist noch in Entwicklung. Entdecke inzwischen unsere Fahrzeuge oder stelle uns deine Fragen direkt.</p><button class="button" data-close>Weiter entdecken <span>→</span></button></dialog>
<script>import {initNavigation} from '../scripts/navigation';initNavigation();</script>
