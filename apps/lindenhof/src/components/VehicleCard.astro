---
import Icon from "./Icon.astro";
import Button from "./Button.astro";
import { vehicles } from "../data/site";
interface Props {
  vehicle: (typeof vehicles)[number];
}
const { vehicle: v } = Astro.props;
const asset = (name: string) => `${import.meta.env.BASE_URL}assets/${name}`;
---

<article class="vehicle-card" data-category={v.category} data-vehicle={v.id}>
  <div class="vehicle-label">
    <span>{v.brand}</span>
    <div class="vehicle-actions">
      <button
        class="icon-button compare"
        data-development
        aria-label={`${v.name} vergleichen`}
      >
        <Icon name="compare" />
      </button>
      <button
        class="icon-button save"
        data-save={v.id}
        aria-label={`${v.name} merken`}
        aria-pressed="false"
      >
        <Icon name="heart" />
      </button>
    </div>
  </div>
  <div class="vehicle-photo">
    <img
      src={asset(v.image)}
      alt={`${v.name} — Demofahrzeug`}
      loading="lazy"
      width="464"
      height="310"
    />
    <img
      class="vehicle-angle"
      src={asset(v.angle)}
      alt=""
      loading="lazy"
      width="464"
      height="310"
    />
  </div>
  <div class="vehicle-info">
    <h3>{v.name}</h3>
    <p>{v.description}</p>
    <ul>
      {v.features.map(([icon, label]) => (
        <li>
          <Icon name={icon} />
          <span>{label}</span>
        </li>
      ))}
    </ul>
    <Button data-development>Modell entdecken</Button>
  </div>
</article>

<script>
  for(const card of document.querySelectorAll<HTMLElement>('.vehicle-card')){
    const photo=card.querySelector<HTMLElement>('.vehicle-photo')!;
    const alternate=photo.querySelector<HTMLImageElement>('.vehicle-angle')!;
    const reduced=matchMedia('(prefers-reduced-motion: reduce)');
    let ready=false,wanted=false,timer:ReturnType<typeof setTimeout>|undefined;
    const show=()=>{
      clearTimeout(timer);
      if(!ready)return;
      if(reduced.matches){photo.dataset.angle=String(wanted);photo.removeAttribute('data-switching');return;}
      photo.setAttribute('data-switching','');
      timer=setTimeout(()=>{photo.dataset.angle=String(wanted);photo.removeAttribute('data-switching');},100);
    };
    // Смена ракурса доступна только после декодирования: на hover нет сетевой паузы.
    const prepare=async()=>{try{alternate.loading='eager';await alternate.decode();ready=true;if(wanted)show();}catch{/* Основной снимок остаётся видимым при ошибке загрузки. */}};
    const observer=new IntersectionObserver(entries=>{if(entries.some(e=>e.isIntersecting)){observer.disconnect();void prepare();}},{rootMargin:'300px'});observer.observe(card);
    card.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse'){wanted=true;show();}});
    card.addEventListener('pointerleave',()=>{wanted=false;show();});
    card.addEventListener('focusin',()=>{wanted=true;show();});
    card.addEventListener('focusout',e=>{if(!card.contains(e.relatedTarget as Node)){wanted=false;show();}});
  }
</script>
