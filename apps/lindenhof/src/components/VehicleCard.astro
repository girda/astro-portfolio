---
import Icon from "./Icon.astro";
import Button from "./Button.astro";
import { vehicles } from "../data/site";
interface Props {
  vehicle: (typeof vehicles)[number];
}
const { vehicle: v } = Astro.props;
const asset = (name: string) => `${import.meta.env.BASE_URL}assets/${name}`;
---

<article class="vehicle-card" data-category={v.category} data-vehicle={v.id}>
  <div class="vehicle-label">
    <span>{v.brand}</span>
    <div class="vehicle-actions">
      <button
        class="icon-button compare"
        data-development
        aria-label={`${v.name} vergleichen`}
      >
        <Icon name="compare" />
      </button>
      <button
        class="icon-button save"
        data-save={v.id}
        aria-label={`${v.name} merken`}
        aria-pressed="false"
      >
        <Icon name="heart" />
      </button>
    </div>
  </div>
  <a class="vehicle-photo" href={`${import.meta.env.BASE_URL}fahrzeuge/${v.id}/`} aria-label={`${v.name} entdecken`}>
    <img
      src={asset(v.image)}
      alt={v.name}
      loading="lazy"
      width="464"
      height="310"
    />
    <img
      class="vehicle-angle"
      src={asset(v.angle)}
      alt=""
      loading="lazy"
      width="464"
      height="310"
    />
  </a>
  <div class="vehicle-info">
    <h3><a href={`${import.meta.env.BASE_URL}fahrzeuge/${v.id}/`}>{v.name}</a></h3>
    <p>{v.description}</p>
    <ul>
      {v.features.map(([icon, label]) => (
        <li>
          <Icon name={icon} />
          <span>{label}</span>
        </li>
      ))}
    </ul>
    <Button href={`${import.meta.env.BASE_URL}fahrzeuge/${v.id}/`}>Modell entdecken</Button>
  </div>
</article>

<script>
 for(const card of document.querySelectorAll<HTMLElement>('.vehicle-card')){
  const photo=card.querySelector<HTMLElement>('.vehicle-photo')!,alternate=photo.querySelector<HTMLImageElement>('.vehicle-angle')!;
  let ready=false,wanted=false;
  const sync=()=>{photo.dataset.angle=String(ready&&wanted);};
  const observer=new IntersectionObserver(entries=>{if(entries.some(e=>e.isIntersecting)){observer.disconnect();alternate.loading='eager';alternate.decode().then(()=>{ready=true;sync();}).catch(()=>{});}},{rootMargin:'400px'});observer.observe(card);
  card.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse'){wanted=true;sync();}});card.addEventListener('pointerleave',()=>{wanted=false;sync();});
  card.addEventListener('focusin',()=>{wanted=true;sync();});card.addEventListener('focusout',e=>{if(!card.contains(e.relatedTarget as Node)){wanted=false;sync();}});
 }
</script>
