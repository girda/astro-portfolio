---
import '../../../../packages/ui/edge-carousel.css';
import Icon from './Icon.astro';
const items=[['Klarheit beim Vergleichen','Ich möchte verstehen, welches Auto wirklich zu meinem Alltag passt.','Modelle, Platzbedarf und Ausstattung in Ruhe gegenüberstellen.','car'],['Transparenz beim Entscheiden','Ich möchte die Möglichkeiten verstehen, bevor ich mich festlege.','Kauf, Finanzierung und Leasing mit den richtigen Fragen angehen.','shield'],['Ein gutes Gefühl beim Losfahren','Ich möchte mich mit meinem nächsten Auto vertraut machen.','Probefahrt, Bedienung und offene Fragen gehören zusammen.','calendar']];
---
<section class="section customer-perspectives"><div class="container" data-motion="up"><div class="perspectives-heading"><div><p class="eyebrow">DEINE FRAGEN ZÄHLEN</p><h2>Was sich beim Autokauf<br/>richtig anfühlen sollte.</h2></div><p>Drei Gedanken, die eine persönliche Beratung leichter machen.</p></div><div class="perspectives-track" data-edge-carousel tabindex="0" aria-label="Kundenperspektiven">{items.map(([label,quote,text,icon])=><article><Icon name={icon}/><span class="perspective-label">{label}</span><blockquote>„{quote}“</blockquote><p>{text}</p></article>)}</div></div></section>
<style>.customer-perspectives{background:#f0f4ec}.perspectives-heading{display:flex;align-items:end;gap:40px;justify-content:space-between;margin-bottom:36px}.perspectives-heading h2{font-size:clamp(30px,4vw,48px);line-height:1.15;font-weight:400;letter-spacing:-.035em}.perspectives-heading>p{max-width:290px;color:#68786d;line-height:1.7}.perspectives-track{display:flex;gap:22px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:18px}.perspectives-track article{flex:0 0 calc((100% - 44px)/3);padding:30px;border:1px solid #cedbca;background:#fff;border-radius:12px;display:flex;flex-direction:column;scroll-snap-align:start}.perspectives-track :global(.icon){color:#244d42;margin-bottom:25px}.perspective-label{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#6f8672}blockquote{font-size:23px;line-height:1.5;letter-spacing:-.025em;margin:20px 0 25px;flex:1}.perspectives-track p{font-size:14px;line-height:1.8;color:#68786d;margin:0}@media(max-width:900px){.perspectives-heading{display:block}.perspectives-heading>p{margin-top:20px}.perspectives-track article{flex-basis:80%}}@media(max-width:500px){.perspectives-track article{flex-basis:94%;padding:25px}blockquote{font-size:21px}}</style>
