---
interface Props {
  name: string;
  class?: string;
}
const { name, class: className = "" } = Astro.props;
const files: Record<string, string> = {
  menu: "Frame",
  close: "LucideX",
  car: "LucideCar",
  calendar: "LucideCalendar",
  pin: "LucidePin",
  compare: "LucideGitCompareArrows",
  heart: "LucideHeart",
  body: "LucideCarFront",
  users: "LucideUsers",
  shield: "LucideShieldCheck",
  gauge: "LucideGauge",
  left: "LucideChevronLeft",
  right: "LucideChevronRight",
  play: "LucideCirclePlay",
};
const src = `${import.meta.env.BASE_URL}assets/desktop-img${files[name] || files.car}.svg`;
---

<span class:list={["icon", className]} aria-hidden="true">
  {name==='play'?<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="m8 5 11 7-11 7V5Z"/></svg>:name==='pause'?<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>:name==='compare'?<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v17M5 21h14M4 7h16M6 7 2 14h8L6 7Zm12 0-4 7h8l-4-7Z"/></svg>:<img src={src} alt="" />}
</span>
