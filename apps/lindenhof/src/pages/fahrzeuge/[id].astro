---
import Layout from '../../layouts/EditorialLayout.astro';import Button from '../../components/Button.astro';import {vehicles} from '../../data/site';
export function getStaticPaths(){return vehicles.map(vehicle=>({params:{id:vehicle.id},props:{vehicle}}));}
const {vehicle:v}=Astro.props;const base=import.meta.env.BASE_URL;
---
<Layout title={v.name} description={v.description}><section class="editorial-hero"><div class="container"><div><p class="eyebrow">{v.brand} / {v.category}</p><h1>{v.name}</h1><p>{v.description} Entdecke, wie Sitzposition, Raumgefühl und Bedienung zu deinen Wegen passen.</p><Button href={`${base}#kontakt`}>Probefahrt anfragen <span>↗</span></Button></div><img src={`${base}assets/${v.image}`} width="1200" height="800" alt={v.name}/></div></section><section class="section"><div class="container editorial-content"><article><h2>Im Alltag erleben.</h2><p>Nimm dir Zeit für die Fragen, die auf deinen täglichen Wegen zählen: Übersicht, Einsteigen, Parken und der Platz für deine Dinge.</p></article><article><h2>Details vergleichen.</h2><p>Eine konkrete Ausstattungsvariante entscheidet über die verfügbaren Funktionen. Kläre die Details am jeweiligen Fahrzeug, bevor du dich festlegst.</p></article><article><h2>Persönlich kennenlernen.</h2><p>Eine Probefahrt hilft, Erwartungen mit dem eigenen Eindruck abzugleichen. Stelle deine Fragen und bespreche den nächsten Schritt.</p></article></div></section></Layout>
