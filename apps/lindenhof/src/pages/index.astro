---
import '../../../../packages/ui/edge-carousel.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Locations from '../components/Locations.astro';
import CustomerPerspectives from '../components/CustomerPerspectives.astro';
import SiteMotion from '../components/SiteMotion.astro';
import "../styles/global.css";
import "../styles/experience.css";
import "../styles/refinement.css";
import Icon from "../components/Icon.astro";
import Button from "../components/Button.astro";
import InputField from "../components/InputField.astro";
import VehicleCard from "../components/VehicleCard.astro";
import { vehicles, ownership } from "../data/site";
const base = import.meta.env.BASE_URL;
const asset = (n: string) => `${base}assets/${n}`;
const canonical = Astro.site ? new URL(base, Astro.site).href : undefined;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#244d42" />
    <title>Autohaus Lindenhof — Dein nächstes Auto.</title>
    <meta
      name="description"
      content="Entdecke Autohaus Lindenhof: Fahrzeuge, persönliche Beratung und Probefahrten. Persönliche Beratung, Modelle und Möglichkeiten."
    />
    <meta
      property="og:title"
      content="Autohaus Lindenhof — Dein nächstes Auto."
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:description"
      content="Persönlich. Vor Ort. Lindenhof."
    />
    <meta
      property="og:image"
      content={
        Astro.site
          ? new URL(
              asset("desktop-imgLindenhofShowroomForestGreenSignage.png"),
              Astro.site,
            ).href
          : asset("desktop-imgLindenhofShowroomForestGreenSignage.png")
      }
    />
    {canonical && <link rel="canonical" href={canonical} />}
    <link
      rel="icon"
      href={asset("desktop-imgLindenhofLAndRoadForestGreen.svg")}
      type="image/svg+xml"
    />
    <link
      rel="preload"
      href={asset("dm-sans-400.ttf")}
      as="font"
      type="font/ttf"
      crossorigin
    />
  </head>
  <body data-demo="lindenhof" id="top">
    <a class="skip-link" href="#main">
      Zum Inhalt
    </a>
    <Header />
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <picture>
          <source
            media="(max-width: 640px)"
            srcset={asset("showroom-portrait.webp")}
            width="900"
            height="1350"
          />
          <img
            class="hero-image"
            src={asset("desktop-imgLindenhofShowroomForestGreenSignage.png")}
            alt="Lichtdurchfluteter Lindenhof-Salon mit Fahrzeugen und persönlicher Beratung"
            fetchpriority="high"
            width="1536"
            height="1024"
          />
        </picture>
        <div class="hero-gradient"></div>
        <div class="hero-copy">
          <p class="eyebrow">AUTOHAUS LINDENHOF</p>
          <h1 id="hero-title">
            Dein nächstes Auto.
            <br />
            Dein neuer Anfang.
          </h1>
          <p>Entdecke unsere Auswahl und finde dein nächstes Lieblingsauto.</p>
          <Button href="#fahrzeuge">Fahrzeuge entdecken</Button>
        </div>
      </section>
      <section
        class="section models paper"
        id="fahrzeuge"
        aria-labelledby="models-title"
      >
        <div class="container" data-motion="left">
          <p class="eyebrow">FAHRZEUGE ENTDECKEN</p>
          <h2 id="models-title">Welches Auto passt zu dir?</h2>
          <div class="filters" role="group" aria-label="Fahrzeugkategorien">
            {["Alle Modelle", "Kompakt", "Limousine", "Roadster"].map(
              (label, i) => (
                <button
                  class:list={["filter", { active: i === 0 }]}
                  aria-pressed={i === 0 ? "true" : "false"}
                  data-filter={label}
                >
                  {label}
                </button>
              ),
            )}
          </div>
          <div class="catalogue-slider"><div class="vehicle-carousel" data-edge-carousel aria-label="Fahrzeuge" tabindex="0">
            {vehicles.map((v) => (
              <VehicleCard vehicle={v} />
            ))}
          </div>
          <button class="slider-arrow slider-prev" type="button" data-slide="-1" aria-label="Vorherige Fahrzeuge"><Icon name="left"/></button><button class="slider-arrow slider-next" type="button" data-slide="1" aria-label="Nächste Fahrzeuge"><Icon name="right"/></button></div>
        </div>
      </section>
      <section
        class="section paper"
        id="beratung"
        aria-labelledby="advice-title"
      >
        <div class="container advice-grid" data-motion="right">
          <div class="advice-copy">
            <p class="eyebrow">LINDENHOF ASSISTENT</p>
            <h2 id="advice-title">
              Noch unsicher?
              <br />
              Finden wir dein Auto.
            </h2>
            <p>
              Erzähl uns, was dir wichtig ist. Wir helfen dir, die passende
              Richtung zu finden.
            </p>
            <Button id="advice-start">Beratung ausprobieren</Button>
          </div>
          <div class="assistant-panel">
            <h3>Was soll dein nächstes Auto können?</h3>
            <p>
              Viel Platz, entspannt pendeln oder am Wochenende einfach
              losfahren?
            </p>
            <div class="assistant-choices">
              <button data-advice="familie">Platz für die Familie</button>
              <button data-advice="alltag">Entspannt zur Arbeit</button>
              <button data-advice="spass">Fahrspaß am Wochenende</button>
            </div>
            <form class="assistant-input">
              <label for="advice-input">
                Oder beschreibe deinen Wunsch in eigenen Worten.
              </label>
              <div>
                <input
                  id="advice-input"
                  name="wish"
                  placeholder="Was ist dir wichtig?"
                  maxlength="300"
                  required
                />
                <button
                  class="icon-button"
                  type="submit"
                  aria-label="Wunsch absenden"
                >
                  <Icon name="right" />
                </button>
              </div>
            </form>
            <div
              id="advice-result"
              class="advice-result"
              aria-live="polite"
              hidden
            ></div>

          </div>
        </div>
      </section>
      <section class="section" aria-labelledby="film-title">
        <div class="container stack" data-motion="left">
          <p class="eyebrow">MORGEN FÄHRT MIT</p>
          <h2 id="film-title">Mehr erleben. Weiter denken.</h2>
          <p class="section-intro">
            Entdecke neue Perspektiven — unterwegs und hinter dem Lenkrad.
          </p>
          <div class="film">
            <video
              id="driving-film"
              loop
              muted
              playsinline
              preload="none"
              poster={asset("desktop-imgDrivingFilmPoster.png")}
              data-src={asset("driving-film.mp4")}
              aria-label="Fahrzeug auf einer Küstenstraße"
            ></video>
            <div class="film-shade"></div>
            <button class="film-play" aria-label="Film abspielen">
              <Icon name="play" />
            </button>
            <button class="film-pause" hidden aria-label="Film pausieren">
              <Icon name="pause" />
            </button>
          </div>
        </div>
      </section>
      <section
        class="section ownership"
        id="erwerb"
        aria-labelledby="ownership-title"
      >
        <div class="container stack" data-motion="right">
          <div class="section-heading">
            <p class="eyebrow">DEIN WEG ZUM AUTO</p>
            <h2 id="ownership-title">Dein Auto. Dein Weg.</h2>
            <p class="section-intro">
              Kaufen, leasen oder dein Auto in Zahlung geben. Finde den Weg, der
              zu dir passt.
            </p>
          </div>
          <div class="tabs" role="tablist" aria-label="Weg zum Fahrzeug">
            {ownership.map((item, i) => (
              <button
                role="tab"
                id={`tab-${item.id}`}
                aria-controls={`panel-${item.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
              >
                <span class="tab-desktop">{item.label}</span>
                <span class="tab-mobile">{item.short}</span>
              </button>
            ))}
          </div>
          {ownership.map((item, i) => (
            <div
              role="tabpanel"
              id={`panel-${item.id}`}
              aria-labelledby={`tab-${item.id}`}
              hidden={i !== 0}
              class="ownership-panel"
            >
              <div class="ownership-copy">
                <h3>{item.label}</h3>
                <p>{item.description}</p>
                <Button href="#kontakt" data-interest={item.label}>
                  {item.cta}
                </Button>
              </div>
              <img
                src={asset(item.image)}
                alt={item.alt}
                loading="lazy"
                width="1536"
                height="1024"
              />
            </div>
          ))}
        </div>
      </section>
      <section class="section" id="ueber-uns" aria-labelledby="about-title">
        <div class="container about-grid" data-motion="left">
          <img
            class="about-photo"
            src={asset("desktop-imgLindenhofShowroomAiGenerated.png")}
            alt="Persönliche Schlüsselübergabe im Lindenhof-Salon"
            loading="lazy"
            width="1536"
            height="1024"
          />
          <div class="about-copy">
            <p class="eyebrow">AUTOHAUS LINDENHOF</p>
            <h2 id="about-title">
              Persönlich.
              <br />
              Vor Ort. Lindenhof.
            </h2>
            <p>
              Ein Auto wählt man nicht nur auf dem Bildschirm. Sitzposition,
              Kofferraum, Übersicht und Fahrgefühl zeigen erst beim Kennenlernen,
              ob ein Modell zu deinem Alltag passt. Eine Probefahrt schafft Raum
              für genau diese Fragen.
            </p>
            <p>
              Vom ersten Vergleich bis zur Übergabe gehören auch die Details dazu:
              vorhandene Ausstattung, Unterlagen und ein verständlicher Blick auf
              die Kosten. So entsteht ein verständlicher Weg vom ersten Gespräch bis zur gemeinsamen Entscheidung.
            </p>
          </div>
          <figure class="showroom-moment">
            <img src={asset("lindenhof-consultation.webp")} alt="Persönliche Beratung am Tisch im Lindenhof-Salon" width="1672" height="941" loading="lazy" />
            <figcaption><h3>Erst vergleichen. Dann entscheiden.</h3><p>Deine Wege, dein Platzbedarf und deine Fragen geben der Beratung die Richtung. Gemeinsam werden aus vielen Möglichkeiten die passenden nächsten Schritte.</p></figcaption>
          </figure>
          <figure class="showroom-moment">
            <img src={asset("lindenhof-delivery.webp")} alt="Schlüsselübergabe neben einer blauen Limousine im Lindenhof-Salon" width="1672" height="941" loading="lazy" />
            <figcaption><h3>Ein guter Start gehört dazu.</h3><p>Bei einer Übergabe zählen auch die kleinen Details: Bedienung kennenlernen, Unterlagen durchgehen und offene Fragen in Ruhe klären.</p></figcaption>
          </figure>
        </div>
      </section>
      <section
        class="section paper"
        id="kontakt"
        aria-labelledby="contact-title"
      >
        <div class="container stack" data-motion="right">
          <div class="section-heading">
            <p class="eyebrow">WIR FREUEN UNS AUF DICH</p>
            <h2 id="contact-title">
              Dein nächster Schritt?
              <br />
              Eine Probefahrt.
            </h2>
            <p class="section-intro">
              Sag uns, welches Auto dich interessiert. Wir melden uns bei dir
              und stimmen den Termin persönlich ab.
            </p>
          </div>
          <div class="contact-grid">
            <form id="test-drive-form">
              <div class="form-row">
                <InputField
                  name="name"
                  label="Dein Name"
                  placeholder="Vor- und Nachname"
                  required
                  autocomplete="name"
                />
                <InputField
                  name="contact"
                  label="Telefon oder E-Mail"
                  placeholder="So erreichen wir dich"
                  required
                  autocomplete="email"
                />
              </div>
              <InputField
                name="vehicle"
                label="Dein Wunschauto"
                placeholder="Modell oder Fahrzeug (optional)"
              />
              <InputField
                name="message"
                label="Deine Nachricht"
                placeholder="Was möchtest du uns mitgeben? (optional)"
                textarea
              />
              <p class="caption">
                Wir verwenden deine Angaben, um deine Anfrage zu beantworten.
                Mehr dazu in der{" "}
                <button type="button" class="text-link" data-development>
                  Datenschutzerklärung
                </button>
                .
              </p>
              <Button type="submit">Probefahrt anfragen</Button>

            </form>
            <aside class="contact-card">
              <h3>Komm vorbei.</h3>
              <strong>Autohaus Lindenhof</strong>
              <p>
                München
                <br />
                Deinen Besuch stimmen wir persönlich ab.
              </p>
              <p>
                Montag–Freitag&nbsp; 09:00–18:00
                <br />
                Samstag&nbsp; 10:00–14:00
              </p>
              <span class="green">kontakt@lindenhof.example</span>

            </aside>
          </div>
        </div>
      </section>
      <Locations />
    <CustomerPerspectives />
</main>
    <Footer />
    <script>
      import "../scripts/site";
    </script>
  <SiteMotion /></body>
</html>
