---
import Layout from '../layouts/EditorialLayout.astro';import Button from '../components/Button.astro';const base=import.meta.env.BASE_URL;
const items=[['Wartung mit Überblick','Welche Arbeiten sinnvoll sind, hängt von Modell, Laufleistung und Herstellervorgaben ab. Wir besprechen den Umfang, bevor etwas beauftragt wird.'],['Räder, Reifen & Saison','Profil, Zustand und die passende Bereifung gehören zusammen. Plane den Wechsel rechtzeitig und kläre, was für dein Fahrzeug vorgesehen ist.'],['Fragen zu deinem Fahrzeug','Ein Geräusch, eine Warnmeldung oder eine Frage zur Bedienung? Beschreibe, was dir aufgefallen ist. Eine technische Beurteilung erfolgt am Fahrzeug.']];
---
<Layout title="Service, der weiterdenkt" description="Wartung, Räder und persönliche Unterstützung für dein Fahrzeug."><section class="editorial-hero"><div class="container" data-motion="up"><div><p class="eyebrow">LINDENHOF / SERVICE</p><h1>Gut begleitet.<br/>Auch nach dem Einsteigen.</h1><p>Ein Auto bleibt ein Stück Alltag. Mit verständlichen nächsten Schritten und einem klar abgestimmten Serviceumfang.</p><Button href={`${base}#kontakt`}>Service besprechen <span>↗</span></Button></div><img src={`${base}assets/lindenhof-delivery.webp`} width="1672" height="941" alt="Persönliche Fahrzeugübergabe im Salon"/></div></section><section class="section"><div class="container editorial-content" data-motion="up">{items.map(([title,text])=><article><h2>{title}</h2><p>{text}</p></article>)}</div></section><section class="section paper"><div class="container about-grid" data-motion="up"><img class="about-photo" src={`${base}assets/lindenhof-consultation.webp`} width="1672" height="941" alt="Beratung zum Fahrzeug am Tisch" loading="lazy"/><div><p class="eyebrow">ERST VERSTEHEN. DANN ENTSCHEIDEN.</p><h2>Deine Fragen haben Platz.</h2><p>Bringe Informationen zu Modell und Baujahr mit und beschreibe dein Anliegen. So lässt sich das Gespräch gezielt vorbereiten, ohne eine Diagnose vorwegzunehmen.</p><Button href={`${base}#kontakt`}>Kontakt aufnehmen <span>→</span></Button></div></div></section></Layout>
