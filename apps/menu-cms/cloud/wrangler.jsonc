{
  "name": "hirda-menu-cms",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-06",
  "account_id": "ad933102ca4c570aa0c733a42f4eee7c",
  "workers_dev": true,
  "assets": {
    "directory": "../.cloud-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hirda-menu-cms",
      "database_id": "68122d51-125a-4ad3-8873-c812967b5899"
    }
  ],
  "vars": {
    "ADMIN_EMAIL": "artem.girda@gmail.com",
    "ACCESS_TEAM_DOMAIN": "quiet-field-901f.cloudflareaccess.com",
    "ACCESS_AUD": "25dbf1670692f9952e28dc945bc8f63570df4055ba70a889c84524be1ccccc17"
  }
}
