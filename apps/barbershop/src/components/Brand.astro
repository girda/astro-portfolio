---
interface Props { href?: string }
const { href = '#top' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<a class="kant-brand" href={href} aria-label="KANT Barbershop — Startseite">
  <img src={`${base}/brand/kant-seal.svg`} width="86" height="86" alt="" />
  <span>Haar. Bart.<br />Handwerk.</span>
</a>
