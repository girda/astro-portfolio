---
import ReviewCarousel from '../../../../packages/ui/ReviewCarousel.astro';
import '../styles/paper.css';
import '../styles/dialog.css';
import Brand from '../components/Brand.astro';
import Navigation from '../components/Navigation.astro';
import Services from '../components/Services.astro';
import Gallery from '../components/Gallery.astro';
import CareProducts from '../components/CareProducts.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import BookingDialog from '../components/BookingDialog.astro';
import PhoneDialog from '../components/PhoneDialog.astro';
import Motion from '../components/Motion.astro';
import Icon from '../components/Icon.astro';
import { site, navigation } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KANT — Haar. Bart. Handwerk.</title>
    <meta name="description" content="KANT: Schnitte, Bart und Pflege mit Charakter. Entdecke Schnitte, Bartpflege, Looks und eine persönliche Pflegeauswahl." />
    <meta name="robots" content="noindex, nofollow" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content="KANT — Haar. Bart. Handwerk." />
    <meta property="og:description" content="Ein Barbershop-Konzept von HIRDA. Guter Schnitt. Echter Charakter." />
    <meta property="og:type" content="website" />
    {Astro.site && <meta property="og:image" content={new URL(`${base}/images/interior-paper.jpg`, Astro.site).href} />}
    <link rel="icon" type="image/svg+xml" href={`${base}/brand/kant-seal.svg`} />
    <meta name="theme-color" content="#f3e7d0" />
  </head>
  <body data-demo="barbershop">
    <a class="skip-link" href="#main">Zum Inhalt</a>

    <header class="paper-header" id="top"><Brand /><Navigation /></header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy"><p class="kicker">DEIN STIL. UNSER HANDWERK.</p>
          <h1 id="hero-title">Guter Schnitt.<span>Echter<br />Charakter.</span></h1>
          <p class="lead">Haare, Bart und Zeit für dich.<br />Willkommen bei KANT.</p>
          <div class="actions"><button class="btn" type="button" data-open-booking aria-haspopup="dialog" aria-controls="booking-dialog" hidden>Termin buchen</button><a class="btn secondary" href="#leistungen">Leistungen & Preise</a></div>
          <div class="hero-note"><Icon name="scissors" /><span>Ein guter Schnitt bleibt im Kopf.</span></div>
        </div>
        <figure class="scene"><img src={`${base}/images/interior-paper.jpg`} width="1536" height="1024" alt="Salonentwurf mit Lederstühlen, warmem Holz und Betonboden" fetchpriority="high" /><figcaption class="photo-label">KANT / BARBER & GROOMING</figcaption></figure>
      </section>
      <div class="paper-end" aria-hidden="true"><span>HAAR. BART. HANDWERK.</span><span><i></i> BLEIB DIR TREU.</span><span>KANT / BARBERSHOP</span></div>
      <Services />
      <section id="studio" class="section-block salon" aria-labelledby="studio-title">
        <div class="container split-layout">
          <div class="salon-copy" data-reveal><p class="kicker">DER SALON</p><h2 id="studio-title">Ankommen.<br /><em>Zurücklehnen.</em></h2>
            <p class="section-intro">Ein guter Schnitt beginnt mit einem guten Gespräch. Was gefällt dir? Was passt zu deinem Alltag? Und wie soll sich dein Look anfühlen?</p>
            <p>Ein Foto kann die Richtung zeigen. Entscheidend ist, wie der Schnitt mit deinem Haar funktioniert und wie viel Zeit du morgens investieren möchtest. Bei KANT zählen klare Linien, ein entspannter Besuch und ein Look, den du selbst gut stylen kannst.</p>
            <a class="text-link" href="#ablauf">So läuft dein Besuch ab</a>
          </div>
          <figure class="salon-image" data-reveal><img src={`${base}/images/interior-paper.jpg`} width="1536" height="1024" alt="Warme Holzdetails und klassische Barberstühle im KANT-Salonentwurf" loading="lazy" /><figcaption>Ein Raum für gutes Handwerk.</figcaption></figure>
        </div>
      </section>
      <Gallery />
      <CareProducts />
      <section id="ablauf" class="section-block ritual" aria-labelledby="ritual-title">
        <div class="container"><div class="section-heading" data-reveal><div><p class="kicker">DEIN BESUCH</p><h2 id="ritual-title">Kein Zufall.<br /><em>Dein Look.</em></h2></div><p class="section-description">Drei Schritte, die zusammenpassen.<br />Vom ersten Gespräch bis zum Finish.</p></div>
          <div class="visit-steps">
            <article data-reveal><Icon name="comb" /><h3>Erst mal reden.</h3><p>Wünsche, Haar und Alltag: Gemeinsam finden wir die Richtung für deinen Schnitt.</p></article>
            <article data-reveal><Icon name="scissors" /><h3>Sauber arbeiten.</h3><p>Schnitt, Übergänge und Konturen. Die kleinen Details machen den Unterschied.</p></article>
            <article data-reveal><Icon name="razor" /><h3>Gut rausgehen.</h3><p>Das passende Finish und ein Pflegetipp, mit dem du zu Hause etwas anfangen kannst.</p></article>
          </div>
        </div>
      </section>
      <div id="fragen" class="section-block faq-wrap"><div class="container"><Faq items={site.faq} /></div></div>
      <div class="section-block contact-wrap"><div class="container"><Contact /></div></div>
      <section class="closing"><div class="container closing-inner"><div><p class="kicker">BEREIT FÜR FRISCHEN WIND?</p><h2>Dein Stuhl.<br /><em>Dein nächster Look.</em></h2></div><div><button class="btn" type="button" data-open-booking aria-haspopup="dialog" aria-controls="booking-dialog" hidden>Leistung auswählen</button><p class="small-note">Demo ansehen · Keine echte Buchung</p></div></div></section>
    <ReviewCarousel project="barbershop" />
</main>
    <footer class="paper-footer container"><div class="footer-top"><Brand /><nav aria-label="Footer-Navigation">{navigation.filter(link => link.desktop).map(link => <a href={link.href}>{link.label}</a>)}</nav><a class="back-top" href="#top" aria-label="Nach oben"><Icon name="chevron-left" /></a></div><div class="footer-bottom"><span>© {new Date().getFullYear()} KANT</span></div></footer>
    <BookingDialog /><PhoneDialog /><Motion />
    <script>
      // Закрытие по фону работает только вне прямоугольника диалога.
      document.querySelectorAll<HTMLDialogElement>('dialog:not(.kant-menu)').forEach(dialog => {
        dialog.addEventListener('click', event => {
          if (event.target !== dialog) return;
          const box = dialog.getBoundingClientRect();
          if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) dialog.close();
        });
      });
    </script>
  </body>
</html>
