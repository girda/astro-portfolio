---
import "../styles/theme.css";
import Motion from "../components/Motion.astro";
import { site } from "../data/site";
import BookingDialog from "../components/BookingDialog.astro";
import Gallery from "../components/Gallery.astro";
import Contact from "../components/Contact.astro";
import Faq from "../components/Faq.astro";
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta
      name="description"
      content="KANT Barbershop — ein Website-Konzept für Haarschnitte, Bartpflege und deinen eigenen Stil."
    />

    <meta name="robots" content="noindex, nofollow" />

    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%23181917'/%3E%3Ctext x='32' y='47' text-anchor='middle' font-family='Arial' font-size='44' font-weight='700' fill='%23d6a078'%3EK%3C/text%3E%3C/svg%3E"
    />

    <title>{site.name} — {site.subtitle} · Demo</title>
  </head>

  <body>
    <a class="skip-link" href="#main">Zum Inhalt</a>

    <div class="demo-banner">
      Designkonzept · Fiktiver Salon · Keine echte Terminbuchung
    </div>

    <header class="container header">
      <a class="brand" href="/" aria-label={`${site.name} — Startseite`}>
        <span class="brand-name">{site.name}<span>.</span></span>
        <span class="brand-subtitle">{site.subtitle}</span>
      </a>

      <nav class="navigation" aria-label="Hauptnavigation">
        <a href="#leistungen">Leistungen</a>
        <a href="#einblicke">Einblicke</a>
        <a href="#fragen">FAQ</a>
        <a href="#kontakt">Kontakt</a>
      </nav>

      <button
        class="button header-button"
        type="button"
        data-open-booking
        aria-haspopup="dialog"
        aria-controls="booking-dialog"
        hidden
      >
        Termin · Demo
      </button>
    </header>

    <main id="main">
      <section class="container hero" aria-labelledby="hero-title">
        <div class="hero-copy" data-reveal>
          <p class="eyebrow hero-eyebrow">HAARSCHNITT & BARTPFLEGE</p>

          <h1 id="hero-title">
            DEIN STIL.<br />
            <span>KLARE KANTE.</span>
          </h1>

          <p class="hero-description">{site.description}</p>

          <div class="hero-actions">
            <button
              class="button"
              type="button"
              data-open-booking
              aria-haspopup="dialog"
              aria-controls="booking-dialog"
              hidden
            >
              Termin ausprobieren
            </button>

            <a class="text-link" href="#leistungen">Preise ansehen</a>
          </div>

          <p class="hero-note">Dein Look. Unser Handwerk.</p>
        </div>

        <figure class="hero-visual">
          <img
            src="/images/barbershop.webp"
            alt="Barbershop-Interieur mit klassischen Ledersesseln und großen Spiegeln"
            width="5044"
            height="2837"
            fetchpriority="high"
            decoding="async"
          />

          <figcaption>
            <span>DER RAUM FÜR DEINEN STIL.</span>
            <span>KANT / CONCEPT</span>
          </figcaption>
        </figure>
      </section>

      <div class="container signature" aria-hidden="true">
        <span>PRÄZISION IM DETAIL.</span>
        <span>CHARAKTER IM SCHNITT.</span>
      </div>

      <section
        id="leistungen"
        class="services"
        aria-labelledby="services-title"
      >
        <div class="container">
          <div class="section-heading" data-reveal>
            <div>
              <p class="eyebrow">01 / LEISTUNGEN</p>
              <h2 id="services-title">
                DEIN LOOK.<br />
                DEINE WAHL.
              </h2>
            </div>

            <p class="section-description">
              Schnitt, Bart oder beides. Hier findest du unser
              beispielhaftes Angebot mit Preisen und Behandlungszeiten.
            </p>
          </div>

          <div class="service-list">
            {
              site.services.map((service) => (
                <article class="service" data-reveal>
                  <span class="service-number" aria-hidden="true">
                    {service.number}
                  </span>

                  <div class="service-info">
                    <h3>{service.title}</h3>
                    <p>{service.description}</p>
                  </div>

                  <div class="service-price">
                    <strong>{service.price}</strong>
                    <span>{service.duration}</span>
                  </div>

                  <button
                    class="service-book"
                    type="button"
                    data-open-booking
                    data-service={service.title}
                    aria-label={`Termin für ${service.title} ausprobieren`}
                    aria-haspopup="dialog"
                    aria-controls="booking-dialog"
                    hidden
                  >
                    Auswählen
                  </button>
                </article>
              ))
            }
          </div>

          <p class="price-note">
            Demo-Angebot: Alle Preise und Zeitangaben sind Beispiele.
          </p>
        </div>
      </section>

      <div id="einblicke">
        <Gallery />
      </div>

      <Contact />

      <div id="fragen">
        <Faq items={site.faq} />
      </div>

      <section class="container closing" data-reveal aria-labelledby="closing-title">
        <div>
          <p class="eyebrow">DEIN NÄCHSTER SCHNITT</p>
          <h2 id="closing-title">BEREIT FÜR<br />KLARE KANTE?</h2>
        </div>

        <div class="closing-action">
          <button
            class="button"
            type="button"
            data-open-booking
            aria-haspopup="dialog"
            aria-controls="booking-dialog"
            hidden
          >
            Buchung ausprobieren
          </button>

          <p>Unverbindliche Demo. Keine echte Buchung.</p>
        </div>
      </section>
    </main>

    <footer class="container footer">
      <a class="footer-brand" href="/">{site.name}.</a>
      <p>Ein Barbershop-Konzept von Artem.</p>
      <span>© {new Date().getFullYear()} · Demo-Projekt</span>
    </footer>

    <BookingDialog />
    <Motion />
  </body>
</html>

