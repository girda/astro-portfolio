---
import Layout from '../layouts/Layout.astro';
import HouseCarousel from '../components/HouseCarousel.astro';
import Icon from '../../../../packages/ui/Icon.astro';
import houses from '../data/houses.json';
const base=import.meta.env.BASE_URL;
const services=[['house','Hausbau aus einer Hand','Planung, Gebäudehülle und Technik als abgestimmtes Ganzes.'],['panels-top-left','Innenräume mit Charakter','Materialien, Licht und Raumgefühl für deinen Alltag.'],['ruler','Individuelle Architektur','Ein Entwurf, der Grundstück und Lebensweise zusammenbringt.'],['thermometer','Energie mit Konzept','Gebäude und Technik von Anfang an gemeinsam denken.'],['trees','Garten & Außenräume','Terrassen und Grünflächen als Erweiterung deines Zuhauses.'],['message-circle','Persönliche Begleitung','Fragen klären und Entscheidungen verständlich vorbereiten.']];
---
<Layout title="Dein Haus. Von der ersten Idee an." home>
<section class="hero"><picture class="hero-picture"><source media="(max-width:600px)" srcset={`${base}images/hero-mobile.webp`}/><img class="hero-image" src={`${base}images/auenblick.webp`} width="1672" height="941" alt="Moderne Villa aus Holz und Stein in einem angelegten Waldgarten" fetchpriority="high"/></picture><div class="hero-shade"></div><div class="container hero-copy"><h1>Individuelle Häuser aus Stein und Holz.<br/>{' '}Für das Leben, das du dir wünschst.</h1><p>Architektur, Planung und Hausbau — von der ersten Idee bis ins Detail.</p><div class="hero-actions"><a class="button" href="#hausfinder">Dein Bauvorhaben besprechen</a><ul><li><Icon name="check"/>Dein Grundstück als Ausgangspunkt</li><li><Icon name="check"/>Materialien bewusst auswählen</li><li><Icon name="check"/>Schritt für Schritt gemeinsam planen</li></ul></div></div><a class="hero-scroll" href="#projekte" aria-label="Häuser entdecken"><Icon name="arrow-down"/></a></section>
<section class="section projects-section" id="projekte"><div class="container section-heading" data-reveal><h2>UNSERE HAUSIDEEN</h2><p>Architektur mit Raum für deinen Alltag. Entdecke unterschiedliche Bauweisen und finde eine erste Richtung für dein Zuhause.</p><a class="button dark" href={`${base}katalog/`}>HÄUSER ENTDECKEN</a></div><div class="container"><HouseCarousel compact label="Unsere sechs Hausideen"/></div></section>
<section class="section quiz-section" id="hausfinder"><div class="container quiz-layout"><div data-reveal><p class="eyebrow">DEIN WEG ZUM PASSENDEN HAUS</p><h2>Welche Hausidee<br/>passt zu dir?</h2><p>Vier kurze Schritte helfen dir, deine Wünsche zu sortieren. Du erhältst eine passende Auswahl und eine Zusammenfassung.</p><div class="quiz-meta"><span>4 Schritte</span><span>Ohne Anmeldung</span><span>Deine Daten bleiben hier</span></div></div><form class="quiz-card" data-quiz><div class="quiz-progress"><span data-quiz-step>1 / 4</span><div><i></i></div></div><fieldset data-step="0"><legend>Wie möchtest du bauen?</legend><label><input type="radio" name="material" value="Holz" checked/> Natürlich mit Holz</label><label><input type="radio" name="material" value="Massiv"/> Klar und massiv</label><label><input type="radio" name="material" value="Hybrid"/> Holz und Stein kombinieren</label><label><input type="radio" name="material" value=""/> Noch offen</label></fieldset><fieldset data-step="1" hidden><legend>Wie viel Raum brauchst du?</legend><label><input type="radio" name="size" value="compact" checked/> Kompakt · bis 140 m²</label><label><input type="radio" name="size" value="family"/> Für die Familie · 140–200 m²</label><label><input type="radio" name="size" value="large"/> Großzügig · ab 200 m²</label></fieldset><fieldset data-step="2" hidden><legend>Wie möchtest du wohnen?</legend><label><input type="radio" name="floors" value="1" checked/> Alles auf einer Ebene</label><label><input type="radio" name="floors" value="2"/> Auf zwei Geschossen</label><label><input type="radio" name="floors" value=""/> Noch offen</label></fieldset><fieldset data-step="3" hidden><legend>Wo stehst du gerade?</legend><label><input type="radio" name="stage" value="Erste Ideen" checked/> Ich sammle erste Ideen</label><label><input type="radio" name="stage" value="Grundstückssuche"/> Ich suche ein Grundstück</label><label><input type="radio" name="stage" value="Grundstück vorhanden"/> Ich habe ein Grundstück</label></fieldset><div class="quiz-controls"><button class="text-link" type="button" data-quiz-back hidden>← Zurück</button><button class="button" type="submit">Weiter</button></div><div data-quiz-result hidden aria-live="polite"></div></form></div></section>
<section class="section container" id="leistungen"><div class="section-heading" data-reveal><h2>RAUM FÜR GUTE LÖSUNGEN</h2><p>Ein Haus besteht aus vielen Entscheidungen.<br/>Wir machen die Zusammenhänge verständlich.</p></div><div class="services-layout"><div class="service-list">{services.map(([icon,title,text],i)=><button data-service={i} type="button" aria-pressed={i===0?'true':'false'}><span>0{i+1}</span><div><strong>{title}</strong><p>{text}</p></div><Icon name="arrow-up-right"/></button>)}</div><div class="service-image"><img src={`${base}images/steinbach.webp`} alt="Lichtdurchflutetes Haus mit Holz und Naturstein" width="1672" height="941" loading="lazy"/><span data-service-caption>Hausbau aus einer Hand</span></div></div></section>
<section class="section approach-section" id="ueber-uns"><div class="container approach-layout"><div class="approach-photo" data-reveal><img src={`${base}images/steinbach.webp`} width="1672" height="941" alt="Materialien, Licht und Architektur einer Hausidee" loading="lazy"/><span>FALKENRIED / UNSER ANSATZ</span></div><div class="approach-copy" data-reveal><p class="eyebrow">GUT GEPLANT FÜHLT SICH GUT AN</p><h2>Ein Zuhause beginnt<br/>mit deinem Alltag.</h2><p>Wie du morgens aufwachst. Wo ihr zusammenkommt. Und was sich später verändern darf. Daraus entwickeln wir eine klare Richtung für dein Haus.</p><div class="approach-points">{[['message-circle','Zuerst verstehen','Wir ordnen Wohnwünsche, Budgetrahmen und Fragen zum Grundstück.'],['ruler','Zusammen entwerfen','Raumprogramm, Materialien und Tageslicht werden gemeinsam gedacht.'],['house','Klar weitergehen','Du weißt, welche Entscheidungen anstehen und was als Nächstes geklärt wird.']].map(([icon,title,text])=><article><Icon name={icon}/><div><h3>{title}</h3><p>{text}</p></div></article>)}</div><a class="button" href="#beratung">Über deine Hausidee sprechen</a></div></div></section>
<section class="section container" id="ablauf"><div class="section-heading" data-reveal><h2>WAS EIN GUTES GEFÜHL GIBT</h2><p>Ein klarer Prozess schafft Orientierung.<br/>Von der ersten Frage bis zum nächsten Schritt.</p></div><div class="benefit-layout"><img src={`${base}images/tannengrund.webp`} width="1672" height="941" alt="Holzhaus mit großzügigem Dach und offener Terrasse" loading="lazy"/><div>{[['Deine Wünsche zuerst','Wir klären Nutzung, Raumbedarf und die Besonderheiten deines Grundstücks.'],['Entscheidungen mit Überblick','Bauweise, Materialien und Ausstattung werden verständlich gegenübergestellt.'],['Ein gemeinsamer Stand','Ein abgestimmter Entwurf macht offene Fragen und nächste Schritte sichtbar.']].map(([title,text])=><details><summary>{title}<Icon name="chevron-down"/></summary><p>{text}</p></details>)}</div></div></section>
<section class="section stories-section" id="einblicke"><div class="container"><div class="section-heading" data-reveal><p class="eyebrow">ARCHITEKTUR ZUM WEITERDENKEN</p><h2>Welches Haus fühlt<br/>sich nach dir an?</h2><p>Vom kompakten Rückzugsort bis zum großzügigen Familienhaus: Entdecke Raumideen, Bauweisen und die Details dahinter.</p><a class="button outline" href={`${base}katalog/`}>Zum Hauskatalog</a></div><HouseCarousel label="Hausideen mit Ausstattung und Details"/></div></section>
<section class="section container consultation-section" id="beratung"><div data-reveal><p class="eyebrow">DEINE FRAGEN SIND EIN GUTER ANFANG</p><h2>Lass uns über<br/>dein Zuhause sprechen.</h2><p>Ein Grundstück, eine Idee oder erst ein Gefühl? Halte fest, was dir wichtig ist.</p></div><form class="consult-form contact-card"><label>Dein Name<input name="name" required autocomplete="name" maxlength="100"/></label><label>E-Mail oder Telefon<input name="contact" required maxlength="150"/></label><label>Deine Hausidee<textarea name="message" rows="3" maxlength="1500"/></label><button class="button" type="submit">Gespräch vorbereiten</button><p class="small muted">Lokale Demonstration. Es wird keine Nachricht versendet.</p></form></section>
</Layout>
