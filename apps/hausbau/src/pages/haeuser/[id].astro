---
import Layout from '../../layouts/Layout.astro';
import HouseCard from '../../components/HouseCard.astro';
import Icon from '../../../../../packages/ui/Icon.astro';
import houses from '../../data/houses.json';
export function getStaticPaths(){return houses.map(house=>({params:{id:house.id},props:{house}}));}
const {house:h}=Astro.props;
const base=import.meta.env.BASE_URL;
---
<Layout title={h.name} description={h.description}><section class="detail-page container"><nav class="breadcrumbs" aria-label="Brotkrumen"><a href={base}>Startseite</a><span>—</span><a href={`${base}katalog/`}>Hauskatalog</a><span>—</span><span>{h.name}</span></nav><div class="detail-heading"><div><p class="eyebrow">{h.material} · {h.style}</p><h1>{h.name}</h1></div><button type="button" class="button outline" data-compare={h.id} aria-pressed="false"><Icon name="columns-2"/>Zum Vergleich</button></div><div class="detail-layout"><img class="detail-photo" src={`${base}images/${h.image}.webp`} width="1672" height="941" alt={`Hausidee ${h.name}`} fetchpriority="high"/><div class="detail-summary"><p class="eyebrow">RAUM FÜR DEIN LEBEN</p><h2>Ein Entwurf.<br/>Viele Möglichkeiten.</h2><p>{h.description}</p><div class="detail-facts"><span><Icon name="ruler"/><strong>{h.area} m²</strong>Wohnfläche</span><span><Icon name="layers"/><strong>{h.floors}</strong>Geschosse</span><span><Icon name="bed-double"/><strong>{h.bedrooms}</strong>Schlafzimmer</span><span><Icon name="bath"/><strong>{h.bathrooms}</strong>Bäder</span></div><button class="button" type="button" data-consult data-house-name={h.name}>Diese Hausidee besprechen <Icon name="arrow-right"/></button><p class="small muted">Fiktiver Entwurf, kein Verkaufsangebot. Die konkrete Planung richtet sich nach Grundstück und Anforderungen.</p></div></div></section><section class="section plan-section"><div class="container plan-layout"><div data-reveal><p class="eyebrow">VON DER IDEE ZUM RAUM</p><h2>Wie möchtest du wohnen?</h2><p>Gemeinsame Räume, Rückzugsorte und kurze Wege. Die Raumaufteilung wird im echten Projekt auf dich abgestimmt.</p><p class="small muted">Schematische Raumidee zur Demonstration, kein maßstäblicher oder baurechtlich geprüfter Grundriss.</p><div class="project-tabs" role="group" aria-label="Etage auswählen"><button data-floor="0" aria-pressed="true">Erdgeschoss</button>{h.floors>1&&<button data-floor="1" aria-pressed="false">Obergeschoss</button>}</div></div><div class="floor-plan" data-floor-plan><svg viewBox="0 0 620 390" role="img" aria-label="Schematische Raumaufteilung"><path fill="#faf9f5" stroke="#365b59" stroke-width="5" d="M32 30h552v320H32z"/><path fill="none" stroke="#365b59" stroke-width="4" d="M365 30v320M365 165h219M180 30v105H32M365 255h219"/><path stroke="#faf9f5" stroke-width="8" d="M90 30h100M32 220v70m552-90v35M220 350h90"/><g fill="#365b59" font-family="Arial,sans-serif" font-size="18" text-anchor="middle"><text x="195" y="220" data-plan-label="living">Wohnen / Essen</text><text x="106" y="88" data-plan-label="small">Arbeiten</text><text x="475" y="110" data-plan-label="room">Küche</text><text x="475" y="220">Diele</text><text x="475" y="310" data-plan-label="bath">Bad</text></g><g stroke="#a4b7ac" stroke-width="2" fill="none"><path d="M80 170h150v90H80zM90 180h130v25H90zM400 50h140v40H400zM400 275h90v35h-90z"/></g></svg></div></div></section><section class="section container"><div class="section-heading"><h2>WEITERE HAUSIDEEN</h2><a class="text-link" href={`${base}katalog/`}>Alle Häuser <Icon name="arrow-right"/></a></div><div class="related-houses">{houses.filter(other=>other.id!==h.id).slice(0,3).map(house=><HouseCard house={house}/>)}</div></section></Layout>
