---
import Layout from '../../layouts/Layout.astro';
import HouseCard from '../../components/HouseCard.astro';
import FloorPlan from '../../components/FloorPlan.astro';
import Icon from '../../../../../packages/ui/Icon.astro';
import houses from '../../data/houses.json';
export function getStaticPaths(){return houses.map(house=>({params:{id:house.id},props:{house}}));}
const {house:h}=Astro.props;
const base=import.meta.env.BASE_URL;
---
<Layout title={h.name} description={h.description}><section class="detail-page container"><nav class="breadcrumbs" aria-label="Brotkrumen"><a href={base}>Startseite</a><span>—</span><a href={`${base}katalog/`}>Hauskatalog</a><span>—</span><span>{h.name}</span></nav><div class="detail-heading"><div><p class="eyebrow">{h.material} · {h.style}</p><h1>{h.name}</h1></div><button type="button" class="button outline" data-compare={h.id} aria-pressed="false"><Icon name="scale"/>Zum Vergleich</button></div><div class="detail-layout"><img class="detail-photo" src={`${base}images/${h.image}.webp`} width="1672" height="941" alt={`Hausidee ${h.name}`} fetchpriority="high"/><div class="detail-summary"><p class="eyebrow">RAUM FÜR DEIN LEBEN</p><h2>Ein Entwurf.<br/>Viele Möglichkeiten.</h2><p>{h.description}</p><div class="detail-facts"><span><Icon name="ruler"/><strong>{h.area} m²</strong>Wohnfläche</span><span><Icon name="layers"/><strong>{h.floors}</strong>Geschosse</span><span><Icon name="bed-double"/><strong>{h.bedrooms}</strong>Schlafzimmer</span><span><Icon name="bath"/><strong>{h.bathrooms}</strong>Bäder</span></div><button class="button" type="button" data-consult data-house-name={h.name}>Diese Hausidee besprechen</button><p class="small muted">Fiktiver Entwurf, kein Verkaufsangebot. Die konkrete Planung richtet sich nach Grundstück und Anforderungen.</p></div></div></section><section class="section container plan-visual-section"><div class="section-heading"><div><p class="eyebrow">RÄUME ERLEBEN</p><h2>Ein Blick hinein.</h2></div><p>Materialien, Möbel und Wege im Zusammenspiel. Eine beispielhafte Wohnidee zur Inspiration — kein modellspezifischer Grundriss.</p></div><button type="button" class="plan-render-link" data-open-plan aria-haspopup="dialog" aria-controls="plan-dialog" aria-label="3D-Raumidee in voller Größe öffnen"><img src={`${base}images/raumidee-3d.webp`} width="1536" height="1024" alt="Möblierte 3D-Raumidee mit offener Wohnküche, Arbeitszimmer und zentraler Diele" loading="lazy"/><span><Icon name="maximize"/>Ansicht vergrößern</span></button></section><section class="section plan-section"><div class="container plan-layout"><div data-reveal><p class="eyebrow">VON DER IDEE ZUM RAUM</p><h2>Wie möchtest du wohnen?</h2><p>Gemeinsame Räume, Rückzugsorte und kurze Wege. Die Raumaufteilung wird im echten Projekt auf dich abgestimmt.</p><p class="small muted">Schematische Raumidee zur Demonstration, kein maßstäblicher oder baurechtlich geprüfter Grundriss.</p></div><FloorPlan floors={h.floors}/></div></section><section class="section container"><div class="section-heading"><h2>WEITERE HAUSIDEEN</h2><a class="text-link" href={`${base}katalog/`}>Alle Häuser</a></div><div class="related-houses">{houses.filter(other=>other.id!==h.id).slice(0,3).map(house=><HouseCard house={house}/>)}</div></section></Layout>
