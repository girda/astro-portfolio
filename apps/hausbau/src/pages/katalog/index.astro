---
import Layout from '../../layouts/Layout.astro';
import HouseCard from '../../components/HouseCard.astro';
import Icon from '../../../../../packages/ui/Icon.astro';
import houses from '../../data/houses.json';
const base=import.meta.env.BASE_URL;
const groups=[['materials','WANDMATERIAL',['Holz','Massiv','Hybrid']],['floors','GESCHOSSE',['1','2']],['bedrooms','SCHLAFZIMMER',['2','3','4']],['styles','ARCHITEKTUR',['Modern','Chalet','Barnhaus']],['roofs','DACHFORM',['Flachdach','Satteldach']]];
---
<Layout title="Hauskatalog"><section class="catalogue-page container"><nav class="breadcrumbs" aria-label="Brotkrumen"><a href={base}>Startseite</a><span>—</span><span>Alle Hausideen</span></nav><h1>HÄUSER FÜR DEIN LEBEN</h1><div class="catalogue-layout"><aside class="filter-sidebar" aria-label="Katalogfilter"><form id="catalogue-filters"><div class="filter-heading"><Icon name="sliders-horizontal"/><h2>DEINE AUSWAHL</h2></div>{groups.map(([name,label,values],index)=><><fieldset><legend>{label}</legend><div class:list={['filter-options',{'number-options':name==='floors'||name==='bedrooms'}]}>{(values as string[]).map(value=><label><input type="checkbox" name={name as string} value={value}/><span>{value}</span></label>)}</div></fieldset>{index===0&&<fieldset><legend>WOHNFLÄCHE, m²</legend><div class="area-fields"><label><span>Von</span><input type="number" name="min" aria-label="Wohnfläche von" value="0" min="0" max="400"/></label><span>–</span><label><span>Bis</span><input type="number" name="max" aria-label="Wohnfläche bis" value="400" min="0" max="400"/></label></div><input class="area-range" type="range" data-area-range aria-label="Maximale Wohnfläche" min="50" max="400" value="400" step="5"/></fieldset>}</>)}<p class="range-error" data-range-error role="status" hidden>Die obere Fläche muss mindestens so groß wie die untere sein.</p><button class="button" type="submit">HÄUSER ANZEIGEN</button><button class="reset-button" type="reset">Auswahl zurücksetzen</button></form></aside><div class="catalogue-results"><div class="catalogue-toolbar"><div class="project-tabs" role="group" aria-label="Bauweise"><button data-category="" aria-pressed="true">Alle Hausideen</button><button data-category="Holz" aria-pressed="false">Holzhäuser</button><button data-category="Massiv" aria-pressed="false">Massivhäuser</button><button data-category="Hybrid" aria-pressed="false">Hybridbau</button></div><label class="sort-control"><Icon name="sliders-horizontal"/><select data-sort aria-label="Häuser sortieren"><option value="recommended">Empfehlung</option><option value="area-asc">Fläche: aufsteigend</option><option value="area-desc">Fläche: absteigend</option><option value="name">Name: A–Z</option></select></label></div><div class="search-row"><label class="catalogue-search"><Icon name="search"/><input id="search" type="search" data-search placeholder="Hausname oder Bauweise suchen" aria-label="Hausname oder Bauweise suchen"/></label><button class="filter-toggle" type="button" data-open-filters><Icon name="sliders-horizontal"/>Filter</button><output data-result-count aria-live="polite">6 Hausideen</output></div><div class="catalogue-grid" data-catalogue-grid>{houses.map(h=><HouseCard house={h}/>)}</div><div class="empty-state" data-empty-state hidden><Icon name="house"/><h2>Dein Haus ist noch nicht dabei.</h2><p>Versuche eine größere Fläche oder eine andere Bauweise.</p><button class="button" type="button" data-reset-filters>Filter zurücksetzen</button></div><p class="catalogue-note">Fiktive Hausideen und Beispielgrößen zur Demonstration. Keine Verkaufsangebote.</p></div></div></section><dialog id="filters-dialog" class="drawer filter-drawer" aria-labelledby="filters-title"><div class="dialog-toolbar"><h2 id="filters-title">Deine Filter</h2><button class="icon-button" data-close aria-label="Filter schließen"><Icon name="x"/></button></div><div data-filter-mount></div></dialog><script>import { initCatalogue } from '../../scripts/catalogue';initCatalogue();</script></Layout>
