---
import Logo from './Logo.astro';
import Icon from '../../../../packages/ui/Icon.astro';
const base=import.meta.env.BASE_URL;
---
<header class="site-header"><a class="brand" href={base} aria-label="Falkenried Startseite"><Logo/></a><nav class="desktop-nav" aria-label="Hauptnavigation"><details><summary>HÄUSER <Icon name="chevron-down"/></summary><div class="submenu"><a href={`${base}katalog/`}>Alle Hausideen</a><a href={`${base}katalog/?material=Holz`}>Holzhäuser</a><a href={`${base}katalog/?material=Massiv`}>Massivhäuser</a><a href={`${base}katalog/?floors=1`}>Bungalows</a></div></details><a href={`${base}#einblicke`}>EINBLICKE</a><details><summary>LEISTUNGEN <Icon name="chevron-down"/></summary><div class="submenu"><a href={`${base}#leistungen`}>Planung & Bau</a><a href={`${base}#ablauf`}>Unser Ablauf</a><a href={`${base}#beratung`}>Persönliche Beratung</a></div></details><a href={`${base}#ueber-uns`}>ÜBER UNS</a><a href={`${base}#beratung`}>KONTAKT</a></nav><button class="button header-cta" data-consult type="button">RÜCKRUF ANFRAGEN</button><button class="icon-button" type="button" data-open-compare aria-label="Hausvergleich öffnen"><Icon name="scale"/><span data-compare-count hidden>0</span></button><a class="icon-button search-link" href={`${base}katalog/#search`} aria-label="Haus suchen"><Icon name="search"/></a><button class="icon-button menu-trigger" data-open-menu type="button" aria-label="Menü öffnen" aria-controls="navigation-dialog" aria-expanded="false"><Icon name="menu"/></button></header>
<dialog class="drawer" id="navigation-dialog" aria-labelledby="menu-title"><div class="dialog-toolbar"><h2 id="menu-title">Falkenried entdecken.</h2><button class="icon-button" data-close aria-label="Menü schließen"><Icon name="x"/></button></div><nav aria-label="Mobile Navigation"><a href={`${base}katalog/`}>Unsere Häuser <Icon name="arrow-right"/></a><a href={`${base}#einblicke`}>Einblicke</a><a href={`${base}#leistungen`}>Leistungen</a><a href={`${base}#ablauf`}>So bauen wir</a><a href={`${base}#ueber-uns`}>Über uns</a><a href={`${base}#beratung`}>Kontakt</a></nav><p class="muted">Dein Zuhause beginnt mit einer guten Idee.</p></dialog>
