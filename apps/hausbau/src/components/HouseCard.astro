---
import Icon from '../../../../packages/ui/Icon.astro';
import type { House } from '../data/catalogue';
interface Props {house:House}
const {house:h}=Astro.props;
const base=import.meta.env.BASE_URL;
---
<article class="house-card" data-house-card={h.id}>
 <div class="card-photo"><a href={`${base}haeuser/${h.id}/`} aria-label={`${h.name} ansehen`}><img src={`${base}images/${h.image}.webp`} alt={`Hausidee ${h.name}: ${h.style}, ${h.material}`} width="1672" height="941" loading="lazy"/></a><button class="round compare-button" data-compare={h.id} type="button" aria-label={`${h.name} vergleichen`} aria-pressed="false"><Icon name="scale"/></button><button class="round favorite-button" data-favorite={h.id} type="button" aria-label={`${h.name} merken`} aria-pressed="false"><Icon name="heart"/></button><span class="photo-caption">{h.material} · {h.style}</span></div>
 <div class="card-copy"><a class="house-name" href={`${base}haeuser/${h.id}/`}>{h.name}</a><p>{h.description}</p><div class="house-facts"><span data-tooltip="Wohnfläche"><Icon name="ruler"/>{h.area} m²</span><span data-tooltip="Geschosse"><Icon name="layers"/>{h.floors}</span><span data-tooltip="Schlafzimmer"><Icon name="bed-double"/>{h.bedrooms}</span><span data-tooltip="Badezimmer"><Icon name="bath"/>{h.bathrooms}</span></div><a class="card-link" href={`${base}haeuser/${h.id}/`}>Haus entdecken</a></div>
</article>