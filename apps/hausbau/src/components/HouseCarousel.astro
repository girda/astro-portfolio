---
import '../../../../packages/ui/edge-carousel.css';
import HouseCard from './HouseCard.astro';
import Icon from '../../../../packages/ui/Icon.astro';
import houses from '../data/houses.json';
interface Props { label: string }
const {label}=Astro.props;
---
<div class="house-carousel" data-carousel role="region" aria-label={label}>
  <div class="carousel-toolbar"><p>Sechs Hausideen. Finde deinen Ausgangspunkt.</p><div class="carousel-controls"><button type="button" class="icon-button" data-carousel-prev aria-label="Vorherige Häuser"><Icon name="arrow-left"/></button><button type="button" class="icon-button" data-carousel-next aria-label="Weitere Häuser"><Icon name="arrow-right"/></button></div></div>
  <div class="carousel-track" data-edge-carousel data-carousel-track tabindex="0" aria-label="Hausideen zum Durchblättern">
    {houses.map(house => <HouseCard house={house}/>)}
  </div>
</div>
