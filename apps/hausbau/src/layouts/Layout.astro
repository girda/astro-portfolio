---
import '../styles/global.css';
import '../styles/refinement.css';
import TooltipLayer from '../../../../packages/ui/TooltipLayer.astro';
import Header from '../components/Header.astro';
import Logo from '../components/Logo.astro';
import Icon from '../../../../packages/ui/Icon.astro';
import houses from '../data/houses.json';
interface Props {title:string;description?:string;home?:boolean}
const {title,description='Falkenried — individuelle Hausideen aus Holz und Stein. Häuser entdecken, vergleichen und ein erstes Beratungsgespräch vorbereiten.',home=false}=Astro.props;
const base=import.meta.env.BASE_URL;
const origin=Astro.site||new URL('https://girda.github.io');
const canonical=new URL(Astro.url.pathname,origin);
---
<!doctype html><html lang="de"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#365b59"/><title>{title} · Falkenried</title><link rel="icon" href={`${base}brand.svg`} type="image/svg+xml"/><link rel="canonical" href={canonical}/><meta property="og:title" content={`${title} · Falkenried`}/><meta property="og:description" content={description}/><meta property="og:image" content={new URL(`${base}images/auenblick.webp`,origin)}/><meta name="robots" content="noindex,follow"/>{import.meta.env.DEV && <script is:inline>if(location.hash.includes('figmacapture=')){const style=document.createElement('style');style.textContent='[data-reveal]{opacity:1!important;transform:none!important}body,button,input,select,textarea{font-family:Arimo,Arial,sans-serif!important}';document.head.append(style);const script=document.createElement('script');script.src='https://mcp.figma.com/mcp/html-to-design/capture.js';script.async=true;document.head.append(script);}</script>}</head><body class:list={[{home}]}><a class="skip-link" href="#main">Zum Inhalt</a><Header/><main id="main"><slot/></main><footer class="site-footer"><div class="container footer-top"><a href={base} class="brand"><Logo/></a><nav aria-label="Footernavigation"><a href={`${base}katalog/`}>Hauskatalog</a><a href={`${base}#leistungen`}>Leistungen</a><a href={`${base}#ablauf`}>Bauablauf</a><a href={`${base}#beratung`}>Beratung</a></nav><a class="button light" href={`${base}#beratung`}>Über dein Haus sprechen</a></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} Falkenried</span><span>Fiktives Bauunternehmen · Hausideen und Flächen sind Beispieldaten. Keine Verkaufsangebote.</span><a href="#main">Nach oben ↑</a></div></footer><dialog id="plan-dialog" class="modal plan-dialog" aria-labelledby="plan-dialog-title"><div class="dialog-toolbar"><div><p class="eyebrow">RÄUME ERLEBEN</p><h2 id="plan-dialog-title">Eine Wohnidee im Detail.</h2></div><button type="button" class="icon-button" data-close aria-label="3D-Ansicht schließen"><Icon name="x"/></button></div><img src={`${base}images/raumidee-3d.webp`} width="1536" height="1024" alt="Möblierte 3D-Raumidee mit offener Wohnküche, Arbeitszimmer und Diele" loading="lazy"/><p class="small muted">Beispielhafte Wohnidee zur Inspiration. Kein modellspezifischer Grundriss.</p></dialog><dialog id="consult-dialog" class="modal" aria-labelledby="consult-title"><div class="dialog-toolbar"><p class="eyebrow">DEIN NÄCHSTER SCHRITT</p><button class="icon-button" data-close aria-label="Fenster schließen"><Icon name="x"/></button></div><h2 id="consult-title">Lass uns dein Zuhause kennenlernen.</h2><p>Bereite deine Wünsche für ein erstes Gespräch vor.</p><form class="consult-form"><label>Dein Name<input name="name" autocomplete="name" required maxlength="100"/></label><label>E-Mail oder Telefonnummer<input name="contact" autocomplete="email" required maxlength="150"/></label><label>Deine Wünsche<textarea name="message" rows="3" maxlength="1500"/></label><button type="submit" class="button">Anfrage vorbereiten</button><p class="small muted">Diese Demo versendet nichts. Du prüfst anschließend deine Angaben.</p></form></dialog><dialog class="modal comparison" id="compare-dialog" aria-labelledby="compare-title"><div class="dialog-toolbar"><h2 id="compare-title">Deine Häuser im Vergleich.</h2><button class="icon-button" data-close aria-label="Vergleich schließen"><Icon name="x"/></button></div><div data-comparison-output></div></dialog><p class="toast" role="status" data-toast hidden></p><script type="application/json" id="house-data" set:html={JSON.stringify(houses)}/><script>import { initSite } from '../scripts/site';initSite();</script><TooltipLayer/></body></html>
