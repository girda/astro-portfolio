---
import {bakeryBrand} from '../data/brand';
import DemoNotice from "../../../../packages/ui/DemoNotice.astro";
const {title,description}=Astro.props;
const base=import.meta.env.BASE_URL;
const links=[['Menü','menue/'],['Unsere Geschichte','geschichte/'],['Kontakt','kontakt/']];
---
<!doctype html><html lang="de"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} — {bakeryBrand.name}</title><meta name="description" content={description}/><meta name="robots" content="noindex,follow"/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site||'https://girda.github.io')}/><link rel="icon" href={`${base}assets/favicon.svg`}/><link rel="stylesheet" href={`${base}fonts/fonts.css`}/><link rel="stylesheet" href={`${base}styles.css`}/><link rel="stylesheet" href={`${base}pages.css`}/></head><body><header class="inner-header"><a class="inner-logo" href={base}>{bakeryBrand.wordmark}<span>.</span></a><nav aria-label="Hauptnavigation">{links.map(([label,path])=><a href={base+path} aria-current={Astro.url.pathname.endsWith(path)?'page':undefined}>{label}</a>)}</nav></header><main class="inner-main"><slot/></main><footer class="inner-footer"><a class="inner-logo" href={base}>{bakeryBrand.wordmark}.</a><p>{bakeryBrand.tagline}</p><nav>{links.map(([label,path])=><a href={base+path}>{label}</a>)}</nav><small>Unabhängiges Designkonzept. Kein offizieller Markenauftritt. Keine echten Bestellungen.</small></footer><script is:inline src={`${base}app.js`} defer></script><DemoNotice/></body></html>
