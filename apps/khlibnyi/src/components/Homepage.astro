---
import '../../../../packages/ui/edge-carousel.css';
import {bakeryBrand} from '../data/brand';
const base=import.meta.env.BASE_URL;
const asset=(name:string)=>`${base}assets/${name}`;
---
<!-- Independent fictional café concept. -->
<svg xmlns="http://www.w3.org/2000/svg" class="svg-library" aria-hidden="true">
  <symbol id="icon-wheat" viewBox="0 0 64 100" fill="none">
    <path d="M31.5 94V16" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
    <path d="M31 81C17 79 11 73 10 64c13 0 20 5 21 17ZM33 69c14-2 20-9 21-18-13 0-20 7-21 18ZM31 57C17 54 11 48 10 39c13 0 20 6 21 18ZM33 45c14-3 20-10 21-19-13 0-20 7-21 19ZM31 33C21 28 17 20 18 12c11 3 15 10 13 21ZM32 19c-6-7-6-14-2-18 7 6 8 12 2 18Z" fill="currentColor"/>
  </symbol>
  <symbol id="icon-star" viewBox="0 0 100 100" fill="none">
    <path d="m50 3 9 31 28-18-18 28 28 9-31 9 18 28-28-18-9 25-9-31-28 18 18-28-25-9 31-9-18-28 28 18L50 3Z" stroke="currentColor" stroke-width="2"/>
  </symbol>
  <symbol id="icon-arrow" viewBox="0 0 24 24" fill="none">
    <path d="M3 12h17m-8-8 8 8-8 8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
  </symbol>
  <symbol id="icon-arrow-diag" viewBox="0 0 24 24" fill="none">
    <path d="M5 19 19 5M7 5h12v12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
  </symbol>
</svg>

<div class="page-intro" id="pageIntro" aria-hidden="true">
  <div class="intro-inside"><span class="intro-overline">BROT / KAFFEE / GUTE ZEIT</span><span class="intro-word">{bakeryBrand.wordmark}<span class="intro-dot">.</span></span><div class="intro-progress"><span></span></div><span class="intro-caption">JEDEN TAG. RICHTIG GUT.</span></div>
</div>

<header class="site-header" id="header">
  <a class="brand" href="#top" aria-label={`${bakeryBrand.name} — Startseite`}>
    <img class="brand-wheat" src={asset("kornfabel-mark.svg")} width="36" height="36" alt="" />
    <span>{bakeryBrand.wordmark}<span class="brand-dot">.</span></span>
  </a>
  <nav class="desktop-nav" aria-label="Hauptnavigation">
    <a href={`${base}geschichte/`} data-nav>ÜBER UNS</a><a href={`${base}menue/`} data-nav>MENÜ</a><a href={`${base}kontakt/`} data-nav>KONTAKT</a>
  </nav>
  <a class="header-cta" href={`${base}kontakt/`}><span>BESUCH PLANEN</span></a>
  <button class="menu-toggle" type="button" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mobileNav"><span></span><span></span></button>
</header>
<nav class="mobile-nav" id="mobileNav" aria-label="Mobile Navigation" aria-hidden="true" inert>
  <div class="mobile-nav-top">{bakeryBrand.wordmark} <span>NAVIGATION / 01—03</span></div>
  <a href={`${base}geschichte/`} data-mobile-link><span>01</span>ÜBER UNS</a>
  <a href={`${base}menue/`} data-mobile-link><span>02</span>MENÜ</a>
  <a href={`${base}kontakt/`} data-mobile-link><span>03</span>KONTAKT</a>
  <p>BROT FÜR EINEN GUTEN MORGEN. &nbsp; KAFFEE FÜR DEN REST.</p>
</nav>

<main id="top">
  <section class="hero" aria-label="Willkommen">
    <div class="hero-side-note">MIT LIEBE GEMACHT &nbsp; / &nbsp; MOMENT FÜR MOMENT</div>
    <div class="hero-heading-wrap">
      <div class="hero-kicker reveal-text"><span class="small-ball"></span> DEIN CAFÉ. DEINE KLEINE AUSZEIT. <span class="hero-kicker-index">[ 01 / 04 ]</span></div>
      <h1 class="hero-title" aria-label={bakeryBrand.name}><span class="hero-title-line">KOR<span class="title-notched">N</span>FABEL<span class="hero-title-dot">.</span></span></h1>
      <div class="hero-title-bottom"><span>FRISCH. EHRLICH. MIT LIEBE.</span><span class="scroll-cue">MEHR ENTDECKEN <span class="down-arrow">↓</span></span></div>
    </div>
    <div class="hero-stage" id="heroStage">
      <div class="hero-stage-image-wrap parallax-scene">
        <img class="hero-stage-image" src={asset("croissant-own.webp")} data-fallback={asset("croissant.svg")} alt="Goldbraune Croissants und frisches Gebäck" fetchpriority="high" />
        <div class="hero-image-shade"></div>
        <div class="hero-image-label">FRISCH AUS DEM OFEN <span>→</span> JEDEN TAG</div>
      </div>
      <div class="hero-vertical-stamp"><span>GUTES GEBÄCK IST LIEBE</span><svg><use href="#icon-wheat"></use></svg></div>
      <div class="hero-floating-card">
        <div class="hero-floating-top"><svg><use href="#icon-wheat"></use></svg><span>ALLES FÜR<br/>DEINEN GUTEN TAG</span></div>
        <div class="hero-floating-main">ECHT<br/>LECKER<span>.</span></div>
        <div class="hero-floating-bottom"><span>IMMER MIT LIEBE</span><span>♥ 100%</span></div>
      </div>
      <div class="orbit-stamp" aria-label="Frisch gebacken"><svg class="orbit-text" viewBox="0 0 180 180" aria-hidden="true"><defs><path id="orbitCurve" d="M90,90 m-66,0 a66,66 0 1,1 132,0 a66,66 0 1,1 -132,0" /></defs><text><textPath href="#orbitCurve">FRISCHES BROT • GUTER KAFFEE • LIEBE • </textPath></text></svg><svg class="orbit-center"><use href="#icon-star"></use></svg></div>
    </div>
    <div class="hero-bottom-row"><span>01 — GENIESSE DEN MOMENT</span><span>DEIN LIEBLINGSPLATZ FÜR EINE PAUSE</span><span>BROT / KAFFEE / BEGEGNUNG</span></div>
  </section>

  <div class="marquee-strip" aria-label="Frisches Brot, guter Kaffee, ein schöner Tag"><div class="marquee-track" aria-hidden="true">
    <span>BROT. KAFFEE. LIEBE.</span><svg><use href="#icon-star"></use></svg><span>JEDEN TAG. RICHTIG GUT.</span><svg><use href="#icon-star"></use></svg><span>BROT. KAFFEE. LIEBE.</span><svg><use href="#icon-star"></use></svg><span>JEDEN TAG. RICHTIG GUT.</span><svg><use href="#icon-star"></use></svg>
  </div></div>

  <section class="intro-story section-container" id="story">
    <div class="section-eyebrow reveal"><span>01 / UNSERE PHILOSOPHIE</span><span>MEHR ALS EINE BÄCKEREI</span></div>
    <div class="story-layout">
      <div class="story-heading reveal"><p class="vertical-mini">DIE KLEINEN DINGE ZÄHLEN</p><h2>ALLES<br/>FÜR <em>BROT</em><span>.</span></h2><div class="story-star"><svg><use href="#icon-star"></use></svg></div></div>
      <div class="story-copy reveal"><span class="story-copy-index">(01—03)</span><p class="large-copy">Manche Dinge brauchen nicht viele Worte. <strong>Warmes Brot.</strong> Frischer Kaffee. Ein Morgen, der sich richtig anfühlt.</p><p class="small-copy">Wir mögen die einfachen Dinge — und die Sorgfalt, die sie besonders macht. Eine knusprige Kruste, ein guter Kaffee und ein Platz für echte Gespräche.</p><a href={`${base}menue/`} class="text-link"><span>MENÜ ENTDECKEN</span></a></div>
    </div>
    <div class="story-gallery">
      <figure class="story-image story-image-a reveal-image"><div class="image-cover"><img src={asset("bakery-counter-2026.webp")} data-fallback={asset("interior.svg")} loading="lazy" alt="Gebäckvitrine einer Café-Bäckerei" /></div><figcaption>01 / HIER DUFTET DAS GLÜCK</figcaption></figure>
      <figure class="story-image story-image-b reveal-image"><div class="image-cover"><img src={asset("bakery-room-2026.webp")} data-fallback={asset("interior.svg")} loading="lazy" alt="Innenraum einer Café-Bäckerei" /></div><figcaption>02 / RAUM FÜR GUTE MOMENTE</figcaption></figure>
      <div class="story-gallery-aside reveal">DEIN MORGEN.<br/>EIN BISSCHEN BESSER. <span>↗</span></div>
    </div>
  </section>

  <section class="menu-section" id="menu">
    <div class="menu-top section-container"><div class="section-eyebrow reveal"><span>02 / GUTES AUF DEM TELLER</span><span>FINDE DEINEN LIEBLING</span></div><div class="menu-heading-row reveal"><div><span class="section-kicker">KLEINE FREUDE. JEDEN TAG.</span><h2>UNSER<br/><em>MENÜ</em><span class="heading-point">.</span></h2></div><p>CROISSANTS, DIE KNUSPERN.<br/>KAFFEE, DER GUTTUT.<br/>UND NOCH EIN BISSCHEN MEHR.</p></div>
      <div class="menu-controls" data-edge-carousel data-edge-filter role="group" aria-label="Menükategorien"><button type="button" class="filter-button active" data-filter="all" aria-pressed="true">ALLES <span>04</span></button><button type="button" class="filter-button" data-filter="bakery" aria-pressed="false">GEBÄCK <span>02</span></button><button type="button" class="filter-button" data-filter="coffee" aria-pressed="false">KAFFEE <span>01</span></button><button type="button" class="filter-button" data-filter="dessert" aria-pressed="false">SÜSSES <span>01</span></button></div>
    </div>
    <div class="product-grid section-container" id="productGrid">
      <article class="product-card reveal" data-category="bakery"><div class="product-photo photo-cream"><span class="product-number">01 / 04</span><img src={asset("croissant-own.webp")} data-fallback={asset("croissant.svg")} loading="eager" alt="Croissant"/><span class="product-hover-symbol">↗</span></div><div class="product-bottom"><div><span class="product-type">FRISCHES GEBÄCK</span><h3>CROISSANTS</h3></div><span class="product-arrow">↗</span></div></article>
      <article class="product-card reveal" data-category="bakery"><div class="product-photo photo-gold"><span class="product-number">02 / 04</span><img src={asset("bakery-bread-2026.webp")} data-fallback={asset("bread.svg")} loading="eager" alt="Frisches Brot"/><span class="product-hover-symbol">↗</span></div><div class="product-bottom"><div><span class="product-type">AUS DEM OFEN</span><h3>BROT</h3></div><span class="product-arrow">↗</span></div></article>
      <article class="product-card reveal" data-category="coffee"><div class="product-photo photo-brown"><span class="product-number">03 / 04</span><img src={asset("coffee-own.webp")} data-fallback={asset("coffee.svg")} loading="eager" alt="Milchkaffee"/><span class="product-hover-symbol">↗</span></div><div class="product-bottom"><div><span class="product-type">FÜR DEINEN MOMENT</span><h3>KAFFEE</h3></div><span class="product-arrow">↗</span></div></article>
      <article class="product-card reveal" data-category="dessert"><div class="product-photo photo-rose"><span class="product-number">04 / 04</span><img src={asset("bakery-dessert-2026.webp")} data-fallback={asset("dessert.svg")} loading="eager" alt="Dessert"/><span class="product-hover-symbol">↗</span></div><div class="product-bottom"><div><span class="product-type">EIN STÜCK FREUDE</span><h3>SÜSSES</h3></div><span class="product-arrow">↗</span></div></article>
    </div>
    <div class="menu-bottom section-container"><span>GUTE ZUTATEN. KLEINE FREUDEN. GROSSE LIEBE.</span><a class="pill-link" href={`${base}kontakt/`}>KONTAKT & BESUCH </a></div>
  </section>

  <section class="manifesto" aria-label="Unsere Haltung"><div class="manifesto-pattern" aria-hidden="true"><svg><use href="#icon-wheat"></use></svg><svg><use href="#icon-wheat"></use></svg><svg><use href="#icon-wheat"></use></svg><svg><use href="#icon-wheat"></use></svg><svg><use href="#icon-wheat"></use></svg><svg><use href="#icon-wheat"></use></svg><svg><use href="#icon-wheat"></use></svg><svg><use href="#icon-wheat"></use></svg></div><div class="manifesto-inner reveal"><span>( WAS UNS WICHTIG IST )</span><h2>MACH<br/>JEDEN TAG<br/><em>EIN BISSCHEN GUT</em><span>.</span></h2><svg class="manifesto-flower"><use href="#icon-star"></use></svg><p>MANCHMAL REICHT EIN KLEINES STÜCK GLÜCK.</p></div></section>

  <section class="locations-section section-container" id="locations"><div class="section-eyebrow reveal"><span>03 / DEIN TREFFPUNKT</span><span>ZEIT FÜR EIN WIEDERSEHEN?</span></div><div class="locations-grid"><div class="locations-copy reveal"><span class="section-kicker">EIN PLATZ FÜR DICH</span><h2>BIS BALD.<br/><em>BEI UNS.</em><span>.</span></h2><p>Kaffee schmeckt besser in guter Gesellschaft. Ein Croissant für unterwegs, eine kleine Pause oder Zeit für ein langes Gespräch: Hier beginnt dein guter Moment.</p><a class="location-external" href={`${base}kontakt/`} target="_blank" rel="noopener noreferrer"><span>BESUCH & KONTAKT</span></a><span class="locations-caption">DEIN NÄCHSTER GUTER MOMENT</span></div><div class="locations-photo reveal-image"><div class="image-cover"><img src={asset("bakery-entrance-2026.webp")} data-fallback={asset("interior.svg")} alt="Einladender Café-Innenraum" loading="lazy"/></div><div class="photo-caption-sticker"><svg><use href="#icon-star"></use></svg><span>KOMM AUF<br/>EINEN KAFFEE</span></div></div></div></section>

  <footer class="footer"><div class="footer-top section-container"><div class="footer-left"><span>{bakeryBrand.wordmark} — MEHR ALS GUTES GEBÄCK.</span><span>MIT LIEBE ZUM GUTEN MORGEN.</span></div><a class="back-top" href="#top">NACH OBEN</a></div><div class="footer-logo" aria-hidden="true">{bakeryBrand.wordmark}<span>.</span></div><div class="footer-bottom section-container"><span>© KONZEPT / 2026</span><span>UNABHÄNGIGES DESIGNKONZEPT · KEIN OFFIZIELLER MARKENAUFTRITT</span><span>CAFÉ-KONZEPT</span></div></footer>
</main>
<div class="demo-tag">UNOFFICIAL CONCEPT / 2026</div>
