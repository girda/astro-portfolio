---
import DemoNotice from "../../../../packages/ui/DemoNotice.astro";
import Homepage from '../components/Homepage.astro';
const base=import.meta.env.BASE_URL;
const origin=Astro.site||new URL('https://girda.github.io');
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#e9e4d8" />
    <meta name="description" content="Kornfabel — Café und Bäckerei als unabhängiges Designkonzept. Frisches Brot, Kaffee und kleine Genussmomente." />
    <meta name="robots" content="noindex,follow"/><link rel="canonical" href={new URL(base,origin)}/><meta property="og:image" content={new URL(`${base}assets/croissant.svg`,origin)}/><title>Kornfabel — Brot. Kaffee. Liebe.</title>
    <link rel="icon" href={`${base}assets/favicon.svg`} type="image/svg+xml" />
    <link rel="stylesheet" href={`${base}fonts/fonts.css`}/><link rel="stylesheet" href={`${base}styles.css`} /><link rel="stylesheet" href={`${base}pages.css`}/>
  </head>
  <body>
    <Homepage />
    <script is:inline src={`${base}app.js`} defer></script>
  <DemoNotice/></body>
</html>
