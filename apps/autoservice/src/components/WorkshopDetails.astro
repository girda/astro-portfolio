---
import Icon from '../../../../packages/ui/Icon.astro';
import type {Language} from '../i18n/translations';
interface Props {lang:Language;services:{name:string}[]}
const {lang,services}=Astro.props;
const ru=lang==='ru';
const content=ru?{
 eyebrow:'ПОНЯТНО ДО РЕМОНТА',title:'Сначала разобраться. Потом менять.',text:'Неисправность не всегда означает замену детали. История автомобиля, проверка и согласование помогают определить следующий шаг.',
 diagnosis:'Диагностика — больше, чем код ошибки.',diagnosisText:'Сначала — когда появилась проблема и при каких условиях она повторяется. Затем чтение памяти неисправностей и целевые проверки. Решение о ремонте принимается после оценки результатов.',
 checks:['Обсуждение симптомов и истории обслуживания','Проверки по результатам первичного осмотра','Понятное объяснение результата и следующего шага'],
 brakes:'Тормоза: понятный объём работ.',brakesText:'Состояние дисков, колодок и сопутствующих компонентов оценивают вместе. Объём работ и подходящие детали согласуют до ремонта. Финальная стоимость зависит от автомобиля и результатов проверки.',
 checklist:'Что относится к услуге?',included:[['Обслуживание по модели и плану производителя','Проверка основных систем и жидкостей','Отдельное согласование дополнительных работ'],['Подбор масла по допуску автомобиля','Масляный фильтр и объём по двигателю','Утилизация и сервисная запись по договорённости'],['Осмотр дисков, колодок и компонентов','Согласование необходимых деталей','Проверка после выполненных работ'],['Сезонная замена колёс в сборе','Проверка состояния и давления','Балансировка и хранение — отдельно'],['Обсуждение проявлений неисправности','Чтение ошибок и дальнейшие проверки','Отдельное согласование ремонта']],
 planner:'Подготовим обращение?',plannerText:'Выбери задачу — покажем, какие детали полезно сообщить. Это подготовка запроса, а не диагноз.',options:['Плановое обслуживание','Ошибка или необычный звук','Колёса к сезону'],hints:['Укажи модель, год, пробег и дату последнего обслуживания. Полезно взять сервисную историю.','Опиши, когда проявляется проблема: на холодном двигателе, при разгоне или торможении. Не проверяй автомобиль самостоятельно в опасных условиях.','Укажи размер колёс, нужны ли замена в сборе, балансировка или хранение. Доступность уточняется после запроса.'],next:'Перенести в запрос',choose:'Выбери задачу',safety:'При ухудшении торможения, дыме или красном предупреждении остановись в безопасном месте и обратись за профессиональной помощью. Онлайн-форма не заменяет экстренную помощь.'
}:{
 eyebrow:'KLARHEIT VOR DER REPARATUR',title:'Erst verstehen. Dann ersetzen.',text:'Ein auffälliges Geräusch bedeutet nicht automatisch ein neues Bauteil. Fahrzeuggeschichte, Prüfung und Rücksprache geben dem nächsten Schritt eine Richtung.',
 diagnosis:'Diagnose ist mehr als ein Fehlercode.',diagnosisText:'Wann tritt das Problem auf? Was wurde zuletzt gemacht? Auf das Gespräch folgen das Auslesen des Fehlerspeichers und gezielte Prüfungen. Erst die Ergebnisse bilden die Grundlage für eine Reparaturempfehlung.',
 checks:['Symptome und Servicehistorie besprechen','Prüfschritte passend zum ersten Befund','Ergebnis und nächste Schritte verständlich erklären'],
 brakes:'Bremsen. Mit klarem Arbeitsumfang.',brakesText:'Scheiben, Beläge und weitere Bauteile werden im Zusammenhang betrachtet. Welche Arbeiten und Teile sinnvoll sind, wird vor der Reparatur abgestimmt. Der konkrete Aufwand hängt vom Fahrzeug und Prüfergebnis ab.',
 checklist:'Was gehört zur Leistung?',included:[['Wartungsumfang nach Fahrzeug und Herstellerplan','Sichtprüfung wichtiger Systeme und Flüssigkeiten','Zusatzarbeiten separat abstimmen'],['Öl nach der Freigabe deines Fahrzeugs','Ölfilter und Füllmenge passend zum Motor','Entsorgung und Serviceeintrag nach Absprache'],['Zustand von Scheiben, Belägen und Komponenten','Benötigte Teile vorab abstimmen','Kontrolle nach den vereinbarten Arbeiten'],['Saisonwechsel kompletter Räder','Zustand und Luftdruck prüfen','Wuchten und Einlagerung separat anfragen'],['Auftreten der Auffälligkeit besprechen','Fehlerspeicher und gezielte Anschlussprüfung','Reparatur erst nach gesonderter Abstimmung']],
 planner:'Deine Anfrage. Gut vorbereitet.',plannerText:'Wähle dein Anliegen. Du siehst sofort, welche Angaben helfen — als Vorbereitung, nicht als Ferndiagnose.',options:['Wartung steht an','Warnleuchte oder Geräusch','Räder für die Saison'],hints:['Modell, Baujahr, Kilometerstand und letzte Wartung helfen bei der Planung. Halte deine Servicehistorie bereit.','Beschreibe, wann die Auffälligkeit auftritt: beim Kaltstart, Beschleunigen oder Bremsen. Keine riskanten Selbsttests durchführen.','Nenne die Radgröße und ob du einen Komplettradwechsel, Wuchten oder Einlagerung brauchst. Verfügbarkeit wird erst nach einer Anfrage geklärt.'],next:'In die Anfrage übernehmen',choose:'Anliegen auswählen',safety:'Bei nachlassender Bremswirkung, Rauch oder roter Warnmeldung sicher anhalten und professionelle Hilfe holen. Das Online-Formular ersetzt keine Pannen- oder Notfallhilfe.'
};
const image=(file:string)=>`${import.meta.env.BASE_URL}images/${file}`;
---
<section class="wrap section workshop-detail"><div class="detail-intro"><p class="eyebrow">{content.eyebrow}</p><h2>{content.title}</h2><p>{content.text}</p></div><div class="detail-story" data-motion><img src={image('workshop-diagnostics.webp')} alt={ru?'Механик изучает данные на планшете рядом с автомобилем':'Mechaniker mit Diagnose-Tablet neben einem Fahrzeug'} width="1680" height="945" loading="lazy"/><div><span class="story-number">01 / DIAGNOSE</span><h3>{content.diagnosis}</h3><p>{content.diagnosisText}</p><ul>{content.checks.map(item=><li><Icon name="check-check"/>{item}</li>)}</ul></div></div><div class="detail-story reverse" data-motion><img src={image('workshop-brakes.webp')} alt={ru?'Осмотр тормозного механизма автомобиля на подъёмнике':'Mechaniker prüft die Bremsanlage am angehobenen Fahrzeug'} width="1680" height="945" loading="lazy"/><div><span class="story-number">02 / BREMSEN</span><h3>{content.brakes}</h3><p>{content.brakesText}</p><a class="button secondary" href="#termin" data-service={services[2].name}>{ru?'Обсудить проверку':'Prüfung besprechen'}<Icon name="arrow-right"/></a></div></div><div class="service-scope"><h3>{content.checklist}</h3><div>{services.map((service,i)=><details><summary>{service.name}<Icon name="chevron-down"/></summary><ul>{content.included[i].map(item=><li>{item}</li>)}</ul></details>)}</div></div></section>
<section class="request-planner wrap section" aria-labelledby="planner-title"><div><p class="eyebrow">WERKRAUM / SERVICE-PLANER</p><h2 id="planner-title">{content.planner}</h2><p>{content.plannerText}</p></div><div class="planner-card"><div class="planner-options" role="group" aria-label={content.choose}>{content.options.map((label,i)=><button type="button" data-plan={i} aria-pressed="false">{label}<Icon name="arrow-up-right"/></button>)}</div><div class="planner-result" aria-live="polite"><p data-plan-hint>{content.choose}</p><a class="button" href="#termin" data-plan-apply hidden>{content.next}<Icon name="arrow-right"/></a></div><p class="planner-safety">{content.safety}</p></div><script type="application/json" data-planner-content set:html={JSON.stringify({hints:content.hints,names:[services[0].name,services[4].name,services[3].name]})}/></section>
<script>
 const planner=document.querySelector<HTMLElement>('.request-planner');
 if(planner){
 const data=JSON.parse(planner.querySelector('[data-planner-content]')!.textContent!);let selected=-1;
 const apply=planner.querySelector<HTMLAnchorElement>('[data-plan-apply]')!;
 for(const button of planner.querySelectorAll<HTMLButtonElement>('[data-plan]'))button.addEventListener('click',()=>{selected=Number(button.dataset.plan);for(const item of planner.querySelectorAll('[data-plan]'))item.setAttribute('aria-pressed',String(item===button));planner.querySelector('[data-plan-hint]')!.textContent=data.hints[selected];apply.hidden=false;});
 apply.addEventListener('click',()=>{if(selected<0)return;const form=document.querySelector<HTMLFormElement>('#appointment')!;const select=form.elements.namedItem('service') as HTMLSelectElement;select.value=data.names[selected];select.dispatchEvent(new Event('change',{bubbles:true}));requestAnimationFrame(()=>{(form.elements.namedItem('vehicle') as HTMLInputElement).focus({preventScroll:true});});});
 }
</script>
<style>
 .workshop-detail,.request-planner{color:var(--ink,#f0f5f8)}.detail-intro{max-width:730px;margin-bottom:54px}.detail-intro h2,.request-planner h2{font-size:clamp(34px,4vw,54px);line-height:1.1;letter-spacing:-.04em}.detail-intro>p:last-child,.detail-story p,.request-planner>div>p:last-child{font-size:15px;line-height:1.85;color:#b7c4cc}.detail-story{display:grid;grid-template-columns:1.15fr 1fr;gap:64px;align-items:center;margin-block:44px 80px}.detail-story img{width:100%;height:auto;display:block;border-radius:5px}.detail-story h3,.service-scope h3{font-size:clamp(28px,3vw,38px);font-weight:400;letter-spacing:-.035em;line-height:1.2}.story-number{font-size:10px;letter-spacing:.14em;color:#a9d9ed}.detail-story ul{list-style:none;padding:0;display:grid;gap:17px;margin:28px 0 0}.detail-story li{display:flex;align-items:start;gap:12px;font-size:13px;line-height:1.6}.detail-story li svg{width:20px;height:20px;flex-shrink:0;color:#a9d9ed}.detail-story.reverse img{order:2}.service-scope{display:grid;grid-template-columns:.8fr 1.2fr;gap:60px;border-top:1px solid #ffffff28;padding-top:40px}.service-scope h3{margin:0}.service-scope details{border-bottom:1px solid #ffffff28}.service-scope summary{cursor:pointer;padding:20px 0;display:flex;justify-content:space-between;gap:15px;font-size:17px;list-style:none}.service-scope summary::-webkit-details-marker{display:none}.service-scope summary svg{width:20px;transition:rotate .2s}.service-scope details[open] summary svg{rotate:180deg}.service-scope ul{color:#b7c4cc;font-size:14px;line-height:1.9;padding-left:20px;margin:0 0 22px}.request-planner{display:grid;grid-template-columns:.85fr 1.15fr;gap:60px;border-top:1px solid #ffffff28}.planner-card{background:#19232b;padding:30px;border:1px solid #ffffff25;border-radius:5px}.planner-options{display:flex;flex-wrap:wrap;gap:10px}.planner-options button{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:48px;border:1px solid #ffffff30;background:transparent;color:#f0f5f8;padding:12px 16px;cursor:pointer;font:inherit;font-size:12px}.planner-options button[aria-pressed=true]{background:#a9d9ed;color:#152128;border-color:#a9d9ed}.planner-options svg{width:18px;height:18px}.planner-result{margin-top:25px;min-height:170px}.planner-result p{font-size:15px;line-height:1.8;color:#d1dce3}.planner-result a[hidden]{display:none}.planner-safety{font-size:11px;line-height:1.7;color:#a6b4bd;border-top:1px solid #ffffff25;padding-top:20px}.planner-options button:focus-visible,.service-scope summary:focus-visible{outline:2px solid #a9d9ed;outline-offset:4px}@media(max-width:900px){.detail-story{gap:30px;grid-template-columns:1fr}.detail-story.reverse img{order:0}.service-scope,.request-planner{grid-template-columns:1fr;gap:25px}.planner-card{padding:22px}.detail-intro{margin-bottom:28px}.detail-story{margin-bottom:50px}}@media(prefers-reduced-motion:reduce){.service-scope summary svg{transition:none}}
</style>
