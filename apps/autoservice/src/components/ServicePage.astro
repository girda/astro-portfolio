---
import SectionMotion from "./SectionMotion.astro";
import { site as siteDe, siteRu } from '../data/site';
import { translate, type Language } from '../i18n/translations';
interface Props { lang: Language }
const { lang } = Astro.props;
const site = lang === 'ru' ? siteRu : siteDe;
const t = (value: string) => translate(lang, value);
const home = import.meta.env.BASE_URL.replace(/\/$/, '') + (lang === 'ru' ? '/ru/' : '/');
import '../styles/global.css';
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={t("WERKRAUM Auto-Service – ein Werkstatt-Konzept von HIRDA. Leistungen, Beispielpreise und Termin-Demo.")}/><title>{t("WERKRAUM — Auto-Service mit klarem Plan · Demo")}</title></head><body>
<a class="skip" href="#main">{t("Zum Inhalt")}</a><div class="demo">{t("PORTFOLIO-KONZEPT VON HIRDA.")} <span>{t("Kein echter Betrieb · alle Angaben sind Beispiele.")}</span></div>
<header class="wrap header"><a href={home} class="brand" aria-label={t("WERKRAUM Startseite")}><span class="brand-mark" aria-hidden="true">//</span><span>WERKRAUM<small>{t("AUTO-SERVICE")}</small></span></a><nav aria-label={t("Hauptnavigation")}><a href="#leistungen">{t("Leistungen")}</a><a href="#ablauf">{t("Unser Ablauf")}</a><a href="#kontakt">{t("Kontakt")}</a></nav><nav class="languages" aria-label={lang === "ru" ? "Выбор языка" : "Sprache wählen"}><a href={import.meta.env.BASE_URL} lang="de" hreflang="de" aria-current={lang === "de" ? "page" : undefined}>DE</a><a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/ru/`} lang="ru" hreflang="ru" aria-current={lang === "ru" ? "page" : undefined}>RU</a></nav><a class="button small" href="#termin">{t("Termin anfragen")} <span aria-hidden="true">↗</span></a></header>
<main id="main"><section class="hero wrap"><div class="hero-top"><p class="eyebrow"><span class="dot"></span> {t("KFZ-SERVICE IN MÜNCHEN")}</p><span class="hero-index">{t("TECHNIK. VERTRAUEN. WEITERFAHREN.")}</span></div><div class="hero-title"><h1>{t("DEIN AUTO.")}<br/><span>{t("UNSER HANDWERK.")}</span></h1><div class="hero-intro"><p>{t("Gute Arbeit beginnt mit einem klaren Plan. Wartung, Diagnose und Reparatur — verständlich erklärt und gemeinsam abgestimmt.")}</p><a href="#leistungen" class="text-link">{t("Leistungen entdecken")} <span aria-hidden="true">↓</span></a></div></div><div class="hero-photo"><img src={site.photo} alt={t("Mechaniker bei Wartungsarbeiten unter einem angehobenen Fahrzeug")} width="1800" height="1200" fetchpriority="high"/><div class="photo-caption"><span>{t("01 / IN DER WERKSTATT")}</span><strong>{t("Auf jedes Detail kommt es an.")}</strong></div><span class="photo-label">{t("AUTO-SERVICE")}<br/>{t("MIT KLAREM PLAN.")}</span></div><div class="trust-row"><span>01 <strong>{t("Verständliche Diagnose")}</strong></span><span>02 <strong>{t("Abgestimmter Umfang")}</strong></span><span>03 <strong>{t("Transparente Kosten")}</strong></span></div></section>
<section class="light" id="leistungen"><div class="wrap section"><div class="section-heading"><div><p class="eyebrow">{t("WAS DEIN AUTO BRAUCHT")}</p><h2>{t("Gute Technik.")}<br/>{t("In guten Händen.")}</h2></div><p>{t("Vom saisonalen Räderwechsel bis zur Fehlersuche.")}<br/>{t("Ein Ansprechpartner für die nächsten Schritte.")}</p></div><div class="service-list">{site.services.map(s=><article class="service"><span class="service-number">{s.icon}</span><div><span class="category">{s.category}</span><h3>{s.name}</h3></div><p>{s.text}</p><div class="service-price"><strong>{s.price}</strong><a href="#termin" data-service={s.name} aria-label={`${t("Anfragen")}: ${s.name}`}>{t("Anfragen")} <span aria-hidden="true">↗</span></a></div><p class="price-detail">{s.detail}</p></article>)}</div><p class="footnote">{t("Alle Beträge sind unverbindliche Beispielpreise für dieses Demo-Projekt.")}</p></div></section>
<section class="wrap section process" id="ablauf"><div class="section-heading"><div><p class="eyebrow">{t("KEINE OFFENEN FRAGEN")}</p><h2>{t("Erst verstehen.")}<br/>{t("Dann schrauben.")}</h2></div><p>{t("Du sollst wissen, was gemacht wird —")}<br/>{t("und warum es sinnvoll ist.")}</p></div><div class="steps">{[{n:'01',title:t("Du schilderst dein Anliegen."),text:t("Fahrzeug, gew\u00fcnschte Leistung oder ein auff\u00e4lliges Ger\u00e4usch. Damit beginnt die Einsch\u00e4tzung.")},{n:'02',title:t("Wir besprechen den Plan."),text:t("Arbeitsumfang und Kosten w\u00fcrden vorab gekl\u00e4rt. Zus\u00e4tzliche Arbeiten nur nach R\u00fccksprache.")},{n:'03',title:t("Du wei\u00dft, was gemacht wurde."),text:t("Eine verst\u00e4ndliche Zusammenfassung der Arbeiten geh\u00f6rt zum Werkstattkonzept dazu.")}].map(step=><article><span>{step.n}</span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div></section>
<section class="booking-section" id="termin"><div class="wrap booking-layout"><div><p class="eyebrow">{t("DER ERSTE SCHRITT")}</p><h2>{t("Was können wir")}<br/>{t("für dein Auto tun?")}</h2><p class="booking-intro">{t("Wähle eine Leistung und deinen Wunschtermin. So könnte eine unkomplizierte Werkstattanfrage aussehen.")}</p><div class="demo-note"><span aria-hidden="true">↗</span><p><strong>{t("Einfach ausprobieren.")}</strong><br/>{t("Diese Demo sendet keine Daten. Deine Auswahl wird nur hier im Browser angezeigt.")}</p></div></div><form id="appointment" data-locale={lang === "ru" ? "ru-RU" : "de-DE"} data-labels={JSON.stringify([t("Fahrzeug"), t("Leistung"), t("Wunschtermin"), t("Tageszeit"), t("Anliegen"), t("Keine zusätzliche Angabe")])}><div class="form-top"><h3>{t("Deine Terminanfrage")}</h3><span>{t("DEMO")}</span></div><label>{t("Fahrzeug")} <input name="vehicle" required maxlength="80" placeholder={t("z. B. VW Golf, Baujahr 2020")} autocomplete="off"/></label><label>{t("Gewünschte Leistung")} <select name="service" required><option value="">{t("Bitte auswählen")}</option>{site.services.map(s=><option>{s.name}</option>)}<option>{t("Sonstiges / Beratung")}</option></select></label><div class="form-row"><label>{t("Wunschtermin")} <input name="date" type="date" required/></label><label>{t("Tageszeit")} <select name="time"><option>{t("Vormittags")}</option><option>{t("Nachmittags")}</option><option>{t("Flexibel")}</option></select></label></div><label>{t("Was ist dir aufgefallen?")} <span class="optional">{t("Optional")}</span><textarea name="note" maxlength="500" rows="3" placeholder={t("Beschreibe dein Anliegen in wenigen Worten.")}></textarea></label><p class="form-help">{t("Bitte nutze Beispieldaten. Es werden keine Kontaktangaben benötigt.")}</p><button class="button" type="submit">{t("Anfrage als Vorschau ansehen")} <span aria-hidden="true">↗</span></button><noscript><p>{t("Für die Vorschau bitte JavaScript aktivieren.")}</p></noscript></form></div></section>
<section class="light"><div class="wrap section faq-layout"><div><p class="eyebrow">{t("GUT ZU WISSEN")}</p><h2>{t("Kurz gefragt.")}<br/>{t("Klar beantwortet.")}</h2></div><div class="faq">{site.faq.map(item=><details><summary>{item.q}<span aria-hidden="true">+</span></summary><div class="answer"><p>{item.a}</p></div></details>)}</div></div></section>
<section class="wrap section" id="kontakt"><div class="section-heading"><div><p class="eyebrow">{t("DER WEG ZU UNS")}</p><h2>{t("Wir sehen uns")}<br/>{t("in der Werkstatt.")}</h2></div><span class="demo-tag">{t("FIKTIVER DEMO-STANDORT")}</span></div><div class="contact-layout"><div class="contact-info"><div><h3>{t("Adresse")}</h3><p>{site.address}<br/><small>{t("Fiktive Anschrift, nicht auf der Karte verortet.")}</small></p></div><div><h3>{t("Kontakt")}</h3><p>{site.phone}<br/>{site.email}<br/><small>{t("Demodaten · nicht erreichbar")}</small></p></div><div><h3>{t("Öffnungszeiten")}</h3><dl><div><dt>{t("Montag – Freitag")}</dt><dd>08:00 – 18:00</dd></div><div><dt>{t("Samstag")}</dt><dd>{t("Nach Vereinbarung")}</dd></div><div><dt>{t("Sonntag")}</dt><dd>{t("Geschlossen")}</dd></div></dl></div></div><div class="map"><iframe title={t("Beispielkarte: München, kein Werkstattstandort")} src={`https://www.google.com/maps?q=M%C3%BCnchen&z=11&hl=${lang}&output=embed`} loading="lazy" width="640" height="400" referrerpolicy="strict-origin-when-cross-origin"></iframe><p>{t("MÜNCHEN · STADTANSICHT ZUR DEMONSTRATION")}</p></div></div></section>
</main><footer class="wrap footer"><a class="brand" href={home}><span class="brand-mark" aria-hidden="true">//</span><span>WERKRAUM<small>{t("AUTO-SERVICE")}</small></span></a><p>{t("Ein Website-Konzept von HIRDA. ·")} {new Date().getFullYear()}</p><a href="https://unsplash.com/photos/jL9zfzTVSwY" target="_blank" rel="noopener noreferrer">{t("Foto: Jimmy Nilsson Masth / Unsplash ↗")}</a></footer>
<dialog id="preview" aria-labelledby="preview-title"><div class="dialog-top"><span class="eyebrow">{t("DEINE VORSCHAU")}</span><button type="button" id="close" aria-label={t("Vorschau schließen")}>×</button></div><h2 id="preview-title">{t("Alles richtig?")}</h2><dl id="summary"></dl><p class="form-help">{t("Es wurde kein Termin gebucht und keine Anfrage versendet.")}</p><button type="button" id="edit" class="button">{t("Angaben bearbeiten")}</button></dialog>
<script>
 const form=document.querySelector<HTMLFormElement>('#appointment')!;
 const labels: string[] = JSON.parse(form.dataset.labels!);
 const date=form.elements.namedItem('date') as HTMLInputElement;
 const now=new Date();date.min=`${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}`;
 document.querySelectorAll<HTMLAnchorElement>('[data-service]').forEach(link=>link.addEventListener('click',()=>{(form.elements.namedItem('service') as HTMLSelectElement).value=link.dataset.service!;}));
 const dialog=document.querySelector<HTMLDialogElement>('#preview')!;
 form.addEventListener('submit',event=>{event.preventDefault();if(!form.reportValidity())return;const data=new FormData(form);const summary=document.querySelector('#summary')!;summary.replaceChildren();const rows=[[labels[0],data.get('vehicle')],[labels[1],data.get('service')],[labels[2],new Intl.DateTimeFormat(form.dataset.locale).format(new Date(`${data.get('date')}T12:00:00`))],[labels[3],data.get('time')],[labels[4],data.get('note')||labels[5]]];for(const [label,value] of rows){const row=document.createElement('div');const dt=document.createElement('dt');const dd=document.createElement('dd');dt.textContent=String(label);dd.textContent=String(value);row.append(dt,dd);summary.append(row);}dialog.showModal();});
 for(const id of ['close','edit'])document.getElementById(id)!.addEventListener('click',()=>dialog.close());
 document.querySelectorAll<HTMLDetailsElement>('.faq details').forEach(details=>{const summary=details.querySelector('summary')!;const answer=details.querySelector<HTMLElement>('.answer')!;let animation:Animation|null=null;let expanded=details.open;summary.addEventListener('click',event=>{if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;event.preventDefault();const start=details.getBoundingClientRect().height;expanded=animation?!expanded:!details.open;animation?.cancel();details.open=true;const end=summary.getBoundingClientRect().height+(expanded?answer.getBoundingClientRect().height:0);details.style.overflow='hidden';animation=details.animate({height:[`${start}px`,`${end}px`]},{duration:250,easing:'ease-out'});animation.onfinish=()=>{details.open=expanded;details.style.overflow='';animation=null;};});});
</script><SectionMotion /></body></html>
