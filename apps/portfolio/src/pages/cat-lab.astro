---
import RoboCat3D from "../components/RoboCat3D.astro";
const home = import.meta.env.BASE_URL || "/";
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#0a141c" />
    <title>HIRDA CAT / 3D LAB</title>
    <meta name="description" content="Интерактивная WebGL-модель HIRDA CAT на Three.js" />
  </head>
  <body>
    <main>
      <header class="bar">
        <a href={home} class="logo">[H]IRDA</a>
        <a href={home} class="back">← К портфолио</a>
      </header>
      <div class="content">
        <div class="intro">
          <span class="eyebrow">3D / EXPERIMENT 01</span>
          <h1>Meet <em>HIRDA CAT.</em></h1>
          <p>Тот же дружелюбный робокот — теперь настоящая 3D-сцена. Он моргает, реагирует на команды и поворачивается за пальцем.</p>
        </div>
        <RoboCat3D />
        <div class="bottom"><span>THREE.JS + WEBGL</span><span>MADE FOR HIRDA / 2026</span></div>
      </div>
    </main>
  </body>
</html>
<style>
  * { box-sizing: border-box; }
  html { background: #0a141c; color: #fff; }
  body { margin: 0; font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace; }
  main { min-height: 100dvh; padding: 25px clamp(16px, 4vw, 55px) 34px; }
  .bar { max-width: 1120px; margin: auto; display: flex; align-items: center; justify-content: space-between; }
  a { color: inherit; text-decoration: none; }
  a:focus-visible { outline: 2px solid #ff9e58; outline-offset: 5px; }
  .logo { font-size: 27px; font-weight: 900; letter-spacing: -.07em; }
  .back { font-size: 12px; color: #cad2d5; }
  .content { max-width: 900px; margin: 28px auto 0; }
  .intro { max-width: 660px; margin-bottom: 25px; }
  .eyebrow { font-size: 11px; letter-spacing: .19em; color: #d2d6b0; }
  h1 { font-size: clamp(39px, 7vw, 75px); font-weight: 650; letter-spacing: -.06em; line-height: 1.04; margin: 13px 0 14px; }
  h1 em { color: #ff9e58; font-style: normal; }
  .intro p { max-width: 620px; color: #b7c2c6; line-height: 1.7; font-size: 13px; }
  .bottom { display: flex; gap: 10px; justify-content: space-between; margin-top: 40px; border-top: 1px solid #33434b; padding-top: 18px; color: #8ea1ab; font-size: 10px; letter-spacing: .08em; }
  @media(max-width: 600px) { .logo { font-size: 23px; } .back { font-size: 10px; } .content { margin-top: 38px; } }
</style>
