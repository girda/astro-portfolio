---
import BaseLayout from './BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { legalUpdated } from '../config/legal';
interface Props {title:string;description:string}
const {title,description}=Astro.props;
const base=import.meta.env.BASE_URL;
---
<BaseLayout title={`${title} — HIRDA`} description={description} lang="de" motion={false}>
  <a class="legal-skip" href="#legal-content">Zum Inhalt</a>
  <header class="legal-header container" id="top">
    <a class="legal-brand" href={base} aria-label="HIRDA Startseite"><span>[</span>H<span>]</span>IRDA</a>
    <a class="legal-back" href={base}>Zurück zum Portfolio</a>
  </header>
  <main id="legal-content" class="legal-main container">
    <p class="legal-eyebrow">HIRDA · Rechtliche Informationen</p>
    <h1>{title}</h1>
    <p class="legal-date">Stand: {legalUpdated} · Deutsche Fassung</p>
    <nav class="legal-tabs" aria-label="Rechtliche Seiten">
      <a href={`${base}impressum/`} aria-current={title==='Impressum'?'page':undefined}>Impressum</a>
      <a href={`${base}datenschutz/`} aria-current={title==='Datenschutzhinweise'?'page':undefined}>Datenschutz</a>
    </nav>
    <article><slot /></article>
  </main>
  <SiteFooter lang="de" homeHref={base}/>
</BaseLayout>
<style>
 .legal-header{display:flex;justify-content:space-between;align-items:center;gap:20px;padding-block:28px;border-bottom:1px solid #ffffff20}.legal-brand{font:650 28px/1.2 var(--font-body);letter-spacing:.03em}.legal-brand span{color:var(--brand-accent)}.legal-back{font-size:14px;text-decoration:underline;text-underline-offset:5px;padding-block:10px}.legal-main{max-width:960px;padding-block:64px 48px}.legal-eyebrow{font:12px/1.5 var(--font-code);letter-spacing:.08em;color:#c2cbc6}.legal-main h1{font:600 clamp(32px,6vw,56px)/1.1 var(--font-body);letter-spacing:-.04em;margin:18px 0}.legal-date{font-size:13px;color:#c2cbc6}.legal-tabs{display:flex;flex-wrap:wrap;gap:12px 24px;margin:28px 0 44px;padding-bottom:20px;border-bottom:1px solid #ffffff20}.legal-tabs a{padding:8px 0;text-decoration:underline;text-underline-offset:6px}.legal-tabs a[aria-current]{color:#efaa7e}.legal-main article{max-width:78ch;overflow-wrap:anywhere}.legal-main :global(h2){font-size:clamp(23px,3vw,30px);line-height:1.3;margin:44px 0 16px;scroll-margin-top:24px}.legal-main :global(h3){font-size:19px;margin:26px 0 12px}.legal-main :global(p),.legal-main :global(li){color:#e0e4de;font:400 16px/1.8 var(--font-body)}.legal-main :global(address){font-style:normal;line-height:1.9}.legal-main :global(a){text-decoration:underline;text-underline-offset:4px}.legal-main :global(a:hover),.legal-back:hover{color:#efaa7e}.legal-main :global(ul){padding-left:22px}.legal-main :global(li){margin:8px 0}.legal-main :global(.legal-summary){border-left:3px solid var(--brand-accent);padding:16px 20px;background:#ffffff06}.legal-skip{position:absolute;top:-100px;left:18px;z-index:10;background:#22282c;padding:12px}.legal-skip:focus{top:12px}@media(max-width:700px){.legal-header{padding-block:20px}.legal-brand{font-size:24px}.legal-back{max-width:140px;text-align:right}.legal-main{padding-block:36px}.legal-tabs{margin-bottom:28px}}
</style>
