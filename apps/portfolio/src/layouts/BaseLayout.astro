---
import SectionMotion from "../components/SectionMotion.astro";
interface Props {
  title: string;
  description: string;
  lang?: "de" | "ru" | "en";
}

const { title, description, lang = "de" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body>
    <slot />
  <SectionMotion /></body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html {
    color-scheme: dark;
    background: #0c1020;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    color: #f5f5f7;
    font-family: "Helvetica Neue", Arial, Helvetica, sans-serif;
    line-height: 1.6;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:focus-visible {
    outline: 2px solid #8da7ff;
    outline-offset: 6px;
  }

  .container {
    width: min(1240px, calc(100% - 48px));
    margin-inline: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>