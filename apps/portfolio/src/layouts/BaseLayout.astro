---
import "../styles/atmosphere.css";
import "../styles/input-focus.css";
import "../styles/typography.css";
import "../styles/rhythm.css";
import { heroCopy } from "../data/hero";
import { createSiteConfig } from "../config/site";
import { pageSeo } from "../lib/seo";
import ReturnVisit from "../components/ReturnVisit.astro";
import ScrollHeadings from "../components/ScrollHeadings.astro";
import SectionMotion from "../components/SectionMotion.astro";
interface Props {
  title: string;
  description: string;
  lang?: "de" | "ru" | "en";
  noindex?: boolean;
  canonicalPath?: string;
  socialImage?: string;
}

const { lang = "de" } = Astro.props;
const locale = lang;
const copy = heroCopy[locale];
const title = Astro.props.title;
const description = Astro.props.description;
// Единые URL и политика индексации используются также статическими SEO endpoints.
const config = createSiteConfig({
  origin: Astro.site,
  base: import.meta.env.BASE_URL,
  indexable: import.meta.env.PROD && import.meta.env.SITE_INDEXABLE !== "false",
});
const seo = pageSeo({
  path: Astro.props.canonicalPath ?? Astro.url.pathname,
  locale,
  config,
  noindex: Astro.props.noindex,
  image: Astro.props.socialImage,
});
const canonical = seo.canonical;
const image = seo.image;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title}</title>
    <ReturnVisit />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={seo.robots} />
    {seo.alternates.map(item => <link rel="alternate" hreflang={item.lang} href={item.href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HIRDA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={({ de: "de_DE", en: "en_GB", ru: "ru_RU" })[locale]} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`HIRDA — ${copy.lines.join(" ")}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
  </head>

  <body>
    <div class="site-atmosphere" aria-hidden="true"></div>
    <slot />
    <ScrollHeadings />
    <SectionMotion />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html {
    color-scheme: dark;
    background: #22282c;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    position: relative;
    isolation: isolate;
    background: #22282c;
    color: #f4f1eb;
    font-family: var(--font-body);
    line-height: 1.6;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:focus-visible {
    outline: 2px solid #c1cfcc;
    outline-offset: 6px;
  }

  .container {
    width: min(1240px, calc(100% - 64px));
    margin-inline: auto;
  }

  @media (max-width: 700px) {
    .container {
      width: calc(100% - 36px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
