---
import "../styles/atmosphere.css";
import "../styles/typography.css";
import "../styles/rhythm.css";
import ScrollHeadings from "../components/ScrollHeadings.astro";
import SectionMotion from "../components/SectionMotion.astro";
interface Props {
  title: string;
  description: string;
  lang?: "de" | "ru" | "en";
}

const { title, description, lang = "de" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const key = 'hirda:last-visit';
        const hour = 60 * 60 * 1000;
        let reset = false;
        const registerVisit = () => {
          try {
            const now = Date.now();
            const previous = Number(localStorage.getItem(key));
            reset = previous > 0 && now - previous >= hour;
            localStorage.setItem(key, String(now));
            if (reset) {
              history.replaceState(history.state, '', location.pathname + location.search);
              history.scrollRestoration = 'manual';
            }
          } catch { /* Сайт работает и при запрещённом localStorage. */ }
        };
        registerVisit();
        addEventListener('pageshow', event => {
          if (event.persisted) registerVisit();
          if (reset) {
            window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
            history.scrollRestoration = 'auto';
            reset = false;
          }
        });
      })();
    </script>
  </head>

  <body>
    <div class="site-atmosphere" aria-hidden="true"></div>
    <slot />
    <ScrollHeadings />
    <SectionMotion />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html {
    color-scheme: dark;
    background: #22282c;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    position: relative;
    isolation: isolate;
    background: #22282c;
    color: #f4f1eb;
    font-family: var(--font-body);
    line-height: 1.6;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:focus-visible {
    outline: 2px solid #f6b17b;
    outline-offset: 6px;
  }

  .container {
    width: min(1240px, calc(100% - 64px));
    margin-inline: auto;
  }

  @media (max-width: 700px) {
    .container {
      width: calc(100% - 36px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
