---
interface Props {
  lang?: 'de' | 'ru' | 'en';
}

const { lang = 'de' } = Astro.props;
const copy = {
  de: {
    greeting: 'Hi! Ich bin Artems KI-Assistent. Frag mich zu Projekten, Preisen oder Websites.',
    title: 'HIRDA CAT',
    status: 'DIGITALER ASSISTENT · DEMO',
    subtitle: 'WAS MÖCHTEST DU WISSEN?',
    open: 'HIRDA CAT öffnen',
    close: 'Chat schließen',
    dismiss: 'Hinweis schließen',
    placeholder: 'Deine Frage an mich …',
    send: 'Senden',
    welcome: 'Hi! 👋 Ich bin Artems KI-Assistent. Ich zeige dir gerne Projekte, Leistungen oder Preise. Was interessiert dich?',
    projects: 'Projekte',
    prices: 'Preise',
    services: 'Leistungen',
    contact: 'Kontakt',
    disclaimer: 'Demo-Modus: Antworten sind noch nicht mit einer KI verbunden.',
  },
  ru: {
    greeting: 'Привет! Я ИИ-помощник Артёма. Спроси меня о проектах, ценах или сайтах.',
    title: 'HIRDA CAT',
    status: 'ЦИФРОВОЙ ПОМОЩНИК · ДЕМО',
    subtitle: 'ЧТО ТЕБЯ ИНТЕРЕСУЕТ?',
    open: 'Открыть HIRDA CAT',
    close: 'Закрыть чат',
    dismiss: 'Закрыть подсказку',
    placeholder: 'Твой вопрос …',
    send: 'Отправить',
    welcome: 'Привет! 👋 Я ИИ-помощник Артёма. Расскажу о его проектах, услугах и ценах. Что тебя интересует?',
    projects: 'Проекты',
    prices: 'Цены',
    services: 'Услуги',
    contact: 'Контакты',
    disclaimer: 'Демо-режим: ответы пока не подключены к ИИ.',
  },
  en: {
    greeting: 'Hi! I’m Artem’s AI assistant. Ask me about projects, pricing or websites.',
    title: 'HIRDA CAT',
    status: 'DIGITAL ASSISTANT · DEMO',
    subtitle: 'WHAT WOULD YOU LIKE TO KNOW?',
    open: 'Open HIRDA CAT',
    close: 'Close chat',
    dismiss: 'Dismiss hint',
    placeholder: 'Ask me anything …',
    send: 'Send',
    welcome: 'Hi! 👋 I’m Artem’s AI assistant. I can guide you through his projects, services, or prices. What interests you?',
    projects: 'Projects',
    prices: 'Pricing',
    services: 'Services',
    contact: 'Contact',
    disclaimer: 'Demo mode: responses are not connected to AI yet.',
  },
}[lang];
const robotSrc = `${import.meta.env.BASE_URL}ai/robot-cat.webp`;
const avatarSrc = `${import.meta.env.BASE_URL}ai/face-default.webp`;
---

<div class="hirda-cat" data-hirda-cat data-lang={lang}>
  <!-- Закрывает фон, но чат остаётся отдельным виджетом. -->
  <div class="cat-backdrop" data-cat-backdrop hidden aria-hidden="true"></div>
  <div class="cat-bubble" data-cat-bubble hidden>
    <button class="bubble-text" type="button" data-cat-bubble-open aria-label={copy.open}>{copy.greeting}</button>
    <button class="bubble-close" type="button" data-cat-dismiss aria-label={copy.dismiss}>×</button>
  </div>

  <button class="cat-launcher" type="button" data-cat-launcher aria-expanded="false" aria-controls="hirda-cat-panel" aria-label={copy.open}>
    <span class="cat-spark" aria-hidden="true">✦</span>
    <img src={robotSrc} alt="" width="750" height="750" decoding="async" />
    <span class="launcher-glow" aria-hidden="true"></span>
  </button>

  <section class="cat-panel" id="hirda-cat-panel" data-cat-panel tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="hirda-cat-title" hidden>
    <div class="cat-accent-bar" aria-hidden="true"></div>
    <header class="cat-head">
      <div class="head-avatar" aria-hidden="true"><img data-cat-avatar src={avatarSrc} alt="" width="350" height="330" decoding="async" /></div>
      <div class="head-copy">

        <h2 id="hirda-cat-title">{copy.title}</h2>

      </div>
      <button class="cat-close" type="button" data-cat-close aria-label={copy.close}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M5 5 19 19M19 5 5 19" /></svg>
      </button>
    </header>

    <div class="cat-conversation" data-cat-conversation role="log" aria-live="polite" aria-label="Chat">

      <div class="chat-message is-bot">{copy.welcome}</div>
      <div class="cat-topics" data-cat-topics>
        <button type="button" data-cat-topic="projects"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M3 9h18M8 9v11"/></svg>{copy.projects}</button>
        <button type="button" data-cat-topic="prices"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 7a7 7 0 1 0 0 10M4 10h11M4 14h10"/></svg>{copy.prices}</button>
        <button type="button" data-cat-topic="services"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="14" rx="3"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12a23 23 0 0 0 18 0M12 11v3"/></svg>{copy.services}</button>
        <button type="button" data-cat-topic="contact"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5H4l-1 1v-9.5a8.5 8.5 0 0 1 17 0Z"/><path d="M8 10h8M8 14h5"/></svg>{copy.contact}</button>
      </div>
    </div>

    <div class="cat-bottom">
      <form class="cat-compose" data-cat-form>
        <label class="sr-only" for="hirda-cat-input">{copy.placeholder}</label>
        <input id="hirda-cat-input" data-cat-input type="text" autocomplete="off" maxlength="350" placeholder={copy.placeholder} />
        <button type="submit" aria-label={copy.send}>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 14-7-4 14-3.1-6.9L5 12Z"/><path d="m12 12 7-7"/></svg>
        </button>
      </form>
      <p class="cat-notice">{copy.disclaimer}</p>
    </div>
  </section>
</div>

<script>
  type Lang = 'de' | 'ru' | 'en';
  type Topic = 'projects' | 'prices' | 'services' | 'contact';
  const dictionary = {
    de: {
      project: 'Artem zeigt vier Website-Konzepte: KANT (Barbershop), KLAR (Reinigung), WERKRAUM (Autowerkstatt) und STILL (Nagelstudio).',
      pricing: 'Die Einstiegspreise sind: Landingpage ab 490 €, Business-Website ab 790 € und Website mit CMS ab 1.290 €. Der Endpreis hängt vom Umfang ab.',
      service: 'Artem bietet Websites, Landingpages, Redesign, CMS und individuelle Funktionen. Die passende Lösung hängt von deinem Projekt ab.',
      contact: 'Du kannst Artem über das Kontaktformular auf der Seite erreichen. Dort bereitest du eine WhatsApp-Nachricht vor und sendest sie selbst ab.',
      unknown: 'Das ist bisher eine interaktive Demo. Wähle unten ein Thema oder sieh dir Artems Projekte und Leistungen direkt auf der Seite an.',
      labels: { projects: 'Projekte ansehen', prices: 'Preise ansehen', services: 'Leistungen ansehen', contact: 'Zum Kontakt' },
      names: { projects: 'Projekte', prices: 'Preise', services: 'Leistungen', contact: 'Kontakt' },
    },
    en: {
      project: 'Artem showcases four website concepts: KANT (barbershop), KLAR (cleaning), WERKRAUM (auto service), and STILL (nail studio).',
      pricing: 'Starting prices: landing page from €490, business website from €790, and a CMS website from €1,290. The final quote depends on the scope.',
      service: 'Artem builds websites, landing pages, redesigns, CMS sites and custom features tailored to a business.',
      contact: 'Use the contact section to prepare a WhatsApp enquiry. You can review the message and send it yourself.',
      unknown: 'This is an interactive demo for now. Choose a topic below, or explore Artem’s work directly on this page.',
      labels: { projects: 'See projects', prices: 'See pricing', services: 'See services', contact: 'Go to contact' },
      names: { projects: 'Projects', prices: 'Pricing', services: 'Services', contact: 'Contact' },
    },
    ru: {
      project: 'Артём показывает четыре проекта: KANT (барбершоп), KLAR (клининг), WERKRAUM (автосервис), STILL (студия маникюра).',
      pricing: 'Стартовые цены: лендинг от 490 €, сайт для бизнеса от 790 €, сайт с CMS от 1 290 €. Итоговая стоимость зависит от задач.',
      service: 'Артём создаёт сайты, лендинги, редизайн, сайты с CMS и индивидуальные функции.',
      contact: 'В разделе контактов можно подготовить сообщение в WhatsApp, проверить его и отправить Артёму.',
      unknown: 'Это пока интерактивное демо. Выбери тему ниже или посмотри проекты и услуги на сайте.',
      labels: { projects: 'Смотреть проекты', prices: 'Смотреть цены', services: 'Смотреть услуги', contact: 'К контактам' },
      names: { projects: 'Проекты', prices: 'Цены', services: 'Услуги', contact: 'Контакты' },
    },
  };

  const root = document.querySelector<HTMLElement>('[data-hirda-cat]');
  if (root) {
    const lang: Lang = root.dataset.lang === 'ru' || root.dataset.lang === 'en' ? root.dataset.lang : 'de';
    const texts = dictionary[lang];
    // Публичный URL задаётся при сборке; ключ OpenAI здесь никогда не используется.
    const apiUrl = import.meta.env.DEV ? 'http://127.0.0.1:8787/api/chat' : (import.meta.env.PUBLIC_ASSISTANT_API_URL || '');
    let testAccess = '';
    const testLabel = lang === 'de' ? 'Testzugang: Zugangscode eingeben' : lang === 'ru' ? 'Тестовый доступ: введи код' : 'Test access: enter access code';
    const apiCopy = {
      de: { notice: 'KI-Test · Nachrichten werden an OpenAI gesendet. Keine sensiblen Daten eingeben.', thinking: 'Ich denke nach …', error: 'Gerade keine Verbindung. Bitte versuche es erneut.', missing: 'Der lokale API-Schlüssel fehlt noch.', limit: 'Zu viele Anfragen. Bitte warte eine Minute.', retry: 'Erneut versuchen' },
      en: { notice: 'AI test · Messages are sent to OpenAI. Do not enter sensitive data.', thinking: 'Thinking …', error: 'Unable to connect. Please try again.', missing: 'The local API key is not configured yet.', limit: 'Too many requests. Please wait a minute.', retry: 'Try again' },
      ru: { notice: 'Тест ИИ · Сообщения передаются в OpenAI. Не вводи чувствительные данные.', thinking: 'Думаю …', error: 'Нет соединения. Попробуй ещё раз.', missing: 'Локальный API-ключ пока не настроен.', limit: 'Слишком много запросов. Подожди минуту.', retry: 'Повторить' },
    }[lang];
    const history: { role: 'user' | 'assistant'; content: string }[] = [];
    let busy = false;
    let failedMessage: string | null = null;
    let feedback: HTMLElement | null = null;
    if (apiUrl) root.querySelector<HTMLElement>('.cat-notice')!.textContent = apiCopy.notice;
    const bubble = root.querySelector<HTMLElement>('[data-cat-bubble]')!;
    const backdrop = root.querySelector<HTMLElement>('[data-cat-backdrop]')!;
    const avatar = root.querySelector<HTMLImageElement>('[data-cat-avatar]')!;
    const faceDefault = `${import.meta.env.BASE_URL}ai/face-default.webp`;
    const faceWink = `${import.meta.env.BASE_URL}ai/face-wink.webp`;
    const faceHappy = `${import.meta.env.BASE_URL}ai/face-happy.webp`;
    const bubbleOpener = root.querySelector<HTMLButtonElement>('[data-cat-bubble-open]')!;
    const launcher = root.querySelector<HTMLButtonElement>('[data-cat-launcher]')!;
    const panel = root.querySelector<HTMLElement>('[data-cat-panel]')!;
    const closer = root.querySelector<HTMLButtonElement>('[data-cat-close]')!;
    const dismiss = root.querySelector<HTMLButtonElement>('[data-cat-dismiss]')!;
    const log = root.querySelector<HTMLElement>('[data-cat-conversation]')!;
    const form = root.querySelector<HTMLFormElement>('[data-cat-form]')!;
    const input = root.querySelector<HTMLInputElement>('[data-cat-input]')!;
    const topics = root.querySelector<HTMLElement>('[data-cat-topics]')!;
    let bubbleTimer: number | undefined;
    let shownBubble = false;
    let oldBodyOverflow = '';
    let returnFocus: HTMLElement = launcher;
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let emotionTimer: number | undefined;
    let blinkTimer: number | undefined;
    let viewportHeight = window.innerHeight;
    let viewportFrame = 0;
    const visualViewport = window.visualViewport;

    // При появлении клавиатуры помещаем панель в реально видимую область.
    const updateViewport = () => {
      if (panel.hidden) return;
      const height = visualViewport?.height ?? window.innerHeight;
      const keyboard = matchMedia('(max-width: 600px)').matches &&
        document.activeElement === input && viewportHeight - height > 100;
      root.classList.toggle('has-keyboard', keyboard);
      root.style.setProperty('--cat-visible-height', `${height}px`);
      root.style.setProperty('--cat-visible-top', `${visualViewport?.offsetTop ?? 0}px`);
    };
    const scheduleViewport = () => {
      cancelAnimationFrame(viewportFrame);
      viewportFrame = requestAnimationFrame(updateViewport);
    };
    visualViewport?.addEventListener('resize', scheduleViewport);
    visualViewport?.addEventListener('scroll', scheduleViewport);
    window.addEventListener('resize', scheduleViewport);
    input.addEventListener('focus', scheduleViewport);
    input.addEventListener('blur', scheduleViewport);

    const resetEmotion = () => {
      clearTimeout(emotionTimer);
      avatar.src = faceDefault;
    };
    const showEmotion = (src: string, duration: number) => {
      resetEmotion();
      if (reducedMotion.matches || document.hidden || panel.hidden) return;
      avatar.src = src;
      emotionTimer = window.setTimeout(resetEmotion, duration);
    };
    const syncBlink = () => {
      clearInterval(blinkTimer);
      resetEmotion();
      if (!panel.hidden && !document.hidden && !reducedMotion.matches) {
        blinkTimer = window.setInterval(() => showEmotion(faceWink, 240), 6500);
      }
    };
    reducedMotion.addEventListener('change', syncBlink);
    document.addEventListener('visibilitychange', syncBlink);

    const dismissBubble = () => { bubble.hidden = true; window.clearTimeout(bubbleTimer); };
    const showBubble = () => {
      if (shownBubble || !panel.hidden) return;
      shownBubble = true;
      bubble.hidden = false;
      bubbleTimer = window.setTimeout(dismissBubble, 8000);
    };
    window.setTimeout(showBubble, 2800);

    const openChat = (opener: HTMLElement = launcher) => {
      if (!panel.hidden) return;
      returnFocus = opener === bubbleOpener ? launcher : opener;
      viewportHeight = window.innerHeight;
      dismissBubble();
      shownBubble = true;
      backdrop.hidden = false;
      panel.hidden = false;
      root.classList.add('is-open');
      oldBodyOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      launcher.setAttribute('aria-expanded', 'true');
      // На телефоне не открываем клавиатуру сразу: посетитель видит дизайн и подсказки.
      if (window.matchMedia('(min-width: 601px)').matches) input.focus();
      else panel.focus({ preventScroll: true });
      syncBlink();
      showEmotion(faceHappy, 750);
      scheduleViewport();
    };

    const closeChat = (restoreFocus = true) => {
      panel.hidden = true;
      backdrop.hidden = true;
      root.classList.remove('is-open');
      launcher.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = oldBodyOverflow;
      root.classList.remove('has-keyboard');
      cancelAnimationFrame(viewportFrame);
      syncBlink();
      if (restoreFocus) (returnFocus.isConnected ? returnFocus : launcher).focus({ preventScroll: true });
    };

    function addMessage(text: string, role: 'bot' | 'user', action?: { label: string; anchor: string }) {
      const node = document.createElement('div');
      node.className = `chat-message is-${role}`;
      node.textContent = text; // Никогда не вставляем содержимое пользователя как HTML.
      log.insertBefore(node, topics);
      if (action) {
        const link = document.createElement('a');
        link.className = 'cat-action';
        link.textContent = action.label;
        link.href = action.anchor;
        link.addEventListener('click', () => closeChat(false));
        log.insertBefore(link, topics);
      }
      log.scrollTop = log.scrollHeight;
    }

    async function sendToAgent(value: string, retry = false) {
      if (busy) return;
      if (apiUrl && !import.meta.env.DEV && !testAccess) {
        testAccess = window.prompt(testLabel)?.trim() || '';
        if (!testAccess) return;
      }
      busy = true;
      feedback?.remove();
      if (!retry) addMessage(value, 'user');
      failedMessage = null;
      feedback = document.createElement('div');
      feedback.className = 'chat-message is-bot';
      feedback.setAttribute('role', 'status');
      feedback.textContent = apiCopy.thinking;
      log.insertBefore(feedback, topics);
      log.scrollTop = log.scrollHeight;
      const controls = [...form.querySelectorAll<HTMLButtonElement | HTMLInputElement>('button,input'), ...topics.querySelectorAll<HTMLButtonElement>('button')];
      controls.forEach(control => { control.disabled = true; });
      form.setAttribute('aria-busy', 'true');
      try {
        const response = await fetch(apiUrl, {
          method: 'POST', headers: { 'Content-Type': 'application/json', ...(testAccess ? { Authorization: `Bearer ${testAccess}` } : {}) },
          body: JSON.stringify({ lang, messages: [...history.slice(-10), { role: 'user', content: value }] }),
          signal: AbortSignal.timeout(25000),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'unavailable');
        if (typeof result.text !== 'string' || !result.text.trim() || result.text.length > 4000) throw new Error('invalid_response');
        feedback.remove(); feedback = null;
        history.push({ role: 'user', content: value }, { role: 'assistant', content: result.text });
        if (history.length > 10) history.splice(0, history.length - 10);
        addMessage(result.text, 'bot');
        showEmotion(faceHappy, 750);
      } catch (error) {
        failedMessage = value;
        const code = error instanceof Error ? error.message : '';
        if (code === 'unauthorized') testAccess = '';
        feedback!.textContent = code === 'not_configured' ? apiCopy.missing : code === 'rate_limited' ? apiCopy.limit : apiCopy.error;
        const button = document.createElement('button');
        button.type = 'button'; button.className = 'cat-retry'; button.textContent = apiCopy.retry;
        button.addEventListener('click', () => { if (failedMessage) void sendToAgent(failedMessage, true); });
        feedback!.append(button);
      } finally {
        busy = false;
        controls.forEach(control => { control.disabled = false; });
        form.removeAttribute('aria-busy');
        log.scrollTop = log.scrollHeight;
      }
    }

    function replyToTopic(topic: Topic, userText: string) {
      addMessage(userText, 'user');
      const responses: Record<Topic, string> = {
        projects: texts.project, prices: texts.pricing, services: texts.service, contact: texts.contact,
      };
      addMessage(responses[topic], 'bot', { label: texts.labels[topic], anchor: topic === 'prices' ? '#pricing' : topic === 'services' ? '#services' : topic === 'contact' ? '#contact' : '#projects' });
    }

    function detectTopic(value: string): Topic | null {
      const q = value.toLowerCase();
      if (/preis|kosten|cost|price|budget|цена|стоим|сколько/.test(q)) return 'prices';
      if (/projekt|portfolio|project|work|работ|проект|пример/.test(q)) return 'projects';
      if (/kontakt|contact|whatsapp|email|связ|контакт|напис/.test(q)) return 'contact';
      if (/website|webseite|service|leistung|angebot|сайт|услуг|landing|cms|design/.test(q)) return 'services';
      return null;
    }

    launcher.addEventListener('click', () => panel.hidden ? openChat() : closeChat());
    bubbleOpener.addEventListener('click', () => openChat(bubbleOpener));
    root.addEventListener('hirda:open-chat', (event) => {
      const opener = (event as CustomEvent<HTMLElement>).detail;
      openChat(opener instanceof HTMLElement ? opener : launcher);
    });
    closer.addEventListener('click', () => closeChat());
    backdrop.addEventListener('click', () => closeChat());
    dismiss.addEventListener('click', dismissBubble);

    topics.querySelectorAll<HTMLButtonElement>('[data-cat-topic]').forEach((button) => {
      button.addEventListener('click', () => {
        const topic = button.dataset.catTopic as Topic;
        if (apiUrl) void sendToAgent(texts.names[topic]);
        else replyToTopic(topic, texts.names[topic]);
      });
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const value = input.value.trim();
      if (!value || busy) return;
      input.value = '';
      if (apiUrl) { void sendToAgent(value); return; }
      const topic = detectTopic(value);
      if (topic) replyToTopic(topic, value);
      else { addMessage(value, 'user'); addMessage(texts.unknown, 'bot'); }
    });

    document.addEventListener('keydown', (event) => {
      if (panel.hidden) return;
      if (event.key === 'Escape') { closeChat(); return; }
      if (event.key !== 'Tab') return;
      const focusables = Array.from(panel.querySelectorAll<HTMLElement>(
        'button:not([disabled]), input:not([disabled]), a[href]'
      ));
      if (!focusables.length) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }
</script>

<style>
  .cat-compose button:disabled, .cat-topics button:disabled { opacity: .5; cursor: wait; }
  .cat-conversation :global(.cat-retry) { display: block; margin-top: 10px; padding: 8px 12px; border: 1px solid #a7bab460; border-radius: 8px; background: #ffffff0a; color: inherit; font: inherit; cursor: pointer; }
  .cat-conversation :global(.chat-message) { white-space: pre-wrap; overflow-wrap: anywhere; }

  .hirda-cat {
    --cat-accent: #ffa36b;
    --cat-muted: #a9b6bc;
    --cat-border: rgba(215, 233, 233, .14);
    position: fixed;
    z-index: 900;
    right: 14px;
    bottom: calc(12px + env(safe-area-inset-bottom));
    color: #f7f5ef;
    font-family: var(--font-body, system-ui, sans-serif);
  }

  /* Тёмный полупрозрачный фон, закрывается по нажатию */
  .cat-backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: rgba(4, 9, 14, .62);
    backdrop-filter: blur(5px) saturate(.85);
    -webkit-backdrop-filter: blur(5px) saturate(.85);
    animation: backdrop-in .25s ease-out both;
  }
  .cat-backdrop[hidden], .cat-panel[hidden], .cat-bubble[hidden] {
    display: none !important;
  }

  /* Маскот остаётся видимым и служит визуальным якорем */
  .cat-launcher {
    position: relative;
    z-index: 2;
    display: block;
    width: 94px;
    height: 100px;
    padding: 0;
