---
interface Props {
  delay?: number;
  variant?: "default" | "project";
}

const { delay = 0, variant = "default" } = Astro.props;
---

<div class:list={["reveal", { "reveal-project": variant === "project" }]} style={`--reveal-delay: ${delay}ms`}>
  <slot />
</div>

<script>
  const elements = document.querySelectorAll<HTMLElement>(".reveal");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (!reducedMotion.matches && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.1 },
    );

    reducedMotion.addEventListener("change", () => {
      if (reducedMotion.matches) {
        observer.disconnect();
        elements.forEach((el) => el.classList.remove("reveal-ready"));
      }
    });
    for (const element of elements) {
      element.classList.add("reveal-ready");
      observer.observe(element);
    }
  }
</script>

<style>
  .reveal {
    min-width: 0;
  }

  .reveal-ready {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 1000ms ease var(--reveal-delay, 0ms),
      transform 1000ms ease var(--reveal-delay, 0ms);
  }

  .reveal-ready.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .reveal-project.reveal-ready {
    transform: perspective(1100px) translateY(24px) rotateX(3deg) scale(.975);
    transform-origin: 50% 100%;
    transition-duration: 620ms;
    transition-timing-function: cubic-bezier(.22,.8,.25,1);
  }
  .reveal-project.reveal-ready.is-visible { transform: perspective(1100px) translateY(0) rotateX(0) scale(1); }
  @media (prefers-reduced-motion: reduce) {
    .reveal-ready, .reveal-project.reveal-ready, .reveal-project.reveal-ready.is-visible {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
