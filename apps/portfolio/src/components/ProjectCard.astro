---
import "../styles/project-badges.css";
import "../styles/project-card.css";
interface Props {
  href: string;
  title: string;
  category: string;
  status?: "demo" | "client";
  lang?: "de" | "en" | "ru";
  preview: string;
  name: string;
  open: string;
}
const {
  href,
  title,
  category,
  preview,
  name,
  open,
  status = "demo",
  lang = "de",
} = Astro.props;
const statusLabel =
  status === "demo"
    ? "Demo"
    : lang === "en"
      ? "Client project"
      : lang === "ru"
        ? "Клиентский проект"
        : "Kundenprojekt";
---

<a
  class="project-card project-tile"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
>
  <div class="tile-preview">
    <img
      src={preview}
      alt={`${title} — ${category}`}
      width="1280"
      height="800"
      loading="lazy"
      decoding="async"
    />
    <span class={`project-badge project-badge--${status}`}>
      {statusLabel}
    </span>
  </div>
  <div class="tile-details">
    <p class="tile-category">{category}</p>
    <h3 class="tile-title">{name}</h3>
    <span class="tile-link">{open}</span>
  </div>
</a>
