---
import "../styles/project-badges.css";
import "../styles/project-card.css";
interface Props {
  href: string;
  title?: string;
  category: string;
  status?: "demo" | "client";
  lang?: "de" | "en" | "ru";
  preview: string;
  projectId: string;
  name: string;
  open: string;
}
const {
  href,
  category,
  preview,
  projectId,
  name,
  open,
  status = "demo",
  lang = "de",
} = Astro.props;
const statusLabel =
  status === "demo"
    ? "Demo"
    : lang === "en"
      ? "Client project"
      : lang === "ru"
        ? "Клиентский проект"
        : "Kundenprojekt";
---

<a
  class="project-card project-tile"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
>
  <div class="tile-preview">
    <div class="device-composition" aria-hidden="true">
      <div class="device device-desktop"><div class="browser-bar"><i></i><i></i><i></i></div><img src={preview} alt="" width="1280" height="800" loading="lazy" decoding="async" /></div>
      <div class="device device-tablet"><div class="browser-bar"><i></i></div><img src={`${import.meta.env.BASE_URL}previews/${projectId}-tablet.png`} alt="" width="768" height="1024" loading="lazy" decoding="async" /></div>
      <div class="device device-phone"><div class="phone-speaker"></div><img src={`${import.meta.env.BASE_URL}previews/${projectId}-mobile.png`} alt="" width="390" height="844" loading="lazy" decoding="async" /></div>
    </div>
    <span class={`project-badge project-badge--${status}`}>
      {statusLabel}
    </span>
  </div>
  <div class="tile-details">
    <p class="tile-category">{category}</p>
    <div class="tile-bottom">
      <h3 class="tile-title">{name}</h3>
      <span class="tile-link">{open}</span>
    </div>
  </div>
</a>
