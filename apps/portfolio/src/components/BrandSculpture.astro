---
import "../styles/brand.css";
interface Props { lang: "de" | "en" | "ru"; }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<div class="brand-sculpture" data-brand-sculpture aria-hidden="true">
  <img class="brand-fallback" src={`${base}images/hirda-mark.svg`} width="220" height="220" alt="" />
</div>
<script>
  const element = document.querySelector<HTMLElement>('[data-brand-sculpture]');
  if (element) {
    // Загружаем WebGL только рядом с видимой секцией. SVG остаётся запасным вариантом.
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const observer = new IntersectionObserver(async entries => {
      if (!entries.some(entry => entry.isIntersecting) || reduced.matches) return;
      observer.disconnect();
      try {
        const { mountSculpture } = await import('../scripts/brand-sculpture');
        mountSculpture(element);
      } catch { /* Ошибка WebGL или загрузки не скрывает SVG-логотип. */ }
    }, { rootMargin: '150px' });
    observer.observe(element);
  }
</script>
