---
import { projects, projectHref } from "../data/projects";
import BrandSculpture from "./BrandSculpture.astro";
import StudioHero from "./StudioHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "./ProjectCard.astro";
import Reveal from "./Reveal.astro";
import Services from "./Services.astro";
import SiteFooter from "./SiteFooter.astro";
import Pricing from "./Pricing.astro";

import { translations, type Language } from "../i18n/translations";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = translations[lang];
const openLabel = {
  de: "Website öffnen",
  ru: "Открыть сайт",
  en: "Open website",
}[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title={t.pageTitle} description={t.description} lang={lang}>
  <StudioHero lang={lang} />
  <main class="container" id="main">
    <section id="projects" class="projects">
      <p class="eyebrow">{t.projectsEyebrow}</p>

      <h2>{t.projectsTitle}</h2>

      <p class="section-description">{t.projectsDescription}</p>

      <div class="project-grid">
        {t.projects.map((project, index) => (
          <Reveal variant="project" delay={(index % 2) * 70}>
            <ProjectCard
              title={project.title}
              category={project.category}
              status={projects[project.id].status}
              lang={lang}
              preview={`${base}/previews/${project.id === "barbershop" ? "barbershop-2026.png" : `${project.id}.jpg`}`}
              name={projects[project.id].name}
              open={openLabel}
              href={projectHref(project.id)}
            />
          </Reveal>
        ))}
      </div>
    </section>
    <section id="about" class="about">
      <div class="about-copy"><p class="eyebrow">{lang === "en" ? "ABOUT ME" : "ÜBER MICH"}</p>
      <h2>{lang === "en" ? "Hi, I’m Artem." : "Hi, ich bin Artem."}</h2>
      <p class="section-description">{lang === "en"
        ? "I’ve been working in web development for seven years. I design and develop websites for independent professionals and small businesses — with thoughtful design and attention to detail."
        : "Seit sieben Jahren bin ich in der Webentwicklung tätig. Ich gestalte und entwickle Websites für Selbstständige und kleine Unternehmen — mit durchdachtem Design und einem Blick fürs Detail."}</p>
      <p class="section-description">{lang === "en"
        ? "What matters to me is that your website reflects who you are, clearly explains what you offer and works well on every screen."
        : "Mir ist wichtig, dass deine Website zu dir passt, dein Angebot verständlich macht und auf jedem Bildschirm gut funktioniert."}</p></div>
      <BrandSculpture lang={lang} />
    </section>
    <Services
      title={t.servicesTitle}
      description={t.servicesDescription}
      items={t.services}
    />
    <Pricing lang={lang} />
  </main>

  <SiteFooter lang={lang} />
</BaseLayout>

<style>
  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.13em;
    margin: 0 0 20px;
    color: #c9cfa8;
  }
  .about {
    padding: 55px 0;
    border-top: 1px solid #424649;
    scroll-margin-top: 25px;
  }
  .projects {
    padding: 76px 0 80px;
    scroll-margin-top: 25px;
  }
  h2 {
    font-size: clamp(34px, 5vw, 62px);
    line-height: 1.1;
    letter-spacing: -0.055em;
    font-weight: 500;
    margin: 0;
  }
  .section-description {
    max-width: 600px;
    color: #b9bdbd;
    font-size: 14px;
    line-height: 1.7;
    margin: 22px 0 40px;
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 42px 28px;
  }

  #services {
    scroll-margin-top: 30px;
  }
  @media (max-width: 700px) {
    .project-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .about {
      padding: 55px 0;
      border-top: 1px solid #424649;
      scroll-margin-top: 25px;
    }
    .projects {
      padding: 46px 0;
    }
  }
</style>
