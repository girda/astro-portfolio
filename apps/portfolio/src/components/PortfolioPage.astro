---
import PortfolioHero from "./PortfolioHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "./ProjectCard.astro";
import Reveal from "./Reveal.astro";
import Services from "./Services.astro";

import {
  languages,
  languagePath,
  translations,
  type Language,
} from "../i18n/translations";



interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = translations[lang];
const name = "HIRDA";
const brands = ['KANT', 'KLAR', 'WERKRAUM', 'STILL'];
const openLabel = {de:'Website öffnen',ru:'Открыть сайт',en:'Open website'}[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const demos = ['barbershop', 'cleaning', 'autoservice', 'nails'];
const demoHref = (index: number) => import.meta.env.PROD
  ? `${import.meta.env.BASE_URL.replace(/\/$/, '')}/demos/${demos[index]}/`
  : `http://localhost:${4322 + index}/`;

---

<BaseLayout title={t.pageTitle} description={t.description} lang={lang}>
  <header class="container navigation">
    <a class="logo" href={languagePath(lang)}>
      {name}<span>.</span>
    </a>

    <div class="nav-actions">
      <a class="projects-link" href="#projects">
        {t.navigation}
      </a>

      <nav class="languages" aria-label={t.languageLabel}>
        {
          languages.map((language) => (
            <a
              href={languagePath(language)}
              lang={language}
              hreflang={language}
              aria-current={language === lang ? "page" : undefined}
            >
              {language.toUpperCase()}
            </a>
          ))
        }
      </nav>
    </div>
  </header>

  <main class="container" id="main">
    <PortfolioHero lang={lang} headline={t.headline} eyebrow={t.eyebrow} introduction={t.introduction} button={t.button} />

    <section id="projects" class="projects">
      <p class="eyebrow">{t.projectsEyebrow}</p>

      <h2>{t.projectsTitle}</h2>

      <p class="section-description">
        {t.projectsDescription}
      </p>

      <div class="project-grid">
        {
          t.projects.map((project, index) => (
            <Reveal delay={index * 100}>
              <ProjectCard
                title={project.title}
                category={project.category}
                number={index + 1}
                status={"Demo"}
                preview={`${base}/previews/${demos[index]}.jpg`}
                name={brands[index]}
                open={openLabel}
                href={demoHref(index)}
              />
            </Reveal>
          ))
        }
      </div>
    </section>
    <div id="services"></div>
    <Services
      title={t.servicesTitle}
      description={t.servicesDescription}
      items={t.services}
    />

  </main>

  <footer class="container">
    © {new Date().getFullYear()}
    {name}. · Artem Hirda
  </footer>
</BaseLayout>

<style>
.navigation{display:flex;align-items:center;justify-content:space-between;gap:20px;padding-block:24px;border-bottom:1px solid #d9dbd2}.logo{font-size:28px;font-weight:800;letter-spacing:-.08em}.logo span{color:#7d9251}.nav-actions{display:flex;align-items:center;gap:32px}.projects-link{font-size:12px}.languages{display:flex;gap:3px}.languages a{display:grid;place-items:center;min-width:38px;min-height:38px;border-radius:50%;font-size:11px}.languages a[aria-current=page]{background:#20231e;color:#fff}.languages a:hover{background:#d9ff68;color:#20231e}.eyebrow{font-size:11px;letter-spacing:.13em;margin:0 0 20px;color:#6b7164}.projects{padding:76px 0 80px;scroll-margin-top:25px}h2{font-size:clamp(34px,5vw,62px);line-height:1.1;letter-spacing:-.055em;font-weight:500;margin:0}.section-description{max-width:600px;color:#686e61;font-size:14px;line-height:1.7;margin:22px 0 40px}.project-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:42px 28px}footer{padding-block:28px;border-top:1px solid #d9dbd2;font-size:12px;color:#686e61}#services{scroll-margin-top:30px}@media(max-width:700px){.navigation{padding-block:18px}.projects-link{display:none}.project-grid{grid-template-columns:1fr;gap:30px}.projects{padding:46px 0}.nav-actions{gap:12px}}
</style>
