---
import "../styles/interface-polish.css";
import BrandSculpture from "./BrandSculpture.astro";
import StudioHero from "./StudioHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectGallery from "./ProjectGallery.astro";
import PixelExperience from "./PixelExperience.astro";
import Services from "./Services.astro";
import SiteFooter from "./SiteFooter.astro";
import Contact from "./Contact.astro";
import Pricing from "./Pricing.astro";
import AIAssistantWidget from "./AIAssistantWidget.astro";

import { translations, type Language } from "../i18n/translations";

interface Props {
  lang: Language;
}

const ru = Astro.props.lang === 'ru';
const { lang } = Astro.props;
const t = translations[lang];
---

<BaseLayout title={t.pageTitle} description={t.description} lang={lang}>
  <StudioHero lang={lang} />
  <main class="container" id="main">
    <section id="projects" class="projects">
      <p class="eyebrow">{t.projectsEyebrow}</p>

      <h2>{t.projectsTitle}</h2>

      <p class="section-description">{t.projectsDescription}</p>

      <ProjectGallery lang={lang} />
    </section>
    <section id="about" class="about">
      <div class="about-copy"><p class="eyebrow">{lang === "en" ? "ABOUT ME" : ru ? "ОБО МНЕ" : "ÜBER MICH"}</p>
      <h2>{lang === "en" ? "Hi, I’m Artem." : ru ? "Привет, я Артём." : "Hi, ich bin Artem."}</h2>
      <p class="section-description">{lang === "en"
        ? "I’ve worked in web development for seven years. I help independent professionals and small businesses turn their ideas into websites people can use."
        : ru ? "Семь лет занимаюсь веб-разработкой. Помогаю небольшим компаниям и частным специалистам рассказать о себе и сделать сайт, которым удобно пользоваться." : "Seit sieben Jahren beschäftige ich mich mit Webentwicklung. Ich helfe Selbstständigen und kleinen Unternehmen dabei, aus einer Idee eine Website zu machen, die im Alltag funktioniert."}</p>
      <p class="section-description">{lang === "en"
        ? "We’ll work out what your customers need to know, agree on the design and build from there. You’ll see how things are going along the way."
        : ru ? "Сначала разберёмся, что нужно твоим клиентам. Потом согласуем дизайн и перейдём к разработке. По ходу работы ты будешь видеть результат и сможешь его поправить." : "Wir klären, was deine Kunden wissen müssen, stimmen das Design ab und setzen es um. Du siehst zwischendurch, wie es vorangeht, und kannst Rückmeldung geben."}</p></div>
      <BrandSculpture lang={lang} />
    </section>
    <Services lang={lang} />
    <PixelExperience lang={lang} />
    <Pricing lang={lang} />
    <Contact lang={lang} />
  </main>

  <SiteFooter lang={lang} />
  <AIAssistantWidget lang={lang} />
</BaseLayout>

<style>
  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.13em;
    margin: 0 0 20px;
    color: #c9cfa8;
  }
  .about {
    padding: 55px 0;
    border-top: 1px solid #424649;
    scroll-margin-top: 25px;
  }
  .projects {
    padding: 76px 0 80px;
    scroll-margin-top: 25px;
  }
  h2 {
    font-size: clamp(34px, 5vw, 62px);
    line-height: 1.1;
    letter-spacing: -0.055em;
    font-weight: 500;
    margin: 0;
  }
  .section-description {
    max-width: 600px;
    color: #b9bdbd;
    font-size: 14px;
    line-height: 1.7;
    margin: 22px 0 40px;
  }

  #services {
    scroll-margin-top: 30px;
  }
  @media (max-width: 700px) {
    .about {
      padding: 55px 0;
      border-top: 1px solid #424649;
      scroll-margin-top: 25px;
    }
    .projects {
      padding: 46px 0;
    }
  }
</style>
