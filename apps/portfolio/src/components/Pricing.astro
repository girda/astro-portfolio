---
import pricing from "../data/pricing.json";
interface Props { lang: string }
const ru = Astro.props.lang === 'ru';
const { lang } = Astro.props;
const en = lang === "en";
const rows = pricing[lang as keyof typeof pricing];
---
<section id="pricing" class="pricing" aria-labelledby="pricing-title">
  <p class="pricing-eyebrow">{en ? "PACKAGES & EXTRAS" : ru ? "ПАКЕТЫ И ВОЗМОЖНОСТИ" : "PAKETE & EXTRAS"}</p>
  <h2 id="pricing-title">{en ? "What will your website cost?" : ru ? "Сколько будет стоить сайт?" : "Was kostet deine Website?"}</h2>
  <p class="pricing-intro">{en ? "Here are a few starting points. Open a package to see what’s included — we’ll agree the final scope and price before we start." : ru ? "Здесь — несколько вариантов для начала. Открой пакет, посмотри состав, а точную стоимость и объём работы согласуем до старта." : "Hier findest du eine erste Orientierung. Öffne ein Paket und schau, was dazugehört. Umfang und Preis vereinbaren wir vor dem Start."}</p>
  <div class="pricing-list">
    {rows.map(([title, price, subtitle, description], i) => (
      <details class="price-item" data-price-item>
        <summary>
          <span class="price-label"><span class="price-title">{title}</span><span class="price-subtitle">{subtitle}</span></span>
          <span class="price-value">{/^(from|ab|от) /.test(price) ? <><span class="price-prefix">{en ? "from" : ru ? "от" : "ab"}</span><strong>{price.replace(/^(from|ab|от) /, "")}</strong></> : <strong class="price-text">{price}</strong>}</span>
          <svg class="accordion-chevron" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="price-content"><p>{description}</p></div>
      </details>
    ))}
  </div>
  <p class="pricing-note">{en ? "Starting prices depend on scope. You receive an individual quote before work begins. Domain, hosting, paid services and licences are charged separately." : ru ? "Указана начальная стоимость, итоговая цена зависит от объёма работы. До старта ты получишь индивидуальное предложение. Домен, хостинг, платные сервисы и лицензии оплачиваются отдельно." : "Die Einstiegspreise richten sich nach dem Umfang. Vor Beginn erhältst du ein individuelles Angebot. Domain, Hosting, kostenpflichtige Dienste und Lizenzen werden separat berechnet."}</p>
</section>
<script>
  // Одна анимация высоты на строку. Повторный клик продолжает движение с текущей высоты.
  document.querySelectorAll<HTMLDetailsElement>("[data-price-item]").forEach((item) => {
    const summary = item.querySelector("summary")!;
    const content = item.querySelector<HTMLElement>(".price-content")!;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    let animation: Animation | null = null;
    let expanded = item.open;
    const finish = () => {
      animation?.cancel(); animation = null;
      item.open = expanded;
      item.style.height = "";
      item.style.overflow = "";
      item.classList.toggle("is-expanded", expanded);
    };
    summary.addEventListener("click", (event) => {
      event.preventDefault();
      const start = item.getBoundingClientRect().height;
      expanded = !expanded;
      animation?.cancel(); animation = null;
      if (reduced.matches) { finish(); return; }
      item.style.height = `${start}px`;
      item.style.overflow = "hidden";
      item.open = true;
      item.classList.toggle("is-expanded", expanded);
      const border = 2;
      const end = summary.getBoundingClientRect().height + border + (expanded ? content.getBoundingClientRect().height : 0);
      const current = item.animate({ height: [`${start}px`, `${end}px`] }, { duration: 360, easing: "cubic-bezier(.22,.7,.3,1)", fill: "forwards" });
      animation = current;
      current.onfinish = () => { if (animation === current) finish(); };
    });
    reduced.addEventListener("change", () => { if (animation) finish(); });
    window.addEventListener("resize", () => { if (animation) finish(); });
  });
</script>
<style>
  .pricing { padding-block: 64px; }
  .pricing-eyebrow { color: #c9cfa8; font: 11px/1.5 var(--font-code); letter-spacing: .13em; margin: 0 0 16px; }
  h2 { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.15; margin: 0 0 16px; }
  .pricing-intro { color: #bdc4c0; max-width: 600px; margin: 0 0 32px; }
  .pricing-list { display: grid; gap: 10px; }
  .price-item { border: 1px solid #ffffff16; border-radius: 14px; background: linear-gradient(115deg, #ffffff05, color-mix(in srgb, var(--brand-accent) 2.75%, transparent)); box-shadow: 0 5px 18px #0000000c; transition: border-color .25s, background .25s; }
  .price-item.is-expanded { border-color: color-mix(in srgb, var(--brand-accent) 33.33%, transparent); background: linear-gradient(115deg, #ffffff06, color-mix(in srgb, var(--brand-accent) 5.10%, transparent)); }
  summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: minmax(0,1fr) minmax(150px,auto) 28px; gap: 40px; align-items: center; padding: 24px; border-radius: 14px; }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { outline: 2px solid #c1cfcc; outline-offset: 3px; }
  .price-label { display: grid; gap: 5px; min-width: 0; }
  .price-title { overflow-wrap: anywhere; hyphens: auto; }
  .price-title { font-size: clamp(17px,2vw,22px); font-weight: 600; }
  .price-subtitle { font-size: 13px; color: #b5bdb9; }
  .price-value { color: var(--brand-accent); font: 500 15px/1.4 var(--font-code); white-space: nowrap; }
  .price-content { padding: 0 24px 24px; }
  .price-content p { border-top: 1px solid #ffffff12; padding-top: 20px; margin: 0; max-width: 760px; color: #c3cac5; line-height: 1.75; }
  .pricing-note { max-width: 760px; color: #aeb6b2; font-size: 13px; line-height: 1.7; margin: 20px 0 0; }
  @media (hover:hover) { summary:hover .price-title { color: var(--brand-accent); } }
  @media (max-width:700px) {
    .pricing { padding-block: 40px; }
    summary { padding: 18px; gap: 8px 12px; grid-template-columns: minmax(0,1fr) auto 20px; }
    .price-label { grid-column: 1; }
    .price-value { grid-column: 2; grid-row: 1; }
    .price-content { padding: 0 18px 18px; }
  }

  #pricing .price-value { display: flex; justify-content: flex-end; align-items: baseline; gap: 8px; font-family: var(--font-body); text-align: right; }
  #pricing .price-value strong { font-size: var(--item-title-size); font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; }
  #pricing .price-value .price-text { font-size: var(--text-size); }
  #pricing .price-prefix { font-size: var(--text-size); font-weight: 400; color: #bdc4c0; }
  #pricing .price-subtitle { font-size: var(--text-size); font-family: var(--font-body); }
  #pricing .price-content p { font-size: var(--text-size); line-height: 1.75; }
  .price-item { overflow-anchor: none; }
  @media (max-width: 420px) {
    summary { gap: 12px; padding: 16px 12px; }
    #pricing .price-value { flex-direction: column; align-items: flex-end; gap: 2px; }
    #pricing .price-subtitle { display: none; }
  }
</style>

<style> .accordion-chevron { flex-shrink:0; color:var(--brand-accent); transition:transform .28s ease; } .is-expanded .accordion-chevron { transform:rotate(180deg); } summary { -webkit-tap-highlight-color:transparent; } @media(prefers-reduced-motion:reduce) { .accordion-chevron { transition:none; } } </style>
