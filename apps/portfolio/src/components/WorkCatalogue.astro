---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGallery from './ProjectGallery.astro';
import LanguageSelector from './LanguageSelector.astro';
import SiteFooter from './SiteFooter.astro';
import { galleryCopy } from '../data/project-gallery';
import { languagePath, type Language } from '../i18n/translations';
import '../styles/interface-polish.css';
interface Props { lang: Language }
const {lang}=Astro.props,copy=galleryCopy[lang],home=languagePath(lang);
---
<BaseLayout lang={lang} title={`${lang==='ru'?'Каталог работ':lang==='de'?'Arbeiten':'Work'} · HIRDA`} description={copy.intro}>
 <header class="work-header container" id="top"><a class="work-logo" href={home} aria-label="HIRDA"><span>[</span>H<span>]</span>IRDA</a><a class="home-link" href={home}>{copy.back}</a><LanguageSelector lang={lang} section="work" /></header>
 <main class="container work-main" id="main"><section class="work-intro"><div><p class="eyebrow">HIRDA / {lang==='de'?'ARBEITEN':lang==='ru'?'КАТАЛОГ РАБОТ':'WORK'}</p><h1>{copy.title}</h1><p class="work-description">{copy.intro}</p></div><div class="catalogue-symbol" aria-hidden="true"><span>[</span><div><i></i><i></i><i></i><i></i></div><span>]</span></div></section><ProjectGallery lang={lang} catalogue/><aside class="work-invitation"><p>{lang==='ru'?'Нашёл идею для своего сайта?':lang==='de'?'Eine Idee für deine Website gefunden?':'Found an idea for your website?'}</p><a href={`${home}#contact`}>{lang==='ru'?'Давай обсудим':lang==='de'?'Lass uns darüber sprechen':'Let’s talk about it'}</a></aside></main><SiteFooter lang={lang} homeHref={home}/>
</BaseLayout>
<style>
.work-header{display:flex;align-items:center;gap:28px;padding-block:28px;border-bottom:1px solid #ffffff1c}.work-logo{font:650 25px/1.2 var(--font-body);letter-spacing:.08em}.work-logo span{color:var(--brand-accent)}.home-link{margin-left:auto;font-size:13px;color:#bac5be;min-height:44px;display:flex;align-items:center}.work-main{padding-bottom:48px}.work-intro{display:grid;grid-template-columns:1fr 280px;gap:48px;align-items:center;padding:84px 0 48px}.eyebrow{color:#c9cfa8;font:11px var(--font-body);letter-spacing:.15em;margin:0 0 24px}h1{font-size:clamp(38px,5vw,74px);font-weight:500;line-height:1.06;letter-spacing:-.055em;max-width:14ch;margin:0}.work-description{font-size:17px;line-height:1.8;color:#b9c4bc;max-width:54ch;margin:26px 0 0}.catalogue-symbol{display:flex;align-items:center;justify-content:center;gap:12px;transform:rotate(-7deg);color:var(--brand-accent);font:200 160px/.9 var(--font-body)}.catalogue-symbol>div{display:grid;grid-template-columns:1fr 1fr;gap:8px;width:120px;transform:rotate(7deg)}.catalogue-symbol i{height:50px;background:linear-gradient(140deg,#c0cdb333,#b8866122);border:1px solid #c7d6bf44;border-radius:4px}.catalogue-symbol i:nth-child(2){transform:translateY(-10px)}.catalogue-symbol i:nth-child(3){transform:translateY(10px)}.work-invitation{margin-top:80px;padding:36px 0;border-block:1px solid #ffffff20;display:flex;justify-content:space-between;align-items:center;gap:24px}.work-invitation p{font-size:clamp(20px,3vw,30px);letter-spacing:-.025em;margin:0}.work-invitation a{background:var(--brand-accent);padding:14px 22px;border-radius:6px;min-height:48px;font-size:14px;text-align:center;transition:background .2s}.work-invitation a:hover{background:#805f4b}.home-link:hover{color:#fff}@media(max-width:700px){.work-header{gap:14px;padding-block:18px}.work-logo{font-size:20px}.home-link{font-size:12px}.work-intro{grid-template-columns:1fr;gap:20px;padding:52px 0 20px}.catalogue-symbol{display:none}.work-description{font-size:15px}.work-invitation{margin-top:48px;flex-direction:column;align-items:stretch}.work-invitation a{width:100%}}
</style>
