---
import Reveal from './Reveal.astro';
import DeviceIcon from './DeviceIcon.astro';
interface Props {lang: string}
const ru = Astro.props.lang === 'ru';
const en=Astro.props.lang==='en';
const items=en?[
 {icon:'panels-top-left',type:'01 / WEBSITES',title:'Make it easy to choose you.',text:'A website that explains your offer clearly and makes it easy to contact you. New websites, redesigns and CMS to manage your own content.',link:'Discuss your website'},
 {icon:'wrench',type:'02 / WEB-APPS',title:'Less routine. More time for work.',text:'Digital forms, clear catalogues and tailored features for everyday work. Built around what your business actually needs.',link:'Explore your idea'},
 {icon:'message-circle',type:'03 / AI AGENTS',title:'Help customers find an answer.',text:'An assistant that knows your services, helps visitors find their next step and prepares enquiries for your review.',link:'Meet Pixel'}
]:ru?[{"icon": "panels-top-left", "type": "01 / САЙТЫ", "title": "Покажи, чем ты полезен.", "text": "Сайт, на котором клиенты понимают твоё предложение и легко связываются с тобой. Новый проект, редизайн или CMS для самостоятельного обновления контента.", "link": "Обсудить сайт"}, {"icon": "wrench", "type": "02 / ВЕБ-ПРИЛОЖЕНИЯ", "title": "Меньше рутины в работе.", "text": "Цифровые формы, понятные каталоги и функции для повседневной работы. Разработка под реальные задачи твоего бизнеса.", "link": "Обсудить идею"}, {"icon": "message-circle", "type": "03 / ИИ-АГЕНТЫ", "title": "Помоги клиенту разобраться.", "text": "Помощник, который знает твои услуги, подсказывает клиенту следующий шаг и подготавливает заявку для проверки.", "link": "Познакомиться с Пикселем"}]:[
 {icon:'panels-top-left',type:'01 / WEBSITES',title:'Zeig, was du anbietest.',text:'Eine Website, auf der Kunden dein Angebot verstehen und schnell Kontakt aufnehmen. Als neue Website, Redesign oder mit CMS für deine eigenen Inhalte.',link:'Website besprechen'},
 {icon:'wrench',type:'02 / WEB-APPS',title:'Weniger Handarbeit im Alltag.',text:'Digitale Formulare, übersichtliche Kataloge und passende Funktionen für deinen Alltag. Entwickelt für das, was dein Business wirklich braucht.',link:'Idee prüfen'},
 {icon:'message-circle',type:'03 / KI-AGENTEN',title:'Kundenfragen leichter beantworten.',text:'Ein Assistent, der dein Angebot kennt, Kunden beim nächsten Schritt unterstützt und Anfragen zur Prüfung vorbereitet.',link:'Pixel kennenlernen'}
];
---
<section id="services" class="services" aria-labelledby="services-title">
 <Reveal><div class="section-heading"><div><p class="eyebrow">{en?'WHAT YOU GAIN': ru ? "ЧТО ТЫ ПОЛУЧИШЬ" : "WAS DU DAVON HAST"}</p><h2 id="services-title">{en?'What can I help you with?': ru ? "С чем я могу помочь?" : "Wobei kann ich dir helfen?"}</h2></div><p>{en?'A new website, a useful tool or an assistant for customer questions. We’ll start with what your business needs now.': ru ? "Новый сайт, удобный инструмент или помощник для вопросов клиентов. Начнём с того, что нужно твоему бизнесу сейчас." : "Eine neue Website, ein nützliches Tool oder Hilfe bei Kundenfragen. Wir fangen bei dem an, was du gerade brauchst."}</p></div></Reveal>
 <div class="service-benefits">{items.map((item,index)=><Reveal delay={index*60}><article class="benefit-card"><div class="benefit-top"><span>{item.type}</span><DeviceIcon name={item.icon as 'panels-top-left' | 'wrench' | 'message-circle'}/></div><h3>{item.title}</h3><p>{item.text}</p><a href={index===2?'#pixel':'#contact'}>{item.link}<DeviceIcon name="arrow-right"/></a></article></Reveal>)}</div>
</section>
<style>
.services{padding-block:var(--section-space);border-top:1px solid #ffffff20}.section-heading{display:grid;grid-template-columns:1.1fr 1fr;gap:48px;align-items:end;margin-bottom:32px}.eyebrow{font-size:11px;letter-spacing:.12em;color:#c9cfa8;margin:0 0 16px}h2{margin:0;font-size:clamp(32px,4vw,48px);line-height:1.14;letter-spacing:-.04em;max-width:16ch}.section-heading>p{color:#bfc9c3;max-width:390px;margin:0;font-size:16px;line-height:1.7}.service-benefits{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.service-benefits :global(.reveal){height:100%}.benefit-card{display:flex;flex-direction:column;height:100%;border:1px solid #ffffff22;border-radius:10px;padding:28px;background:#ffffff03}.benefit-top{display:flex;justify-content:space-between;align-items:center;gap:12px;color:#d59a74;font-size:11px;letter-spacing:.06em}.benefit-top :global(svg){width:23px;height:23px}h3{font-size:25px;line-height:1.25;letter-spacing:-.035em;margin:30px 0 18px}.benefit-card>p{font-size:15px;line-height:1.75;color:#bfc9c3;margin:0 0 28px}.benefit-card>a{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:14px;color:#e4b08e;margin-top:auto;min-height:44px;text-decoration:none}.benefit-card>a:focus-visible{outline:2px solid #c1cfcc;outline-offset:5px}
@media(max-width:1000px){.service-benefits{grid-template-columns:1fr}.benefit-card{padding:26px}h3{margin-top:22px;max-width:30ch}.section-heading{gap:24px}}@media(max-width:700px){.section-heading{grid-template-columns:1fr;gap:20px}h2{max-width:19ch}.benefit-card{padding:24px}.service-benefits{gap:16px}}
</style>
