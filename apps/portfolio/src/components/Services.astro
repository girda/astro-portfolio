---
import Reveal from "./Reveal.astro";

interface Props {
  title: string;
  description: string;
  items: {
    title: string;
    description: string;
  }[];
}

const { title, description, items } = Astro.props;
const icons = [
  "M3 5h18v14H3z M3 9h18 M7 7h.01 M10 7h.01",
  "m5 17-1 4 4-1L20 8l-3-3L5 17 M14 8l3 3",
  "M12 3 4 6v6c0 4 8 9 8 9s8-5 8-9V6z M8 12l3 3 5-6",
  "M4 4h16v16H4z M4 9h16 M9 9v11 M13 13h4 M13 16h4",
  "m8 6-6 6 6 6 M16 6l6 6-6 6 M14 3l-4 18",
];
---

<section id="services" class="services" aria-labelledby="services-title">
  <Reveal>
    <div class="section-heading">
      <h2 id="services-title">{title}</h2>
      <p>{description}</p>
    </div>
  </Reveal>

  <div class="service-list">
    {items.map((item, index) => (
      <Reveal delay={index * 80}>
        <article class="service">
          <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[index % icons.length]} /></svg>

          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      </Reveal>
    ))}
  </div>
</section>

<style>
  .services {
    padding-block: 64px 96px;
    border-top: 1px solid #424649;
  }

  .section-heading {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
    margin-bottom: 48px;
  }

  h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    overflow-wrap: break-word;
  }

  .section-heading p {
    max-width: 460px;
    margin: 0;
    color: #b9bdbd;
    font-size: 1.125rem;
  }

  .service {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 32px;
    align-items: start;
    padding-block: 32px;
    border-bottom: 1px solid #424649;
  }

  .service-list :global(> :last-child) .service {
    border-bottom: 0;
  }

  .service-icon {
    width: 24px; height: 24px; color: var(--brand-accent);
    margin-top: calc((var(--item-title-size) * 1.3 - 24px) / 2);
  }

  .number {
    color: var(--brand-accent);
    font-size: 0.875rem;
  }

  h3 {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.3;
    overflow-wrap: break-word;
  }

  .service p {
    margin: 0;
    color: #b9bdbd;
  }

  @media (max-width: 700px) {
    .section-heading {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 24px;
    }

    .service {
      grid-template-columns: 32px minmax(0, 1fr);
      gap: 12px 16px;
    }

    .service p {
      grid-column: 2;
    }
  }
</style>
