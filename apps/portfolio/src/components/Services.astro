---
import Reveal from "./Reveal.astro";

interface Props {
  title: string;
  description: string;
  items: {
    title: string;
    description: string;
  }[];
}

const { title, description, items } = Astro.props;
---

<section class="services" aria-labelledby="services-title">
  <Reveal>
    <div class="section-heading">
      <h2 id="services-title">{title}</h2>
      <p>{description}</p>
    </div>
  </Reveal>

  <div class="service-list">
    {
      items.map((item, index) => (
        <Reveal delay={index * 80}>
          <article class="service">
            <span class="number" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>

            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        </Reveal>
      ))
    }
  </div>
</section>

<style>
  .services {
    padding-block: 64px 96px;
    border-top: 1px solid #2b2d35;
  }

  .section-heading {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
    margin-bottom: 48px;
  }

  h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    overflow-wrap: break-word;
  }

  .section-heading p {
    max-width: 460px;
    margin: 0;
    color: #b9bbc6;
    font-size: 1.125rem;
  }

  .service {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 32px;
    align-items: baseline;
    padding-block: 32px;
    border-bottom: 1px solid #2b2d35;
  }

  .number {
    color: #8da7ff;
    font-size: 0.875rem;
  }

  h3 {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.3;
    overflow-wrap: break-word;
  }

  .service p {
    margin: 0;
    color: #b9bbc6;
  }

  @media (max-width: 700px) {
    .section-heading {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 24px;
    }

    .service {
      grid-template-columns: 32px minmax(0, 1fr);
      gap: 12px 16px;
    }

    .service p {
      grid-column: 2;
    }
  }
</style>