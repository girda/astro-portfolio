---
import {pixelShowcase} from '../data/pixel-showcase';
import Icon from './DeviceIcon.astro';
interface Props {lang:string}
const lang=Astro.props.lang==='en'?'en':Astro.props.lang==='ru'?'ru':'de';
const t=pixelShowcase.copy[lang];
const examples=pixelShowcase.cases[lang];
const base=import.meta.env.BASE_URL;
---
<section id="pixel" class="pixel-experience" aria-labelledby="pixel-title">
  <div class="pixel-intro">
    <p class="eyebrow">{t.eyebrow}</p><h2 id="pixel-title">{t.headline}</h2><p>{t.intro}</p>
    <ul class="pixel-benefits">{t.benefits.map(text=><li><Icon name="check"/><span>{text}</span></li>)}</ul>
    <a class="pixel-business" href="#contact">{t.business}</a><small class="pixel-intro-note">{t.introNote}</small>
  </div>
  <div class="pixel-example" data-pixel-examples>
    <div class="pixel-example-head"><img src={`${base}ai/robot-cat.webp`} width="80" height="80" alt="" loading="lazy"/><div><strong>Pixel</strong><span>{t.subtitle}</span></div><small class="pixel-mark">{t.mark}</small></div>
    <div class="pixel-example-actions" role="group" aria-label={t.subtitle}>{examples.map((item,i)=><button type="button" data-pixel-example={item.id} aria-pressed={i===0?'true':'false'}>{item.name}</button>)}</div>
    <p class="pixel-label">{t.label}</p>
    {examples.map((item,i)=><div data-pixel-case={item.id} hidden={i!==0}>
      <div class="pixel-thread">{item.messages.map(([kind,text])=><div class:list={['pixel-message',kind]}><span>{kind==='customer'?t.customer:t.assistant}</span><p>{text}</p></div>)}</div>
      <div class="pixel-result"><span><Icon name="shield-check"/>{t.result}</span><p>{item.result}</p></div><p class="pixel-value">{item.benefit}</p>
    </div>)}
    <button type="button" class="pixel-demo-start" data-open-agent data-pixel-scenario="cafe" hidden>{t.demo}</button>
    <p class="pixel-example-note">{t.note}</p>
  </div>
  <div class="pixel-capabilities"><h3>{t.capTitle}</h3><p class="pixel-cap-note">{t.capNote}</p><div class="pixel-cap-grid">{t.capabilities.map(([icon,title,text])=><article><Icon name={icon}/><h4>{title}</h4><p>{text}</p></article>)}</div></div>
</section>
<script>
import {onPageReady} from '../../../../packages/ui/page-lifecycle';
onPageReady(()=>{
 const events=new AbortController();
 document.querySelectorAll('[data-pixel-examples]').forEach(root=>{
  const launch=root.querySelector<HTMLElement>('[data-pixel-scenario]');
  root.querySelectorAll<HTMLButtonElement>('[data-pixel-example]').forEach(button=>button.addEventListener('click',()=>{
   const selected=button.dataset.pixelExample;
   root.querySelectorAll('[data-pixel-example]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));
   root.querySelectorAll<HTMLElement>('[data-pixel-case]').forEach(panel=>panel.hidden=panel.dataset.pixelCase!==selected);
   if(launch) launch.dataset.pixelScenario=selected;
  },{signal:events.signal}));
 });
 return()=>events.abort();
});
</script>
<style>
.pixel-experience{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:64px;align-items:center;padding-block:var(--section-space);border-top:1px solid #ffffff20}.eyebrow{color:#c9cfa8;font-size:11px;letter-spacing:.1em;margin:0 0 20px}h2{font-size:clamp(32px,4vw,48px);line-height:1.15;letter-spacing:-.04em;margin:0;max-width:18ch;white-space:pre-line}.pixel-intro>p:not(.eyebrow){color:#bfc9c3;line-height:1.75;margin:24px 0;max-width:45ch}.pixel-benefits{list-style:none;padding:0;margin:28px 0;display:grid;gap:14px;color:#dce4df;font-size:14px}.pixel-benefits li{display:flex;gap:14px;align-items:center}.pixel-benefits :global(svg){color:#c9cfa8;flex-shrink:0}.pixel-business,.pixel-demo-start{display:inline-flex;align-items:center;justify-content:center;text-align:center;min-height:48px;border:1px solid #ffffff30;border-radius:6px;color:white;padding:12px 20px;font:inherit;font-size:14px;cursor:pointer;text-decoration:none;transition:background .2s,border-color .2s}.pixel-business{background:transparent}.pixel-business:hover{background:#ffffff09;border-color:#c9cfa8}.pixel-intro-note{display:block;color:#aebcb5;font-size:12px;line-height:1.75;max-width:42ch;margin-top:18px}.pixel-demo-start{background:var(--brand-accent);border-color:transparent;width:100%;font-weight:600}.pixel-demo-start:hover{background:var(--brand-accent-hover,#a6502b)}[hidden]{display:none!important}.pixel-example{padding:24px;border:1px solid #ffffff24;border-radius:12px;background:#26312f;min-width:0}.pixel-example-head{display:flex;gap:12px;align-items:center}.pixel-example-head img{width:80px;height:80px;object-fit:contain}.pixel-example-head strong{font-size:18px;font-weight:500;display:block}.pixel-example-head span{display:block;color:#bfc9c3;font-size:12px;margin-top:4px}.pixel-mark{margin-left:auto;padding:4px 8px;border:1px solid #c9cfa840;color:#c9cfa8;font-size:10px;letter-spacing:.08em;border-radius:3px}.pixel-example-actions{display:flex;gap:8px;flex-wrap:wrap;margin:24px 0 20px;padding-bottom:20px;border-bottom:1px solid #ffffff20}.pixel-example-actions button{border:1px solid #ffffff25;color:#dce4df;background:transparent;border-radius:5px;font:inherit;font-size:12px;min-height:44px;padding:10px 12px;cursor:pointer;transition:background .2s,border-color .2s}.pixel-example-actions button:hover{background:#ffffff09}.pixel-example-actions button[aria-pressed=true]{background:#ffffff0d;border-color:#b39c7a}.pixel-label{color:#aebcb5;font-size:10px;letter-spacing:.08em;margin:0 0 16px}.pixel-thread{display:grid;gap:10px}.pixel-message{padding:12px 14px;border:1px solid #ffffff09;background:#ffffff05;border-radius:8px;font-size:14px;line-height:1.65;max-width:100%;width:fit-content}.pixel-message.customer{justify-self:end;max-width:92%}.pixel-message.assistant{background:#ffffff09}.pixel-message>span{display:block;font-size:10px;color:#c9cfa8;letter-spacing:.03em}.pixel-message.customer>span{color:#bfc9c3}.pixel-message p{margin:4px 0 0}.pixel-result{padding:16px;background:#b85c3210;border:1px solid #b39c7a40;border-radius:6px;margin-top:18px}.pixel-result>span{display:flex;align-items:center;gap:10px;font-size:10px;letter-spacing:.08em;color:#efb98e}.pixel-result p{margin:10px 0 0;font-size:14px;line-height:1.7}.pixel-value{font-size:12px;color:#bfc9c3;line-height:1.7;margin:14px 0 18px}.pixel-example-note{color:#aebcb5;font-size:11px;line-height:1.6;margin:12px 0 0}.pixel-business:focus-visible,.pixel-demo-start:focus-visible,.pixel-example-actions button:focus-visible{outline:2px solid #c1cfcc;outline-offset:4px}@media(max-width:900px){.pixel-experience{grid-template-columns:1fr;gap:32px}}@media(max-width:600px){.pixel-example{padding:16px}.pixel-example-actions button{flex:1;padding:10px 8px}.pixel-example-head span{max-width:22ch}.pixel-message{font-size:13px}.pixel-result{padding:14px}.pixel-result p{font-size:13px}}
#pixel .pixel-label{font:400 10px/1.6 var(--font-body);letter-spacing:.08em}#pixel .eyebrow{font:500 11px/1.6 var(--font-code)}#pixel .pixel-message p{font:inherit;margin:4px 0 0}#pixel .pixel-result p{font:400 14px/1.7 var(--font-body)}#pixel .pixel-value{font:400 12px/1.7 var(--font-body)}#pixel .pixel-example-note,#pixel .pixel-cap-note{font:400 12px/1.7 var(--font-body)}.pixel-capabilities{grid-column:1/-1;border-top:1px solid #ffffff20;padding-top:32px}.pixel-capabilities h3{margin:0 0 12px}.pixel-cap-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;margin-top:28px}.pixel-cap-grid article{border-left:1px solid #ffffff25;padding-left:20px}.pixel-cap-grid :global(svg){color:#efb98e;width:24px;height:24px}.pixel-cap-grid h4{font-size:15px;font-weight:500;margin:14px 0 10px}#pixel .pixel-cap-grid p{font:400 13px/1.75 var(--font-body);color:#bfc9c3;margin:0}@media(max-width:1024px){.pixel-cap-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.pixel-example-head img{width:64px;height:64px}.pixel-cap-grid{grid-template-columns:1fr;gap:24px}#pixel .pixel-result p{font-size:13px}}
</style>
