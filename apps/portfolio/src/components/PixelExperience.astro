---
interface Props {lang:string}
const ru = Astro.props.lang === 'ru';
const en=Astro.props.lang==='en';
const base=import.meta.env.BASE_URL;
const examples=en?[
 ['Prepare enquiries','I ask for the details that matter to your business and prepare an enquiry. Your visitor checks it before confirming.'],
 ['Explain your offer','I help compare suitable options using the information you provide. If something is unclear, I ask rather than invent an answer.'],
 ['Prepare appointments','I clarify what the customer needs and guide them to your booking process. Connecting a calendar is a separate integration.']
]:ru?[["Готовить заявки", "Я уточняю важные для твоего бизнеса детали и готовлю заявку. Посетитель проверяет её перед подтверждением."], ["Объяснять предложения", "Я помогаю сравнить подходящие варианты по предоставленной информации. Если что-то непонятно, уточняю, а не придумываю ответ."], ["Помогать с записью", "Я выясняю задачу клиента и направляю его к нужному способу записи. Подключение календаря — отдельная интеграция."]]:[
 ['Anfragen vorbereiten','Ich frage die Angaben ab, die für dein Business wichtig sind, und bereite eine Anfrage vor. Dein Besucher prüft sie vor der Bestätigung.'],
 ['Angebote erklären','Ich helfe beim Vergleich passender Angebote auf Basis deiner Informationen. Wenn etwas unklar ist, frage ich nach, statt eine Antwort zu erfinden.'],
 ['Termine vorbereiten','Ich kläre, was dein Kunde benötigt, und leite zum passenden Buchungsweg weiter. Die Kalenderanbindung ist eine eigene Integration.']
];
---
<section id="pixel" class="pixel-experience" aria-labelledby="pixel-title"><div class="pixel-intro"><p class="eyebrow">Pixel · {en?'Artem’s AI assistant': ru ? "ИИ-помощник Артёма" : "Artems KI-Assistent"}</p><h2 id="pixel-title">{en?'A small preview. Of bigger possibilities.': ru ? "Небольшое знакомство. Большие возможности." : "Ein kleiner Vorgeschmack. Auf große Möglichkeiten."}</h2><p>{en?'See how an assistant could support your business. Explore an example or start a conversation with Pixel.': ru ? "Посмотри, как ИИ-помощник может поддержать твой бизнес. Выбери пример или пообщайся с Пикселем." : "So könnte ein Assistent auch dein Business unterstützen. Entdecke ein Beispiel oder starte ein Gespräch mit Pixel."}</p><button class="pixel-demo-start" type="button" data-open-agent hidden>{en?'Try Pixel live': ru ? "Поговорить с Пикселем" : "Pixel live ausprobieren"}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></button></div><div class="pixel-example" data-pixel-examples><div class="pixel-example-head"><img src={`${base}ai/face-default.webp`} width="80" height="80" alt="" loading="lazy"/><div><strong>Pixel</strong><span>{en?'Examples of possible uses': ru ? "Примеры задач для помощника" : "Beispiele möglicher Aufgaben"}</span></div></div><div class="pixel-example-actions" role="group" aria-label={en?'Choose an example': ru ? "Выбрать пример" : "Beispiel auswählen"}>{examples.map(([label,text],i)=><button type="button" data-pixel-example={text} aria-pressed={i===0?'true':'false'}>{label}</button>)}</div><p class="pixel-example-message" data-pixel-example-output aria-live="polite">{examples[0][1]}</p><p class="pixel-example-note">{en?'Illustrative examples. The live demo opens in the chat.': ru ? "Это примеры возможностей. Живое демо открывается в чате." : "Illustrative Beispiele. Die Live-Demo öffnet sich im Chat."}</p></div></section>
<script>
import {onPageReady} from '../../../../packages/ui/page-lifecycle';
onPageReady(()=>{const events=new AbortController();for(const root of document.querySelectorAll('[data-pixel-examples]')){const output=root.querySelector('[data-pixel-example-output]');root.querySelectorAll<HTMLButtonElement>('[data-pixel-example]').forEach(button=>button.addEventListener('click',()=>{if(output)output.textContent=button.dataset.pixelExample??'';root.querySelectorAll('[data-pixel-example]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));},{signal:events.signal}));}return()=>events.abort();});
</script>
<style>
.pixel-experience{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;padding-block:var(--section-space);border-top:1px solid #ffffff20}.eyebrow{color:#c9cfa8;font-size:11px;letter-spacing:.1em;margin:0 0 16px}h2{font-size:clamp(32px,4vw,48px);line-height:1.15;letter-spacing:-.04em;margin:0;max-width:18ch}.pixel-intro>p:not(.eyebrow){color:#bfc9c3;line-height:1.75;margin:24px 0;max-width:45ch}.pixel-demo-start{display:inline-flex;align-items:center;gap:20px;min-height:48px;border:0;border-radius:6px;background:var(--brand-accent);color:white;padding:14px 20px;font:inherit;font-size:14px;font-weight:600;cursor:pointer}.pixel-demo-start[hidden]{display:none}.pixel-example{padding:28px;border:1px solid #ffffff24;border-radius:12px;background:#26312f}.pixel-example-head{display:flex;gap:14px;align-items:center;padding-bottom:20px;border-bottom:1px solid #ffffff20}.pixel-example-head img{width:56px;height:56px;object-fit:contain}.pixel-example-head strong{font-size:18px;font-weight:500;display:block}.pixel-example-head span{display:block;color:#aebcb5;font-size:12px;margin-top:4px}.pixel-example-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:22px}.pixel-example-actions button{border:1px solid #ffffff25;color:#dce4df;background:transparent;border-radius:5px;font:inherit;font-size:12px;min-height:44px;padding:10px 12px;cursor:pointer}.pixel-example-actions button[aria-pressed=true]{background:#ffffff0d;border-color:#b39c7a}.pixel-example-message{color:#dce4df;font-size:16px;line-height:1.8;min-height:8em;margin:24px 0}.pixel-example-note{color:#9eafa5;font-size:11px;line-height:1.6;margin:0}.pixel-demo-start:focus-visible,.pixel-example-actions button:focus-visible{outline:2px solid #c1cfcc;outline-offset:4px}@media(max-width:900px){.pixel-experience{grid-template-columns:1fr;gap:28px}.pixel-example{padding:24px}.pixel-example-message{min-height:0}}
</style>
