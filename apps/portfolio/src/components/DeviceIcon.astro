---
import paths from "../../../../packages/ui/icons.json";
interface Props {
  name: keyof typeof paths;
}
const { name } = Astro.props;
---

<svg
  class="device-icon"
  width="16"
  height="16"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
