---
import { heroCopy } from "../data/hero";
import MenuIcon from "./MenuIcon.astro";
import "../styles/studio-hero.css";
import "../styles/hero-refinement.css";
import "../styles/navigation-panel.css";
import "../styles/mobile-viewport.css";
import "../styles/portfolio-motion.css";
import LanguageSelector from "./LanguageSelector.astro";
import { languagePath } from "../i18n/translations";
interface Props {
  lang: "de" | "ru" | "en";
}
const ru = Astro.props.lang === 'ru';
const { lang } = Astro.props;
const t = heroCopy[lang];
const animatedLines = t.lines.map((text, index) => ({
  text,
  offset: t.lines.slice(0, index).join("").length,
}));
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section id="top" class="studio-hero" aria-labelledby="hero-title" data-studio>
  <div class="art-window">
    <div class="art-plane">
      <picture>
        <source
          media="(max-width: 599px)"
          srcset={`${base}/images/studio-mobile-sharp.png`}
        />
        <img
          class="studio-image"
          src={`${base}/images/studio-sharp.png`}
          width="1586"
          height="992"
          alt=""
          fetchpriority="high"
        />
      </picture>
    </div>
  </div>
  <header class="hero-nav container">
    <a class="wordmark" href={languagePath(lang)} aria-label="HIRDA">
      <span class="wordmark-name" aria-hidden="true"><span class="logo-h"><span class="wordmark-bracket">[</span>H<span class="wordmark-bracket">]</span></span><span class="logo-rest">IRDA</span></span>
    </a>
    <nav class="desktop-nav" aria-label={lang === "ru" ? "Навигация" : "Navigation"}>
      <a href={`${languagePath(lang)}arbeiten/`}>{lang==='ru'?'Каталог работ':lang==='en'?'All work':'Arbeiten'}</a>
      <a href="#about">{t.about}</a>
      <a href="#contact">{lang === "en" ? "Contact" : ru ? "Контакты" : "Kontakt"}</a>
    </nav>
    <LanguageSelector lang={lang} />
    <details class="mobile-menu">
      <summary aria-label={lang === "en" ? "Open menu" : ru ? "Открыть меню" : "Menü öffnen"}>
        <span class="menu-stroke"></span>
        <span class="menu-stroke"></span>
      </summary>
      <nav
        class="menu-panel"
        aria-label={lang === "en" ? "Main navigation" : ru ? "Основная навигация" : "Hauptnavigation"}
      >
        <div class="menu-caption">HIRDA / NAVIGATION</div>
        <div class="menu-links">
          <a href="#top"><MenuIcon name="home" /><span class="menu-label">{lang === "en" ? "Home" : ru ? "Главная" : "Start"}</span></a>
          <a href={`${languagePath(lang)}arbeiten/`}><MenuIcon name="projects" /><span class="menu-label">{t.work}</span></a>
          <a href="#about"><MenuIcon name="about" /><span class="menu-label">{t.about}</span></a>
          <a href="#services"><MenuIcon name="services" /><span class="menu-label">{lang === "en" ? "Services" : ru ? "Услуги" : "Leistungen"}</span></a>
          <a href="#pricing"><MenuIcon name="pricing" /><span class="menu-label">{lang === "en" ? "Pricing & maintenance" : ru ? "Цены и поддержка" : "Preise & Betreuung"}</span></a>
        </div>
          <a class="menu-contact" href="#contact"><MenuIcon name="contact" /><span>{lang === "en" ? "Let’s talk" : ru ? "Обсудим проект" : "Lass uns sprechen"}</span></a>
        <div class="menu-bottom">
          <span>{t.eyebrow}</span>
        </div>
      </nav>
    </details>
  </header>
  <div class="hero-copy container">
    <p class="hero-eyebrow">{t.eyebrow}</p>
    <h1 id="hero-title" aria-label={t.lines.join(" ")}>
      {animatedLines.map(({ text: line, offset }, i) => (
        <span
          class:list={["line", { accent: i > 1 }]}
          style={`--delay:${i * 100}ms`}
        >
          {Array.from(line).map((letter, j) => (
            <span
              class="typed-letter"
              aria-hidden="true"
              style={`--type-delay:${500 + (offset + j) * 60}ms`}
            >
              {letter === " " ? "\u00a0" : letter}
            </span>
          ))}
        </span>
      ))}
    </h1>
    <p class="hero-intro">{t.intro}</p>
    <div class="hero-actions">
      <a class="primary" href="#projects">
        {t.work}
      </a>
      <button class="secondary agent-demo-trigger" type="button" data-open-pixel hidden>
        {lang === "en" ? "Explore the AI demo" : ru ? "Попробовать ИИ" : "KI-Demo entdecken"}
      </button>
    </div>
  </div>
  <div class="hero-foot container">
    <span>{t.note}</span>
    <span class="hero-foot-spacer" aria-hidden="true"></span>
  </div>
</section>
<script>
  import "../scripts/mobile-menu";
</script>

<style> .hero-foot-spacer { display:block; width:44px; height:44px; flex-shrink:0; margin-left:auto; } @media(max-width:760px) { .hero-foot-spacer { height:32px; } } </style>

<style>
.agent-demo-trigger { display:inline-flex; align-items:center; justify-content:center; font:inherit; color:inherit; cursor:pointer; }
.agent-demo-trigger[hidden] { display:none; }
.agent-demo-trigger:focus-visible { outline:2px solid #c1cfcc; outline-offset:4px; }
</style>
