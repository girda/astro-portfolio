---
import { heroCopy } from "../data/hero";
import MenuIcon from "./MenuIcon.astro";
import "../styles/studio-hero.css";
import "../styles/hero-refinement.css";
import "../styles/navigation-panel.css";
import "../styles/mobile-viewport.css";
import "../styles/portfolio-motion.css";
import { languagePath } from "../i18n/translations";
interface Props {
  lang: "de" | "ru" | "en";
}
const { lang } = Astro.props;
const t = heroCopy[lang === "en" ? "en" : "de"];
const animatedLines = t.lines.map((text, index) => ({
  text,
  offset: t.lines.slice(0, index).join("").length,
}));
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section id="top" class="studio-hero" aria-labelledby="hero-title" data-studio>
  <div class="art-window">
    <div class="art-plane">
      <picture>
        <source
          media="(max-width: 760px)"
          srcset={`${base}/images/studio-mobile-sharp.png`}
        />
        <img
          class="studio-image"
          src={`${base}/images/studio-sharp.png`}
          width="1586"
          height="992"
          alt=""
          fetchpriority="high"
        />
      </picture>
    </div>
  </div>
  <header class="hero-nav container">
    <a class="wordmark" href={languagePath(lang)} aria-label="HIRDA">
      <span class="wordmark-name" aria-hidden="true"><span class="logo-h"><span class="wordmark-bracket">[</span>H<span class="wordmark-bracket">]</span></span><span class="logo-rest">IRDA</span></span>
    </a>
    <nav class="desktop-nav" aria-label="Navigation">
      <a href="#projects">{t.work}</a>
      <a href="#about">{t.about}</a>
      <a href="#contact">{lang === "en" ? "Contact" : "Kontakt"}</a>
    </nav>
    <nav
      class="hero-languages"
      aria-label={lang === "en" ? "Language" : "Sprache"}
    >
      <a
        href={languagePath("de")}
        aria-current={lang === "de" ? "page" : undefined}
      >
        DE
      </a>
      <span>/</span>
      <a
        href={languagePath("en")}
        aria-current={lang === "en" ? "page" : undefined}
      >
        EN
      </a>
    </nav>
    <details class="mobile-menu">
      <summary aria-label={lang === "en" ? "Open menu" : "Menü öffnen"}>
        <span class="menu-stroke"></span>
        <span class="menu-stroke"></span>
      </summary>
      <nav
        class="menu-panel"
        aria-label={lang === "en" ? "Main navigation" : "Hauptnavigation"}
      >
        <div class="menu-caption">HIRDA / NAVIGATION</div>
        <div class="menu-links">
          <a href="#top"><MenuIcon name="home" /><span class="menu-label">{lang === "en" ? "Home" : "Start"}</span></a>
          <a href="#projects"><MenuIcon name="projects" /><span class="menu-label">{t.work}</span></a>
          <a href="#about"><MenuIcon name="about" /><span class="menu-label">{t.about}</span></a>
          <a href="#services"><MenuIcon name="services" /><span class="menu-label">{lang === "en" ? "Services" : "Leistungen"}</span></a>
          <a href="#pricing"><MenuIcon name="pricing" /><span class="menu-label">{lang === "en" ? "Pricing & maintenance" : "Preise & Betreuung"}</span></a>
        </div>
          <a class="menu-contact" href="#contact"><MenuIcon name="contact" /><span>{lang === "en" ? "Let’s talk" : "Lass uns sprechen"}</span></a>
        <div class="menu-bottom">
          <span>{t.eyebrow}</span>
        </div>
      </nav>
    </details>
  </header>
  <div class="hero-copy container">
    <p class="hero-eyebrow">{t.eyebrow}</p>
    <h1 id="hero-title" aria-label={t.lines.join(" ")}>
      {animatedLines.map(({ text: line, offset }, i) => (
        <span
          class:list={["line", { accent: i > 1 }]}
          style={`--delay:${i * 100}ms`}
        >
          {Array.from(line).map((letter, j) => (
            <span
              class="typed-letter"
              aria-hidden="true"
              style={`--type-delay:${500 + (offset + j) * 60}ms`}
            >
              {letter === " " ? "\u00a0" : letter}
            </span>
          ))}
        </span>
      ))}
    </h1>
    <p class="hero-intro">{t.intro}</p>
    <div class="hero-actions">
      <a class="primary" href="#projects">
        {t.work}
      </a>
      <button class="secondary agent-demo-trigger" type="button" data-open-agent hidden>
        {lang === "en" ? "Explore the AI demo" : "KI-Demo entdecken"}
      </button>
    </div>
  </div>
  <div class="hero-foot container">
    <span>{t.note}</span>
    <span class="hero-foot-spacer" aria-hidden="true"></span>
  </div>
</section>
<script>
  import "../scripts/mobile-menu";
  const agentLauncher = document.querySelector<HTMLButtonElement>('[data-cat-launcher]');
  const agentDemo = document.querySelector<HTMLButtonElement>('[data-open-agent]');
  if (agentLauncher && agentDemo) {
    agentDemo.hidden = false;
    agentDemo.addEventListener('click', () => {
      document.querySelector('[data-hirda-cat]')?.dispatchEvent(new CustomEvent('hirda:open-chat', { detail: agentDemo }));
    });
  }
</script>

<style> .hero-foot-spacer { display:block; width:44px; height:44px; flex-shrink:0; margin-left:auto; } @media(max-width:760px) { .hero-foot-spacer { height:32px; } } </style>

<style>
.agent-demo-trigger { display:inline-flex; align-items:center; justify-content:center; font:inherit; color:inherit; cursor:pointer; }
.agent-demo-trigger[hidden] { display:none; }
.agent-demo-trigger:focus-visible { outline:2px solid var(--brand-accent); outline-offset:4px; }
</style>
