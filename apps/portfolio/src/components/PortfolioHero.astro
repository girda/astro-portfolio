---
import type { Language } from '../i18n/translations';
interface Props {lang:Language;headline:[string,string];eyebrow:string;introduction:string;button:string;}
const {lang,introduction,button}=Astro.props;
const text={de:{first:'Gute Websites.',second:'Bleiben im Kopf.',note:'Für Menschen mit einem eigenen Business.',label:'WEBDESIGN & ENTWICKLUNG',work:'Vier Ideen. Vier eigene Welten.',scroll:'Projekte entdecken'},ru:{first:'Сайты с характером.',second:'Для вашего дела.',note:'Для тех, кто развивает свой бизнес.',label:'ДИЗАЙН И РАЗРАБОТКА САЙТОВ',work:'Четыре идеи. Четыре разных мира.',scroll:'Смотреть проекты'},en:{first:'Good websites.',second:'Leave an impression.',note:'For people building their own business.',label:'WEB DESIGN & DEVELOPMENT',work:'Four ideas. Four distinct worlds.',scroll:'Explore projects'}}[lang];
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<section class="hero" aria-labelledby="hero-title">
 <div class="hero-top"><p class="eyebrow"><span></span> {text.label}</p><span class="hero-location">ARTEM HIRDA · DE / RU / EN</span></div>
 <div class="hero-heading"><h1 id="hero-title">{text.first}<br/><span>{text.second}</span></h1><div class="asterisk" aria-hidden="true">✳</div></div>
 <div class="hero-bottom"><p>{introduction}</p><a class="pill" href="#projects">{button}<span>↘</span></a></div>
 <a class="showcase" href="#projects" aria-label={text.scroll}>
  <div class="showcase-label"><span>SELECTED CONCEPTS / 2026</span><span>{text.work} ↘</span></div>
  <div class="screen screen-back"><div class="screen-bar"><i></i><i></i><i></i><span>STILL / NAIL ATELIER</span></div><img src={`${base}/previews/nails.jpg`} alt="STILL Nail Atelier" width="1280" height="800"/></div>
  <div class="screen screen-front"><div class="screen-bar"><i></i><i></i><i></i><span>KANT / BARBERSHOP</span></div><img src={`${base}/previews/barbershop.jpg`} alt="KANT Barbershop" width="1280" height="800" fetchpriority="high"/></div>
  <div class="showcase-sticker" aria-hidden="true">DESIGN<br/>THAT<br/><b>CLICKS ↗</b></div>
 </a>
 <div class="hero-foot"><span>{text.note}</span><span>DESIGN → CODE → LIVE</span></div>
</section>
<style>
.hero{padding:48px 0 28px}.hero-top,.hero-bottom,.hero-foot{display:flex;justify-content:space-between;align-items:center;gap:24px}.eyebrow,.hero-location{font-size:11px;letter-spacing:.09em}.eyebrow{display:flex;align-items:center;gap:9px}.eyebrow span{width:7px;height:7px;border-radius:50%;background:#68842d}.hero-location{color:#656760}.hero-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;margin:34px 0 24px}h1{font-size:clamp(42px,6.9vw,100px);line-height:1.04;letter-spacing:-.065em;font-weight:500;margin:0}h1 span{color:#73766e}.asterisk{font-size:150px;line-height:1;color:#74865e}.hero-bottom{margin-bottom:44px}.hero-bottom p{max-width:590px;color:#64675e;font-size:15px;line-height:1.65;margin:0}.pill{display:flex;align-items:center;gap:35px;border-radius:40px;padding:17px 23px;background:#20231e;color:#fff;white-space:nowrap;font-size:13px}.pill span{font-size:21px;color:#d9ff68}.showcase{display:block;position:relative;height:470px;background:#dce4d3;border-radius:14px;overflow:hidden;background-image:linear-gradient(90deg,#a3ae9615 1px,transparent 1px),linear-gradient(#a3ae9615 1px,transparent 1px);background-size:52px 52px}.showcase-label{position:absolute;inset:25px 28px auto;display:flex;justify-content:space-between;font-size:10px;letter-spacing:.07em;color:#525e47}.screen{position:absolute;background:#fff;border:6px solid white;border-radius:12px;box-shadow:0 30px 50px #29362230;overflow:hidden;width:61%;transition:transform .6s}.screen-bar{height:23px;display:flex;align-items:center;gap:5px;padding:0 8px}.screen-bar i{width:5px;height:5px;background:#c7c9c4;border-radius:50%}.screen-bar span{margin:auto;font-size:8px;letter-spacing:.1em;color:#62665c}.screen img{width:100%;height:auto;display:block}.screen-front{left:6%;top:125px;transform:rotate(-6deg)}.screen-back{right:5%;top:85px;transform:rotate(8deg)}.showcase:hover .screen-front{transform:rotate(-3deg) translateY(-12px)}.showcase:hover .screen-back{transform:rotate(5deg) translateY(-8px)}.showcase-sticker{position:absolute;right:7%;bottom:26px;border-radius:50%;width:126px;height:126px;display:flex;flex-direction:column;justify-content:center;align-items:center;background:#ddff79;color:#252b1c;font-size:14px;line-height:1.2;transform:rotate(12deg)}.hero-foot{font-size:10px;letter-spacing:.06em;color:#686d61;padding:18px 0}@media(prefers-reduced-motion:no-preference){.hero-heading{animation:enter .75s both}.showcase{animation:enter .9s .15s both}.asterisk{animation:spin-in 1.3s both}@keyframes enter{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}@keyframes spin-in{from{opacity:0;transform:rotate(-80deg)}to{opacity:1;transform:rotate(0)}}}@media(max-width:700px){.hero{padding-top:25px}.hero-location{display:none}.hero-heading{margin:24px 0}h1{font-size:clamp(36px,8.4vw,58px)}.asterisk{font-size:64px}.hero-bottom{align-items:flex-start;flex-direction:column;gap:22px;margin-bottom:30px}.hero-bottom p{font-size:14px}.showcase{height:310px}.showcase-label{inset:20px 18px auto}.showcase-label span:last-child{display:none}.screen{width:80%}.screen-front{left:-5%;top:115px}.screen-back{right:-8%;top:65px}.showcase-sticker{width:90px;height:90px;right:4%;bottom:18px;font-size:11px}.hero-foot{font-size:9px;align-items:flex-start}.hero-foot span{max-width:50%}.hero-foot span:last-child{text-align:right}}@media(prefers-reduced-motion:reduce){.screen{transition:none}}
</style>
