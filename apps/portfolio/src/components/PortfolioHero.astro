---
import type { Language } from "../i18n/translations";
interface Props {
  lang: Language;
  headline: [string, string];
  eyebrow: string;
  introduction: string;
  button: string;
}
const { lang, headline, eyebrow, introduction, button } = Astro.props;
const labels = {
  de: { caption: "Drei Branchen. Drei eigene Handschriften.", concept: "Designkonzepte", services: "Leistungen entdecken", note: "Design · Entwicklung · Drei Sprachen" },
  ru: { caption: "Три ниши. Три разных характера.", concept: "Дизайн-концепты", services: "Что я предлагаю", note: "Дизайн · Разработка · Три языка" },
  en: { caption: "Three industries. Three distinct identities.", concept: "Design concepts", services: "Explore services", note: "Design · Development · Three languages" },
}[lang];
---
<section class="portfolio-hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="hero-eyebrow">{eyebrow}</p>
    <h1 id="hero-title">{headline[0]}<br /><span>{headline[1]}</span></h1>
    <p class="hero-intro">{introduction}</p>
    <div class="hero-actions">
      <a class="hero-button" href="#projects">{button}</a>
      <a class="hero-secondary" href="#services">{labels.services}</a>
    </div>
    <p class="hero-note">{labels.note}</p>
  </div>

</section>
<style>
.portfolio-hero { padding-block:96px 112px; }
.hero-copy { min-width:0; }
.hero-eyebrow { margin:0 0 24px; color:#a4adcc; font-size:.8125rem; letter-spacing:.12em; }
h1 { margin:0; font-size:clamp(2.5rem,7vw,6rem); font-weight:500; line-height:1.12; letter-spacing:-.055em; }
h1 span { display:inline-block; color:#a9b9ff; }
.hero-intro { max-width:620px; margin:28px 0; color:#b8bfd1; font-size:1.125rem; line-height:1.75; }
.hero-actions { display:flex; flex-wrap:wrap; align-items:center; gap:16px 24px; }
.hero-button { display:inline-flex; min-height:52px; align-items:center; padding:14px 22px; border:1px solid #7c96ff; border-radius:10px; background:#4165ec; color:white; font-weight:600; transition:transform .2s, background .2s, box-shadow .2s; }
.hero-button:hover { transform:translateY(-2px); background:#4c70f5; box-shadow:0 8px 28px #4165ec35; }
.hero-secondary { padding:12px 0; color:#d5daea; text-decoration:underline; text-underline-offset:5px; }
.hero-note { margin:28px 0 0; color:#929cb6; font-size:.8125rem; }
@media(prefers-reduced-motion:no-preference) {
 h1 span { animation:word-reveal 1s cubic-bezier(.16,1,.3,1) .15s both; }
 .hero-intro,.hero-actions,.hero-note { animation:appear .8s ease .3s both; }
}
@keyframes word-reveal { from { opacity:0; filter:blur(12px); transform:translateY(20px); } to { opacity:1; filter:blur(0); transform:translateY(0); } }
@keyframes appear { from { opacity:0; transform:translateY(16px); } to { opacity:1; transform:translateY(0); } }
@media(max-width:700px) { .portfolio-hero { padding-block:64px 72px; } h1 { font-size:clamp(2.25rem,8.4vw,3.8rem); letter-spacing:-.045em; } .hero-intro { font-size:1rem; } }
@media(max-width:480px) { .hero-button { width:100%; justify-content:center; } }
@media(prefers-reduced-motion:reduce) { .hero-button { transition:none; } .hero-button:hover { transform:none; } }
</style>
