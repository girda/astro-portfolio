---
import { languagePath, type Language } from '../i18n/translations';
interface Props { lang: string; homeHref?: string }
const ru = Astro.props.lang === 'ru';
const { lang, homeHref = '' } = Astro.props;
const en = lang === "en";
const links = en
  ? [["projects", "Projects"], ["about", "About me"], ["services", "Services"], ["pricing", "Pricing"], ["contact", "Contact"]]
  : ru ? [["projects", "Проекты"], ["about", "Обо мне"], ["services", "Услуги"], ["pricing", "Цены"], ["contact", "Контакты"]] : [["projects", "Projekte"], ["about", "Über mich"], ["services", "Leistungen"], ["pricing", "Preise"], ["contact", "Kontakt"]];

const privacy = lang === 'ru' ? {
  title: 'Приватность в чате Pixel',
  protection: 'Для защиты чата от автоматических запросов используется Cloudflare Turnstile. При отправке сообщения Cloudflare обрабатывает технические данные браузера и соединения для проверки посетителя.',
  chat: 'Текст сообщения и часть текущего диалога передаются через сервер Pixel в OpenAI для подготовки ответа. История интерфейса хранится в памяти открытой страницы. Не отправляй пароли, платёжные и другие чувствительные данные.',
  scope: 'Эти сведения относятся к чату Pixel.',
} : lang === 'en' ? {
  title: 'Privacy in the Pixel chat',
  protection: 'Cloudflare Turnstile protects this chat against automated requests. When you send a message, Cloudflare processes technical browser and connection data to verify the visitor.',
  chat: 'Your message and part of the current conversation are sent through the Pixel server to OpenAI to generate a reply. The interface keeps conversation history in the memory of the open page. Do not send passwords, payment details or other sensitive information.',
  scope: 'This notice covers the Pixel chat.',
} : {
  title: 'Datenschutzhinweise zum Pixel-Chat',
  protection: 'Cloudflare Turnstile schützt diesen Chat vor automatisierten Anfragen. Beim Senden einer Nachricht verarbeitet Cloudflare technische Browser- und Verbindungsdaten zur Prüfung des Besuchers.',
  chat: 'Deine Nachricht und ein Teil des aktuellen Gesprächs werden über den Pixel-Server an OpenAI übermittelt, um eine Antwort zu erstellen. Der Chatverlauf der Oberfläche bleibt im Arbeitsspeicher der geöffneten Seite. Sende keine Passwörter, Zahlungsdaten oder andere sensiblen Informationen.',
  scope: 'Diese Hinweise beziehen sich auf den Pixel-Chat.',
};
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-top" data-motion>
      <div class="footer-brand">
        <a class="footer-logo" href="#top" aria-label="HIRDA"><span aria-hidden="true"><b>[</b>H<b>]</b>IRDA</span></a>
        <p>{en ? "Design. Development. Personality." : ru ? "Дизайн. Разработка. Характер." : "Design. Entwicklung. Persönlichkeit."}</p>
      </div>
      <nav aria-label={en ? "Footer navigation" : ru ? "Навигация внизу страницы" : "Navigation im Footer"}>
        {links.map(([id, label]) => <a href={id==='projects'?`${languagePath(lang as Language)}arbeiten/`:`${homeHref}#${id}`}>{label}</a>)}
      </nav>

    </div>

    <details class="footer-privacy" id="pixel-privacy">
      <summary>{privacy.title}</summary>
      <p>{privacy.protection}</p>
      <p><a href="https://www.cloudflare.com/turnstile-privacy-policy/" target="_blank" rel="noopener noreferrer">Cloudflare Turnstile Privacy Addendum</a></p>
      <p>{privacy.chat}</p>
      <p><a href="https://openai.com/policies/privacy-policy/" target="_blank" rel="noopener noreferrer">OpenAI Privacy Policy</a></p>
      <p>{privacy.scope}</p>
    </details>

    <div class="footer-bottom">
    <a class="back-top" href="#top" aria-label={en ? "Back to top" : ru ? "Наверх" : "Nach oben"} title={en ? "Back to top" : ru ? "Наверх" : "Nach oben"}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5m-6 6 6-6 6 6" /></svg>
    </a>
      <span>© {new Date().getFullYear()} HIRDA</span>
      <span class="footer-signature" aria-hidden="true">&lt;design meets code /&gt;</span>
    </div>
  </div>
</footer>
<style>
  .footer-privacy { margin-top:32px; max-width:72ch; font-size:13px; color:#b7bfbb; }
  .footer-privacy summary { cursor:pointer; min-height:44px; display:list-item; padding-block:10px; }
  .footer-privacy a { text-decoration:underline; text-underline-offset:3px; }
  .footer-privacy a:hover, .footer-privacy summary:hover { color:var(--brand-accent); }
  .site-footer {
    position: relative;
    margin-top: 32px;
    background: radial-gradient(ellipse at 10% 100%, color-mix(in srgb, var(--brand-accent) 5.49%, transparent), transparent 65%), linear-gradient(180deg, #171d2000, #171d2066);
    font: 400 16px/1.65 var(--font-body);
  }
  .footer-inner { position: relative; border-top: 1px solid #d5d9d41c; padding-block: 48px 24px; }
  .footer-top { display: grid; grid-template-columns: minmax(0,1fr) auto; padding-right: 0; gap: 48px; align-items: start; }
  .footer-logo { display: inline-block; font: 650 40px/1.2 var(--font-body); letter-spacing: .04em; }
  .footer-logo b { color: var(--brand-accent); font-weight: inherit; }
  .footer-brand p { color: #b7bfbb; margin: 16px 0 0; max-width: 340px; }
  nav { display: grid; grid-template-columns: repeat(2, auto); gap: 8px 32px; }
  nav a { display: inline-flex; min-height: 44px; align-items: center; transition: color .25s; }
  .back-top { position: absolute; z-index: 2; right: 0; top: -72px; padding: 0; min-width: 0; display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; border: 1px solid #ffffff24; background: #ffffff08; backdrop-filter: blur(8px); box-shadow: 0 6px 22px #00000024, inset 0 1px 0 #ffffff0c; transition: background .25s, border-color .25s; }
  .back-top svg { transition: transform .3s; }
  .footer-bottom { font-size: 12px; line-height: 1.5; position: relative; margin-top: 88px; padding-top: 20px; border-top: 1px solid #d5d9d410; display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 12px 24px; color: #aeb8b2; }
  .footer-signature { margin-left: auto; text-align: right; font-family: var(--font-body); color: #bdc8b7; }
  @media (hover:hover) {
    nav a:hover, .back-top:hover { color: var(--brand-accent); }
    .back-top:hover svg { transform: translateY(-3px); }
  }
  /* Справа оставляем место фиксированному коту, чтобы он не закрывал ссылки. */
  @media (min-width: 761px) {
    .footer-inner { padding-right:140px; padding-block:56px 32px; }
    .footer-top { grid-template-columns:minmax(0,1fr) minmax(240px,.7fr); gap:64px; }
    .footer-bottom { margin-top:64px; }
    .back-top { top:-72px; right:0; }
    .footer-signature { font:11px/1.6 var(--font-code); }
  }
  @media (max-width: 760px) {
    .site-footer { margin-top: 16px; }
    .footer-inner { padding-block: 32px 24px; }
    .footer-top { grid-template-columns: minmax(0,1fr); gap: 24px; padding-right: 0; }

    .footer-logo { font-size: 30px; }
    nav { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 4px 16px; }
    .back-top { top: -64px; width: 48px; height: 48px; }
    .footer-bottom { margin-top: 80px; flex-direction: row; align-items: baseline; gap: 8px 12px; }
  }
  @media (prefers-reduced-motion:reduce) { nav a, .back-top svg { transition: none; } }
</style>
