{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hirda-cat-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://girda.github.io",
    "OPENAI_MODEL": "gpt-4.1-mini"
  },
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "account_id": "ad933102ca4c570aa0c733a42f4eee7c"
}
