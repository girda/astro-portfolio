---
import { copy, languages, pages, pathFor as routeFor, type Language, type Page } from '../data/locales';
import { photos } from '../data/site';
import SectionMotion from './SectionMotion.astro';
import '../styles/vibrant.css';
interface Props { lang: Language; page: Page }
const {lang,page}=Astro.props;
const pathFor = (lang: Language, page: Page) => import.meta.env.BASE_URL.replace(/\/$/, '') + routeFor(lang, page);
const t=copy[lang];
const home=pathFor(lang,'home');
const booking=`${home}#booking`;
const title=page==='home'?t.hero1:t[page];
const locale=lang==='de'?'de-DE':lang==='ru'?'ru-RU':'en-GB';
const money=new Intl.NumberFormat(locale,{style:'currency',currency:'EUR'});
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={page==='home'?t.intro:page==='services'?t.serviceIntro:page==='gallery'?t.galleryNote:t.studioIntro}/><title>{title} · STILL Nail Atelier</title>{languages.map(l=><link rel="alternate" hreflang={l} href={pathFor(l,page)}/>)}<link rel="alternate" hreflang="x-default" href={pathFor('de',page)}/></head><body>
<a class="skip" href="#main">{t.skip}</a><div class="demo">{t.demo}</div>
<header class="wrap"><a class="brand" href={home} aria-label={`STILL · ${t.home}`}>still<span>NAIL ATELIER</span></a><nav class="main-nav" aria-label={t.home}>{pages.map(p=><a href={pathFor(lang,p)} aria-current={p===page?'page':undefined}>{t[p]}</a>)}</nav><nav class="languages" aria-label={t.language}>{languages.map(l=><a href={pathFor(l,page)} lang={l} hreflang={l} aria-current={l===lang?'page':undefined}>{l.toUpperCase()}</a>)}</nav><a class="button header-book" href={booking}>{t.book} ↗</a></header>
<main id="main">
{page==='home'? <>
<section class="hero wrap"><div class="hero-copy"><p class="eyebrow">MÜNCHEN · NAILS & SELF-CARE</p><h1>{t.hero1}<br/><em>{t.hero2}</em></h1><p class="intro">{t.intro}</p><a class="button" href={pathFor(lang,'services')}>{t.viewServices} ↗</a><div class="color-dots" aria-hidden="true"><i></i><i></i><i></i><i></i><span>YOUR COLOUR. YOUR MOOD.</span></div></div><div class="hero-art"><img src={photos[0].src} alt={t.galleryIntro} width="800" height="950" fetchpriority="high"/><span class="stamp">STILL<br/><small>NAIL ATELIER</small><span aria-hidden="true">✳</span></span><span class="art-caption">01 / A LITTLE EVERYDAY LUXURY</span></div></section>
<div class="ribbon" aria-hidden="true">NAILS. COLOUR. GOOD MOOD. <span>✳</span> NAILS. COLOUR. GOOD MOOD. <span>✳</span></div>
<section class="wrap section"><div class="section-head" data-motion><h2>{t.signature}</h2><a class="text-link" href={pathFor(lang,'services')}>{t.services} ↗</a></div><div class="service-grid">{t.treatments.slice(0,2).map((s,i)=><article class="service-card"><span class="number">0{i+1}</span><h3>{s.name}</h3><p>{s.text}</p><div><span>{s.time} {t.minutes}</span><strong>{money.format(s.price)}</strong></div><a class="text-link" href={`${home}?service=${i}#booking`} data-service={i}>{t.choose} ↗</a></article>)}</div></section>
<section class="wrap teaser section" data-motion><img src={photos[1].src} alt={t.care} width="650" height="650" loading="lazy"/><div><p class="eyebrow">STILL / MÜNCHEN</p><h2>{t.studioIntro}</h2><p>{t.studioText}</p><a class="text-link" href={pathFor(lang,'studio')}>{t.studio} ↗</a></div></section>
<section class="booking-band" id="booking"><div class="wrap booking-layout"><div data-motion><p class="eyebrow">STILL / YOUR MOMENT</p><h2>{t.formTitle}</h2><p>{t.bookingNote}</p><ol><li>{t.step1}</li><li>{t.step2}</li><li>{t.step3}</li></ol></div><form id="booking-form" data-labels={JSON.stringify([t.services,t.date,t.time,t.price,t.bookingNote])} data-locale={locale} data-unsure={t.unsure} data-minutes={t.minutes} data-select={t.select}><label>{t.services}<select name="service" required><option value="">{t.select}</option>{t.treatments.map((s,i)=><option value={i} data-price={s.price} data-duration={s.time}>{s.name}</option>)}<option value="consult">{t.consult}</option></select></label><div class="form-row"><label>{t.date}<input name="date" type="date" required/></label><label>{t.time}<select name="time"><option>{t.morning}</option><option>{t.afternoon}</option><option>{t.flexible}</option></select></label></div><div class="estimate" aria-live="polite"><span id="duration">{t.select}</span><strong id="price">—</strong></div><button class="button" type="submit">{t.preview} ↗</button><p class="fine">{t.bookingNote}</p></form></div></section>
</> : <section class="wrap page-hero"><p class="eyebrow">STILL NAIL ATELIER / 0{pages.indexOf(page)+1}</p><h1>{page==='services'?t.services:page==='gallery'?t.galleryIntro:t.studioIntro}</h1><p>{page==='services'?t.serviceIntro:page==='gallery'?t.galleryNote:t.studioText}</p></section>}
{page==='services'&&<section class="wrap section services-page"><div class="service-grid">{t.treatments.map((s,i)=><article class="service-card"><span class="number">0{i+1}</span><h2>{s.name}</h2><p>{s.text}</p><div><span>{s.time} {t.minutes}</span><strong>{money.format(s.price)}</strong></div><a class="button" href={`${home}?service=${i}#booking`}>{t.choose} ↗</a></article>)}</div><p class="fine">{t.priceNote}</p><div class="extras" data-motion><h3>{t.consult}</h3><p>{t.a1}</p><a href={`${home}?service=consult#booking`} class="text-link">{t.book} ↗</a></div></section>}
{page==='gallery'&&<section class="wrap section gallery-page"><div class="filters" role="group" aria-label={t.gallery}><button aria-pressed="true" data-filter="all">{t.all}</button><button aria-pressed="false" data-filter="color">{t.color}</button><button aria-pressed="false" data-filter="care">{t.care}</button></div><div class="gallery">{photos.map((photo,i)=><figure data-category={i===1?'care':'color'}><button class="image-button" data-image={photo.src} data-caption={i===1?t.care:t.color} aria-label={`${t.gallery}: ${i===1?t.care:t.color}`}><img src={photo.src} alt={i===1?t.care:t.color} width="700" height="850" loading="lazy"/><span aria-hidden="true">↗</span></button><figcaption>0{i+1} / {i===1?t.care:t.color}</figcaption></figure>)}</div><p class="fine">{t.galleryNote}</p></section>}
{page==='studio'&&<><section class="wrap section teaser"><img src={photos[1].src} alt={t.care} width="700" height="800" loading="lazy"/><div data-motion><p class="eyebrow">STILL / SELF-CARE</p><h2>{t.signature}</h2><ol class="ritual"><li>{t.step1}</li><li>{t.step2}</li><li>{t.step3}</li></ol><a class="button" href={booking}>{t.book} ↗</a></div></section><section class="contact-band"><div class="wrap section contact-grid"><div data-motion><h2>{t.contact}</h2><p>{t.contactNote}</p></div><div data-motion><h3>{t.address}</h3><p>Musterstraße 18<br/>80333 München</p><h3>{t.contact}</h3><p>hallo@still.example<br/>+49 000 1234567</p></div><div data-motion><h3>{t.hours}</h3><p>{t.hoursText}</p><a class="text-link" href={booking}>{t.book} ↗</a></div></div></section></>}
{(page==='home'||page==='services')&&<section class="wrap section faq-layout"><h2 data-motion>{t.faqTitle}</h2><div class="faq">{[[t.q1,t.a1],[t.q2,t.a2],[t.q3,t.a3],[t.q4,t.a4]].map(([q,a])=><details><summary>{q}<svg class="accordion-chevron" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary><div class="answer"><p>{a}</p></div></details>)}</div></section>}
{page!=='home'&&<section class="wrap last-cta" data-motion><h2>{t.formTitle}</h2><a class="button" href={booking}>{t.book} ↗</a></section>}
</main><footer><div class="wrap footer-top"><a class="brand" href={home}>still<span>NAIL ATELIER</span></a><nav aria-label={t.studio}>{pages.map(p=><a href={pathFor(lang,p)}>{t[p]}</a>)}</nav><a href="#main">{t.back} ↑</a></div><div class="wrap credits"><span>© {new Date().getFullYear()} · {t.footer}</span><span>Unsplash: {photos.map((p,i)=><><a href={p.url} target="_blank" rel="noopener noreferrer">{p.author}</a>{i<2?' · ':''}</>)}</span></div></footer>
<dialog id="preview" aria-labelledby="preview-title"><button class="close" type="button" data-close aria-label={t.close}>×</button><h2 id="preview-title">{t.summary}</h2><dl id="summary"></dl><p class="fine">{t.bookingNote}</p><button class="button" type="button" data-close>{t.edit}</button></dialog>
<dialog id="lightbox" aria-label={t.gallery}><button class="close" type="button" data-close aria-label={t.close}>×</button><img id="large-image" alt=""/><p id="large-caption"></p></dialog><SectionMotion/>
<script>
 const form=document.querySelector<HTMLFormElement>('#booking-form');
 if(form){
 const select=form.elements.namedItem('service') as HTMLSelectElement;const date=form.elements.namedItem('date') as HTMLInputElement;
 const now=new Date();date.min=`${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}`;
 const money=new Intl.NumberFormat(form.dataset.locale,{style:'currency',currency:'EUR'});
 const update=()=>{const o=select.selectedOptions[0];document.querySelector('#price')!.textContent=o.dataset.price?money.format(Number(o.dataset.price)):select.value?form.dataset.unsure!:'—';document.querySelector('#duration')!.textContent=o.dataset.duration?`${o.dataset.duration} ${form.dataset.minutes}`:form.dataset.select!;};
 const initial=new URLSearchParams(location.search).get('service');if(initial&&[...select.options].some(o=>o.value===initial)){select.value=initial;update();}
 select.addEventListener('change',update);document.querySelectorAll<HTMLAnchorElement>('[data-service]').forEach(a=>a.addEventListener('click',()=>{select.value=a.dataset.service!;update();}));
 form.addEventListener('submit',e=>{e.preventDefault();if(!form.reportValidity())return;const labels:string[]=JSON.parse(form.dataset.labels!);const data=new FormData(form);const values=[select.selectedOptions[0].textContent,new Intl.DateTimeFormat(form.dataset.locale).format(new Date(`${date.value}T12:00:00`)),data.get('time'),document.querySelector('#price')!.textContent];const target=document.querySelector('#summary')!;target.replaceChildren();values.forEach((v,i)=>{const row=document.createElement('div');const dt=document.createElement('dt');const dd=document.createElement('dd');dt.textContent=labels[i];dd.textContent=String(v);row.append(dt,dd);target.append(row);});document.querySelector<HTMLDialogElement>('#preview')!.showModal();});
 }
 document.querySelectorAll<HTMLButtonElement>('[data-close]').forEach(b=>b.addEventListener('click',()=>b.closest('dialog')!.close()));
 document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));document.querySelectorAll<HTMLElement>('[data-category]').forEach(el=>el.hidden=b.dataset.filter!=='all'&&el.dataset.category!==b.dataset.filter);}));
 document.querySelectorAll<HTMLButtonElement>('[data-image]').forEach(b=>b.addEventListener('click',()=>{const img=document.querySelector<HTMLImageElement>('#large-image')!;img.src=b.dataset.image!;img.alt=b.dataset.caption!;document.querySelector('#large-caption')!.textContent=b.dataset.caption!;document.querySelector<HTMLDialogElement>('#lightbox')!.showModal();}));
 const reduced=matchMedia('(prefers-reduced-motion: reduce)');
 document.querySelectorAll<HTMLDetailsElement>('.faq details').forEach(d=>{const s=d.querySelector('summary')!;const a=d.querySelector<HTMLElement>('.answer')!;let anim:Animation|null=null;let expanded=d.open;const settle=()=>{anim?.cancel();anim=null;d.open=expanded;d.style.overflow='';};s.addEventListener('click',e=>{if(reduced.matches)return;e.preventDefault();const from=d.getBoundingClientRect().height;expanded=anim?!expanded:!d.open;anim?.cancel();d.open=true;d.style.overflow='hidden';anim=d.animate({height:[`${from}px`,`${s.getBoundingClientRect().height+(expanded?a.getBoundingClientRect().height:0)}px`]},{duration:260,easing:'ease-out'});anim.onfinish=settle;});reduced.addEventListener('change',()=>{if(reduced.matches&&anim)settle();});window.addEventListener('resize',()=>{if(anim)settle();});});
</script></body></html>
