---
import "../../../../packages/ui/wide-screen.css";
import '../../../../packages/ui/edge-carousel.css';
import {products,categories,extras,settings,formatMoney} from '../data/menu';
import MenuSearch from './MenuSearch.astro';
import PizzeriaBrand from './PizzeriaBrand.astro';
import AllergenIcons from './AllergenIcons.astro';
import Icon from '../../../../packages/ui/Icon.astro';
import '../styles/menu.css';
import '../styles/appearances.css';
import '../styles/diner.css';
import '../styles/pizzeria.css';
const {theme='streetfood'}=Astro.props;
const editorial=theme!=='streetfood';
const name=theme==='pizzeria'?'Forno & Basilico':theme==='diner'?'STREET FOOD':'STREET FOOD';
const base=import.meta.env.BASE_URL;
const pagePath=theme==='streetfood'?base:`${base}${theme}/`;
---
<!doctype html><html lang="de" data-appearance={theme} data-menu-mode={theme==='diner'?settings.menuMode:'ordering'}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/><meta name="theme-color" content="#ffffff"/><title>{name} — Dein digitales Menü</title><meta name="description" content={theme==='pizzeria'?'Pizza, Antipasti und Dolci: Entdecke die Speisekarte von Forno & Basilico.':'Burger, Frühstück und Kaffee: Entdecke das interaktive Street-Food-Menü mit Favoriten, Extras und Warenkorb.'}/><meta name="robots" content="noindex,follow"/><link rel="canonical" href={new URL(pagePath,Astro.site||'https://girda.github.io')}/><link rel="icon" href={`${base}assets/food.svg`}/></head><body>
<div class="food-app"><header class="app-header"><div class="header-brand"><a class="wordmark" href={theme==='streetfood'?base:`${base}${theme}/`}>{theme==='diner'?<img class="diner-brand-image" data-brand-image data-default-logo={`${base}assets/diner-brand.svg`} src={settings.logo||`${base}assets/diner-brand.svg`} alt="Street Food" width="330" height="66"/>:theme==='pizzeria'?<PizzeriaBrand/>:<><svg class="menu-emblem" viewBox="0 0 48 48" aria-hidden="true"><path d={theme==='pizzeria'?'M4 41V25a20 20 0 0 1 40 0v16H4ZM12 41V26a12 12 0 0 1 24 0v15M2 45h44M5 19l8 3M11 9l5 7M24 5v9M37 9l-5 7M43 19l-8 3M24 39c-10-1-7-8-3-12-1 5 5 3 5-3 9 9 7 14-2 15Z':theme==='diner'?'M8 4Q15 11 24 4Q34 11 40 4L46 12Q39 20 44 30Q49 39 34 42Q27 43 24 47Q20 43 13 42Q-1 39 4 30Q9 20 2 12Z':'M5 6h38v25L24 44 5 31V6ZM12 22c0-13 24-13 24 0H12ZM11 27h26M14 32h20M19 15h.1M27 14h.1'}/></svg><span>{name}{theme==='pizzeria' && <small>PIZZERIA</small>}</span></>}</a></div><div class="header-tools"><MenuSearch/>{editorial&&<button class="icon-button header-cart" data-cart-open aria-label="Warenkorb öffnen"><Icon name="shopping-bag"/><span data-cart-count>0</span></button>}<button class="icon-button" data-menu-open aria-label="Navigation öffnen"><Icon name="menu"/></button></div></header>
{editorial && <section class="menu-intro" aria-label="Willkommen"><div><p class="intro-kicker">{theme==='pizzeria'?'Buon appetito.':'Good food. Good mood.'}</p><h1>{theme==='pizzeria'?'Ein Stück Italien.':<span class="wave-title" aria-label={settings.title}>{[...settings.title].map((char,i,chars)=><span aria-hidden="true" style={`--letter-height:${0.78+0.25*Math.pow(Math.abs((i-(chars.length-1)/2)/((chars.length-1)/2)),1.3)}`}>{char===' '? '\u00a0':char}</span>)}</span>}</h1><p data-menu-subtitle>{theme==='pizzeria'?'Pizza, Antipasti & Dolci.':settings.subtitle}</p><span class="intro-stamp">{theme==='pizzeria'?'La dolce pausa':'Fresh picks · Big appetite'}</span></div><img src={theme==='pizzeria'?`${base}assets/menu/pizzeria-hero.webp`:`${base}assets/menu/diner-hero.webp`} alt="" width="780" height="490"/><span class="intro-number" aria-hidden="true">{theme==='pizzeria'?'Buono!':'EST. NOW'}</span></section>}
<nav class="categories" data-edge-filter aria-label="Menükategorien">{categories.map((c,i)=><button class="category" data-category-select={c.id} aria-pressed={i===0}><span aria-hidden="true">{c.symbol}</span>{c.name}</button>)}</nav>
<main id="main"><div class="menu-caption">{editorial ? <h2 data-category-title>{theme==='pizzeria'?'Pizza aus dem Ofen':'Unsere Burger'}</h2> : <h1>Was darf’s sein?</h1>}<span data-results>{products.length} Gerichte</span></div><div class="dish-grid">{products.map((p,i)=><article class="dish-card" data-product={p.id} data-category={p.category}><button class="dish-open" data-open={p.id} aria-label={`${p.name}, ${formatMoney(p.price)}, Details und Extras`}><div class="dish-photo"><img src={p.image} data-fallback={`${base}assets/food.svg`} alt={p.name} width="780" height="490" loading={i<2?"eager":"lazy"} fetchpriority={i===0?"high":"auto"}/><span class="prep-time">{p.time} MIN.</span></div><div class="dish-info"><div><h2>{p.name}</h2>{editorial && <p class="dish-description">{p.description}</p>}</div><strong><span>{formatMoney(p.price)}</span></strong></div></button><AllergenIcons ids={p.allergenIds} verified={p.allergensVerified}/><button class="favorite icon-button" data-favorite={p.id} aria-pressed="false" aria-label={`${p.name} merken`}><Icon name="heart"/></button><button class="quick-add" data-add={p.id} aria-label={`${p.name} zum Warenkorb hinzufügen`}><Icon name="plus"/></button></article>)}</div><div class="empty-state" hidden><h2>Hier ist noch Platz.</h2><p data-empty-text>Probiere eine andere Suche oder Kategorie.</p><button class="primary" data-reset>Alle Gerichte ansehen</button></div>{editorial && <button class="menu-feature" data-nav-category={theme==='pizzeria'?'dolci':'sides'}><span>{theme==='pizzeria'?'Noch etwas Süßes?':'Knusprige Beilagen'}</span>{theme==='pizzeria' && <img src={`${base}assets/menu/tiramisu.webp`} alt="Tiramisù" width="250" height="180" loading="lazy"/>}<small>{theme==='pizzeria'?'Dolci entdecken':'Beilagen entdecken'}</small></button>}<p class="demo-note menu-demo-note">Interaktive Menü-Demo. Beispielpreise und Rezepturen; Bilder können abweichen. Keine echte Bestellung oder Zahlung. Allergene bitte vor einem echten Kauf beim Betrieb prüfen.</p></main>
<button class="cart-dock" data-cart-open><span><Icon name="shopping-bag"/><span data-cart-label>Dein Warenkorb</span></span><strong data-cart-total>0,00 €</strong></button></div>
<dialog class="food-dialog product-dialog" data-product-dialog aria-labelledby="product-title"><button class="dialog-close icon-button" data-close aria-label="Schließen"><Icon name="x"/></button><img class="product-hero" data-product-image alt=""/><div class="product-detail"><p class="overline" data-product-category></p><div class="product-title-row"><h2 id="product-title"></h2><strong data-product-price></strong></div><p data-product-description></p><p class="allergen-note"><strong data-allergen-heading>Allergene:</strong> <span data-product-allergens></span></p><fieldset class="extras"><legend>Mach’s zu deinem.</legend>{extras.map(e=><label><input type="checkbox" name="extra" value={e.id}/><span>{e.name}</span><strong>+ {formatMoney(e.price)}</strong></label>)}</fieldset><label class="dish-note">Dein Wunsch<textarea data-dish-note maxlength="180" rows="2" placeholder="Zum Beispiel: ohne Zwiebeln. Bei Allergien bitte persönlich nachfragen."></textarea></label></div><div class="product-actions"><div class="quantity"><button type="button" data-quantity="-1" aria-label="Menge verringern">−</button><output data-quantity-value>1</output><button type="button" data-quantity="1" aria-label="Menge erhöhen">+</button></div><button class="primary" data-product-add>Hinzufügen <span data-add-total></span></button></div></dialog>
<dialog class="food-dialog cart-dialog" data-cart-dialog aria-labelledby="cart-title"><button class="dialog-close icon-button" data-close aria-label="Warenkorb schließen"><Icon name="x"/></button><div class="cart-heading"><p class="overline">GUTE WAHL.</p><h2 id="cart-title">Deine Bestellung.</h2><p data-cart-location>Demo · Abholung</p></div><div data-cart-items></div><div class="cart-summary"><span>Gesamt</span><strong data-summary-total></strong></div><button class="primary checkout" data-checkout>Demo-Bestellung prüfen</button><p class="demo-note">Es wird nichts versendet oder berechnet.</p><div class="order-confirmation" hidden aria-live="polite"><h3>So könnte deine Bestellung aussehen.</h3><p>Diese Vorschau ist lokal. Eine Küche, Zahlung und echte Bestellannahme sind noch nicht angeschlossen.</p></div></dialog>
<dialog class="food-dialog small-dialog" data-nav-dialog aria-labelledby="nav-title"><button class="dialog-close icon-button" data-close aria-label="Schließen"><Icon name="x"/></button><h2 id="nav-title">{name}</h2><button class="location-choice" data-nav-category="all">Alle Gerichte</button><button class="location-choice" data-nav-category="favorites">Deine Favoriten</button><p class="demo-note menu-demo-note">Ein QR-Menü-Konzept von HIRDA. Kein echter Restaurantbetrieb.</p></dialog>
<div class="toast" role="status" aria-live="polite"></div>
<script id="menu-data" type="application/json" set:html={JSON.stringify({products,extras,categories,settings}).replaceAll("<", "\\u003c")}/><script>import '../scripts/menu';</script><footer class="menu-legal"><a href="https://girda.github.io/astro-portfolio/impressum/">Impressum</a><a href="https://girda.github.io/astro-portfolio/datenschutz/">Datenschutz</a></footer></body></html>
