---
import {ALLERGENS,allergenIconMarkup} from '../data/menu-options.mjs';
const {ids=[]}=Astro.props;
---
<div class="dish-allergens" aria-label="Allergene">{ALLERGENS.filter(a=>ids.includes(a.id)).map(a=><button type="button" class="allergen-icon" data-allergen={a.id} style={`--allergen-color:${a.color}`} aria-label={a.shortLabel} aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={allergenIconMarkup(a)}/><span class="allergen-tip" role="tooltip">{a.shortLabel}</span></button>)}</div>
