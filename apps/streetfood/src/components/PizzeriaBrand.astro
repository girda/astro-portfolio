// Кирпичная печь и огонь остаются векторными на любом экране.
const seams=Array.from({length:11},(_,i)=>{
 const angle=Math.PI+(i+1)*Math.PI/12;
 return `M${40+27*Math.cos(angle)} ${48+27*Math.sin(angle)}L${40+39*Math.cos(angle)} ${48+39*Math.sin(angle)}`;
});
