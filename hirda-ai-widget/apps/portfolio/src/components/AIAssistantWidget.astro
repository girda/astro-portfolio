---
interface Props {
  lang?: 'de' | 'ru' | 'en';
}

const { lang = 'de' } = Astro.props;
const copy = {
  de: {
    greeting: 'Miau! 👋 Ich bin Artems digitaler Assistent. Fragen zu Websites, Projekten oder Preisen?',
    title: 'HIRDA CAT',
    status: 'Interaktive Demo',
    subtitle: 'Stell mir eine Frage oder wähle ein Thema.',
    open: 'HIRDA CAT öffnen',
    close: 'Chat schließen',
    dismiss: 'Hinweis schließen',
    placeholder: 'Deine Frage an mich …',
    send: 'Senden',
    welcome: 'Hey! Ich bin der kleine Helfer auf Artems Website. 🐾 Worüber möchtest du mehr erfahren?',
    projects: 'Projekte',
    prices: 'Preise',
    services: 'Leistungen',
    contact: 'Kontakt',
    disclaimer: 'Demo-Modus: Antworten sind noch nicht mit einer KI verbunden.',
  },
  ru: {
    greeting: 'Мяу! 👋 Я цифровой помощник Артёма. Расскажу о сайтах, проектах и ценах!',
    title: 'HIRDA CAT',
    status: 'Интерактивное демо',
    subtitle: 'Спроси меня или выбери тему.',
    open: 'Открыть HIRDA CAT',
    close: 'Закрыть чат',
    dismiss: 'Закрыть подсказку',
    placeholder: 'Твой вопрос …',
    send: 'Отправить',
    welcome: 'Привет! Я маленький помощник на сайте Артёма. 🐾 О чём хочешь узнать?',
    projects: 'Проекты',
    prices: 'Цены',
    services: 'Услуги',
    contact: 'Контакты',
    disclaimer: 'Демо-режим: ответы пока не подключены к ИИ.',
  },
  en: {
    greeting: 'Meow! 👋 I’m Artem’s digital assistant. Ask me about websites, projects or pricing!',
    title: 'HIRDA CAT',
    status: 'Interactive demo',
    subtitle: 'Ask a question or choose a topic.',
    open: 'Open HIRDA CAT',
    close: 'Close chat',
    dismiss: 'Dismiss hint',
    placeholder: 'Ask me anything …',
    send: 'Send',
    welcome: 'Hi! I’m the little helper on Artem’s website. 🐾 What would you like to explore?',
    projects: 'Projects',
    prices: 'Pricing',
    services: 'Services',
    contact: 'Contact',
    disclaimer: 'Demo mode: responses are not connected to AI yet.',
  },
}[lang];
const robotSrc = `${import.meta.env.BASE_URL}ai/robot-cat.webp`;
---

<div class="hirda-cat" data-hirda-cat data-lang={lang}>
  <div class="cat-bubble" data-cat-bubble hidden>
    <p>{copy.greeting}</p>
    <button class="bubble-close" type="button" data-cat-dismiss aria-label={copy.dismiss}>×</button>
  </div>

  <button class="cat-launcher" type="button" data-cat-launcher aria-expanded="false" aria-controls="hirda-cat-panel" aria-label={copy.open}>
    <img src={robotSrc} alt="" width="750" height="750" decoding="async" />
    <span class="launcher-glow" aria-hidden="true"></span>
  </button>

  <section class="cat-panel" id="hirda-cat-panel" data-cat-panel role="dialog" aria-labelledby="hirda-cat-title" hidden>
    <header class="cat-head">
      <div class="head-mark" aria-hidden="true">✳</div>
      <div class="head-copy">
        <h2 id="hirda-cat-title">{copy.title}</h2>
        <p><span class="status-dot" aria-hidden="true"></span>{copy.status}</p>
      </div>
      <button class="cat-close" type="button" data-cat-close aria-label={copy.close}>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M5 5 19 19M19 5 5 19" /></svg>
      </button>
    </header>

    <div class="cat-conversation" data-cat-conversation role="log" aria-live="polite" aria-label="Chat">
      <p class="chat-intro">{copy.subtitle}</p>
      <div class="chat-message is-bot">{copy.welcome}</div>
      <div class="cat-topics" data-cat-topics>
        <button type="button" data-cat-topic="projects">✦ {copy.projects}</button>
        <button type="button" data-cat-topic="prices">€ {copy.prices}</button>
        <button type="button" data-cat-topic="services">✳ {copy.services}</button>
        <button type="button" data-cat-topic="contact">↗ {copy.contact}</button>
      </div>
    </div>

    <form class="cat-compose" data-cat-form>
      <label class="sr-only" for="hirda-cat-input">{copy.placeholder}</label>
      <input id="hirda-cat-input" data-cat-input type="text" autocomplete="off" maxlength="350" placeholder={copy.placeholder} />
      <button type="submit" aria-label={copy.send}>
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 14-7-4 14-3.1-6.9L5 12Z"/><path d="m12 12 7-7"/></svg>
      </button>
    </form>
    <p class="cat-notice">{copy.disclaimer}</p>
  </section>
</div>

<script>
  type Lang = 'de' | 'ru' | 'en';
  type Topic = 'projects' | 'prices' | 'services' | 'contact';
  const dictionary = {
    de: {
      project: 'Artem zeigt vier Website-Konzepte: KANT (Barbershop), KLAR (Reinigung), WERKRAUM (Autowerkstatt) und STILL (Nagelstudio).',
      pricing: 'Die Einstiegspreise sind: Landingpage ab 490 €, Business-Website ab 790 € und Website mit CMS ab 1.290 €. Der Endpreis hängt vom Umfang ab.',
      service: 'Artem bietet Websites, Landingpages, Redesign, CMS und individuelle Funktionen. Die passende Lösung hängt von deinem Projekt ab.',
      contact: 'Du kannst Artem über das Kontaktformular auf der Seite erreichen. Dort bereitest du eine WhatsApp-Nachricht vor und sendest sie selbst ab.',
      unknown: 'Das ist bisher eine interaktive Demo. Wähle unten ein Thema oder sieh dir Artems Projekte und Leistungen direkt auf der Seite an.',
      labels: { projects: 'Projekte ansehen', prices: 'Preise ansehen', services: 'Leistungen ansehen', contact: 'Zum Kontakt' },
      names: { projects: 'Projekte', prices: 'Preise', services: 'Leistungen', contact: 'Kontakt' },
    },
    en: {
      project: 'Artem showcases four website concepts: KANT (barbershop), KLAR (cleaning), WERKRAUM (auto service), and STILL (nail studio).',
      pricing: 'Starting prices: landing page from €490, business website from €790, and a CMS website from €1,290. The final quote depends on the scope.',
      service: 'Artem builds websites, landing pages, redesigns, CMS sites and custom features tailored to a business.',
      contact: 'Use the contact section to prepare a WhatsApp enquiry. You can review the message and send it yourself.',
      unknown: 'This is an interactive demo for now. Choose a topic below, or explore Artem’s work directly on this page.',
      labels: { projects: 'See projects', prices: 'See pricing', services: 'See services', contact: 'Go to contact' },
      names: { projects: 'Projects', prices: 'Pricing', services: 'Services', contact: 'Contact' },
    },
    ru: {
      project: 'Артём показывает четыре проекта: KANT (барбершоп), KLAR (клининг), WERKRAUM (автосервис), STILL (студия маникюра).',
      pricing: 'Стартовые цены: лендинг от 490 €, сайт для бизнеса от 790 €, сайт с CMS от 1 290 €. Итоговая стоимость зависит от задач.',
      service: 'Артём создаёт сайты, лендинги, редизайн, сайты с CMS и индивидуальные функции.',
      contact: 'В разделе контактов можно подготовить сообщение в WhatsApp, проверить его и отправить Артёму.',
      unknown: 'Это пока интерактивное демо. Выбери тему ниже или посмотри проекты и услуги на сайте.',
      labels: { projects: 'Смотреть проекты', prices: 'Смотреть цены', services: 'Смотреть услуги', contact: 'К контактам' },
      names: { projects: 'Проекты', prices: 'Цены', services: 'Услуги', contact: 'Контакты' },
    },
  };

  const root = document.querySelector<HTMLElement>('[data-hirda-cat]');
  if (root) {
    const lang: Lang = root.dataset.lang === 'ru' || root.dataset.lang === 'en' ? root.dataset.lang : 'de';
    const texts = dictionary[lang];
    const bubble = root.querySelector<HTMLElement>('[data-cat-bubble]')!;
    const launcher = root.querySelector<HTMLButtonElement>('[data-cat-launcher]')!;
    const panel = root.querySelector<HTMLElement>('[data-cat-panel]')!;
    const closer = root.querySelector<HTMLButtonElement>('[data-cat-close]')!;
    const dismiss = root.querySelector<HTMLButtonElement>('[data-cat-dismiss]')!;
    const log = root.querySelector<HTMLElement>('[data-cat-conversation]')!;
    const form = root.querySelector<HTMLFormElement>('[data-cat-form]')!;
    const input = root.querySelector<HTMLInputElement>('[data-cat-input]')!;
    const topics = root.querySelector<HTMLElement>('[data-cat-topics]')!;
    let bubbleTimer: number | undefined;
    let shownBubble = false;
    let previousOverflow = '';
    let scrollLocked = false;

    const dismissBubble = () => { bubble.hidden = true; window.clearTimeout(bubbleTimer); };
    const showBubble = () => {
      if (shownBubble || !panel.hidden) return;
      shownBubble = true;
      bubble.hidden = false;
      bubbleTimer = window.setTimeout(dismissBubble, 8000);
    };
    window.setTimeout(showBubble, 2800);

    const openChat = () => {
      dismissBubble();
      shownBubble = true;
      panel.hidden = false;
      root.classList.add('is-open');
      launcher.setAttribute('aria-expanded', 'true');
      if (window.matchMedia('(max-width: 600px)').matches) {
        previousOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        scrollLocked = true;
      }
      input.focus();
    };

    const closeChat = () => {
      panel.hidden = true;
      root.classList.remove('is-open');
      launcher.setAttribute('aria-expanded', 'false');
      if (scrollLocked) {
        document.body.style.overflow = previousOverflow;
        scrollLocked = false;
      }
      launcher.focus();
    };

    function addMessage(text: string, role: 'bot' | 'user', action?: { label: string; anchor: string }) {
      const node = document.createElement('div');
      node.className = `chat-message is-${role}`;
      node.textContent = text; // Никогда не вставляем содержимое пользователя как HTML.
      log.insertBefore(node, topics);
      if (action) {
        const link = document.createElement('a');
        link.className = 'cat-action';
        link.textContent = `${action.label} ↗`;
        link.href = action.anchor;
        link.addEventListener('click', () => closeChat());
        log.insertBefore(link, topics);
      }
      log.scrollTop = log.scrollHeight;
    }

    function replyToTopic(topic: Topic, userText: string) {
      addMessage(userText, 'user');
      const responses: Record<Topic, string> = {
        projects: texts.project, prices: texts.pricing, services: texts.service, contact: texts.contact,
      };
      addMessage(responses[topic], 'bot', { label: texts.labels[topic], anchor: topic === 'prices' ? '#pricing' : topic === 'services' ? '#services' : topic === 'contact' ? '#contact' : '#projects' });
    }

    function detectTopic(value: string): Topic | null {
      const q = value.toLowerCase();
      if (/preis|kosten|cost|price|budget|цена|стоим|сколько/.test(q)) return 'prices';
      if (/projekt|portfolio|project|work|работ|проект|пример/.test(q)) return 'projects';
      if (/kontakt|contact|whatsapp|email|связ|контакт|напис/.test(q)) return 'contact';
      if (/website|webseite|service|leistung|angebot|сайт|услуг|landing|cms|design/.test(q)) return 'services';
      return null;
    }

    launcher.addEventListener('click', openChat);
    closer.addEventListener('click', closeChat);
    dismiss.addEventListener('click', dismissBubble);

    topics.querySelectorAll<HTMLButtonElement>('[data-cat-topic]').forEach((button) => {
      button.addEventListener('click', () => {
        const topic = button.dataset.catTopic as Topic;
        replyToTopic(topic, texts.names[topic]);
      });
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const value = input.value.trim();
      if (!value) return;
      input.value = '';
      const topic = detectTopic(value);
      if (topic) replyToTopic(topic, value);
      else { addMessage(value, 'user'); addMessage(texts.unknown, 'bot'); }
    });

    document.addEventListener('keydown', (event) => {
      if (panel.hidden) return;
      if (event.key === 'Escape') { closeChat(); return; }
      if (event.key === 'Tab' && window.matchMedia('(max-width: 600px)').matches) {
        const focusables = Array.from(panel.querySelectorAll<HTMLElement>('button:not([disabled]), input:not([disabled]), a[href]'));
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
        if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
      }
    });
  }
</script>

<style>
  .hirda-cat { --cat-ink: #20272b; --cat-accent: #f6b17b; --cat-paper: #f4f1eb; font-family: var(--font-body, system-ui, sans-serif); position: fixed; z-index: 900; bottom: calc(14px + env(safe-area-inset-bottom)); right: 14px; color: #20272b; }
  .cat-launcher { position: relative; display: block; width: 94px; height: 100px; padding: 0; border: 0; outline-offset: -5px; background: transparent; cursor: pointer; -webkit-tap-highlight-color: transparent; filter: drop-shadow(0 10px 12px #0007); transform-origin: 50% 90%; animation: cat-float 4s ease-in-out infinite; }
  .cat-launcher:hover { animation-play-state: paused; transform: translateY(-5px) scale(1.04); }
  .cat-launcher img { position: relative; z-index: 1; width: 100%; height: 100%; object-fit: contain; }
  .launcher-glow { position: absolute; width: 36px; height: 10px; border-radius: 50%; background: #f6b17b80; filter: blur(15px); bottom: 3px; left: 28px; animation: cat-pulse 3s ease-in-out infinite; }
  .cat-bubble { position: absolute; width: min(245px, calc(100vw - 125px)); right: 75px; bottom: 102px; padding: 15px 33px 15px 16px; background: #f4f1eb; color: #1f272b; border-radius: 16px 16px 4px 16px; box-shadow: 0 14px 30px #0004; border: 1px solid #f6b17b7a; animation: cat-appear .45s cubic-bezier(.2,.8,.2,1) both; }
  .cat-bubble::after { content: ''; position: absolute; right: -7px; bottom: 10px; width: 13px; height: 13px; transform: rotate(45deg); background: #f4f1eb; border-right: 1px solid #f6b17b7a; border-top: 1px solid #f6b17b7a; }
  .cat-bubble p { margin: 0; font-size: 13px; line-height: 1.55; font-weight: 600; }
  .bubble-close { position: absolute; top: 7px; right: 7px; border: 0; background: transparent; color: #596064; font: 400 22px/1 system-ui; cursor: pointer; }
  .cat-panel { position: absolute; right: 0; bottom: 0; width: min(390px, calc(100vw - 28px)); height: min(590px, calc(100dvh - 32px)); border-radius: 23px; overflow: hidden; background: #f7f5f0; box-shadow: 0 23px 70px #0009; display: flex; flex-direction: column; border: 1px solid #ffffff36; animation: cat-panel-in .28s cubic-bezier(.2,.75,.2,1) both; }
  .cat-panel[hidden], .cat-bubble[hidden] { display: none !important; }
  .hirda-cat.is-open .cat-launcher { visibility: hidden; pointer-events: none; }
  .cat-head { background: #22282c; color: #f4f1eb; padding: 18px 18px; min-height: 76px; display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
  .head-mark { width: 39px; height: 39px; border-radius: 12px; background: #f6b17b; display: grid; place-items: center; font-size: 24px; color: #22282c; }
  .head-copy { flex: 1; min-width: 0; }
  .head-copy h2 { margin: 0; font-size: 14px; letter-spacing: .08em; line-height: 1.35; }
  .head-copy p { margin: 4px 0 0; font-size: 11px; color: #b9c2bd; display: flex; align-items: center; gap: 7px; }
  .status-dot { width: 6px; height: 6px; border-radius: 50%; background: #8acdb0; }
  .cat-close { display: grid; place-items: center; width: 40px; height: 40px; flex-shrink: 0; border: 1px solid #ffffff2b; border-radius: 12px; color: #f4f1eb; background: #ffffff08; cursor: pointer; }
  .cat-conversation { min-height: 0; flex: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; overflow-y: auto; overscroll-behavior: contain; padding: 22px 17px; }
  .chat-intro { color: #90938f; font-size: 11px; text-align: center; align-self: center; margin: 0 0 5px; }
  .cat-conversation :global(.chat-message) { max-width: 88%; border-radius: 16px; padding: 13px 15px; font-size: 13px; line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere; box-shadow: 0 4px 10px #0000000a; }
  .cat-conversation :global(.chat-message.is-bot) { background: white; color: #20272b; border-bottom-left-radius: 4px; }
  .cat-conversation :global(.chat-message.is-user) { align-self: flex-end; background: #242e32; color: white; border-bottom-right-radius: 4px; }
  .cat-topics { display: flex; flex-wrap: wrap; gap: 8px; margin: 5px 0 0; }
  .cat-topics button { border: 1px solid #c5cac3; border-radius: 99px; padding: 9px 12px; background: #ffffff; color: #20272b; font-family: inherit; font-size: 12px; font-weight: 600; line-height: 1.25; cursor: pointer; transition: border-color .2s, transform .2s; }
  .cat-topics button:hover { border-color: #d38b54; transform: translateY(-2px); }
  .cat-conversation :global(.cat-action) { border: 1px solid #deb086; border-radius: 10px; background: #fff4e9; color: #49321f; padding: 9px 12px; font-size: 12px; font-weight: 700; text-decoration: none; }
  .cat-compose { flex-shrink: 0; display: flex; align-items: center; gap: 8px; border-top: 1px solid #e2e2dc; background: #fff; padding: 12px 12px 8px; }
  .cat-compose input { min-width: 0; min-height: 43px; flex: 1; padding: 10px 11px; border: 1px solid #dedfd9; border-radius: 12px; background: #fafaf8; color: #20272b; font-family: inherit; font-size: 14px; line-height: 1.4; }
  .cat-compose input::placeholder { color: #858c89; }
  .cat-compose button { width: 43px; height: 43px; border: 0; border-radius: 12px; background: #22282c; color: #f4f1eb; display: grid; place-items: center; cursor: pointer; }
  .cat-notice { flex-shrink: 0; padding: 2px 12px 12px; margin: 0; background: #fff; color: #8a908c; font-size: 10px; line-height: 1.45; text-align: center; }
  .hirda-cat button:focus-visible, .hirda-cat a:focus-visible, .hirda-cat input:focus-visible { outline: 2px solid #f6b17b; outline-offset: 3px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @keyframes cat-float { 0%, 100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-7px) rotate(1.5deg); } }
  @keyframes cat-pulse { 0%, 100% { opacity: .45; transform: scale(.9); } 50% { opacity: .8; transform: scale(1.15); } }
  @keyframes cat-appear { from { opacity: 0; transform: translate(7px, 12px) scale(.96); } to { opacity: 1; transform: none; } }
  @keyframes cat-panel-in { from { opacity: 0; transform: translateY(15px) scale(.98); } to { opacity: 1; transform: none; } }
  @media (max-width: 600px) {
    .hirda-cat { bottom: calc(8px + env(safe-area-inset-bottom)); right: 9px; }
    .cat-launcher { width: 78px; height: 85px; }
    .cat-bubble { bottom: 95px; right: 56px; width: min(225px, calc(100vw - 100px)); }
    .cat-panel { position: fixed; inset: 0; width: 100%; height: 100dvh; max-height: none; border: 0; border-radius: 0; }
    .cat-head { padding-top: calc(16px + env(safe-area-inset-top)); }
    .cat-compose { padding-bottom: calc(8px + env(safe-area-inset-bottom)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cat-launcher, .launcher-glow, .cat-bubble, .cat-panel { animation: none !important; }
    .cat-topics button { transition: none; }
  }
</style>
