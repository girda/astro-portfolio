---
import './mobile-heroes.css';
import './interface-polish.css';
---
<script>
 import { initSiteMotion } from './site-motion';
 initSiteMotion();
</script>
<style is:global>
  body[data-demo] {
    --motion-fast: 240ms;
    --motion-image: 700ms;
    --motion-ease: cubic-bezier(.2,.7,.2,1);
  }
  @media (prefers-reduced-motion: no-preference) {
    body[data-demo] dialog[open] {animation: hirda-dialog-enter 240ms var(--motion-ease);}
    body[data-demo] :is(.cta,.button,.text-link) > svg:last-child {
      transition: translate var(--motion-fast) var(--motion-ease);
    }
    @keyframes hirda-dialog-enter {
      from {opacity: 0; translate: 0 10px; scale: .985;}
      to {opacity: 1; translate: 0 0; scale: 1;}
    }
  }
  @media (hover:hover) and (pointer:fine) and (prefers-reduced-motion:no-preference) {
    body[data-demo] :is(.cta,.button,.text-link):hover > svg:last-child {translate: 3px 0;}
    body[data-demo] :is(.photo-service,.garden-gallery article,.service-card) {
      transition: translate 350ms var(--motion-ease), box-shadow 350ms var(--motion-ease), border-color 350ms;
    }
    body[data-demo] :is(.photo-service,.garden-gallery article,.service-card):hover {translate: 0 -3px;}
    body[data-demo] :is(.photo-service,.garden-gallery article) > img {
      transition: scale var(--motion-image) var(--motion-ease);
    }
    body[data-demo] :is(.photo-service,.garden-gallery article):hover > img {scale: 1.035;}
  }
</style>
