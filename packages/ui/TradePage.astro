---
import ReviewCarousel from './ReviewCarousel.astro';
import SiteMotion from './SiteMotion.astro';
import Icon from './Icon.astro';
import DemoMenu from './DemoMenu.astro';
import ServiceBrand from './ServiceBrand.astro';
import ServiceQuote from './ServiceQuote.astro';
import './service-base.css';
import './trade-themes.css';
import type {TradeSite} from './trade-types';
interface Props {site:TradeSite}
const {site:s}=Astro.props;
const asset=(file:string)=>`${import.meta.env.BASE_URL}images/${file}`;
const links=[{label:'Leistungen',href:'#leistungen'},{label:'Über uns',href:'#ueber'},{label:'So geht’s',href:'#ablauf'},{label:'Fragen',href:'#fragen'},{label:'Kontakt',href:'#kontakt'}];
---
<!doctype html><html lang="de"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={`${s.name} – ${s.tagline}. Interaktives Website-Konzept von HIRDA, kein echter Dienstleistungsanbieter.`}/><title>{s.name} — {s.tagline}</title><meta name="robots" content="noindex,follow"/><link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`}/></head>
<body data-demo={s.kind} class:list={['trade',s.kind]}><a class="skip" href="#main">Zum Inhalt</a>
<header class="shell site-header"><ServiceBrand name={s.name} tagline={s.tagline} kind={s.kind}/><nav class="desktop-nav" aria-label="Hauptnavigation">{links.map(l=><a href={l.href}>{l.label}</a>)}</nav><a class="cta header-cta" href="#kontakt">{s.kind==='electrical'?'Projekt anfragen':'Anfrage vorbereiten'}{s.kind==='electrical'&&<Icon name="zap"/>}</a><DemoMenu name={s.name} links={links}/></header>
<main id="main">
<section class="main-hero"><img class="hero-photo" src={asset(s.hero)} alt={s.heroAlt} width="1672" height="941" fetchpriority="high"/><div class="hero-overlay"></div><div class="shell"><div class="hero-copy"><p class="eyebrow">{s.kind==='electrical'&&<Icon name="zap"/>}{s.eyebrow}</p><h1>{s.headline[0]}<br/><em>{s.headline[1]}</em></h1><p class="hero-description">{s.description}</p><div class="actions"><a class="cta" href="#kontakt">{s.kind==='gardens'?'Deinen Garten planen':'Service anfragen'}</a><a class="cta ghost" href="#leistungen">Leistungen entdecken</a></div><div class="hero-trust">{s.benefits.slice(0,3).map(b=><span><Icon name={b.icon}/>{b.title}</span>)}</div></div></div>{s.kind==='electrical'&&<div class="voltage-cut" aria-hidden="true"></div>}</section>
{s.kind==='electrical'&&<section id="ueber" class="shell space split about-block"><img class="split-photo electrical-detail" src={asset(s.hero)} alt="Messung an einer Elektroverteilung" width="700" height="500" loading="lazy"/><div><p class="eyebrow">Über das Konzept</p><h2>{s.aboutTitle}</h2><p>{s.aboutText}</p><ul class="check-list">{s.aboutPoints.map(p=><li><Icon name="shield-check"/>{p}</li>)}</ul></div></section>}
<section id="leistungen" class="space services-section"><div class="shell"><div class="section-intro center"><p class="eyebrow">Unsere Leistungen</p><h2>{s.servicesTitle}</h2><p>{s.servicesIntro}</p></div><div class="service-grid">{s.services.map(service=><a class="service-card" href="#kontakt" data-service-choice={service.title}><Icon name={service.icon}/><h3>{service.title}</h3><p>{service.text}</p><span class="service-link">{s.kind==='homeservice'?'Service auswählen':'Mehr erfahren'}<Icon name="arrow-right"/></span></a>)}</div></div></section>
{s.kind==='electrical'&&<div class="feature-band"><div class="shell">{[{icon:'house',label:'Für dein Zuhause'},{icon:'building-2',label:'Für dein Unternehmen'},{icon:'shield-check',label:'Sorgfältig geplant'},{icon:'message-circle',label:'Persönlich abgestimmt'}].map(b=><span><Icon name={b.icon}/>{b.label}</span>)}</div></div>}
{s.kind==='homeservice'&&<section class="shell space fixora-reasons" id="ueber"><div class="fixora-reasons-copy"><p class="eyebrow">Einfach gut erledigt</p><h2>{s.aboutTitle}</h2><p>{s.aboutText}</p><div class="benefit-list">{s.benefits.map(b=><article><Icon name={b.icon}/><h3>{b.title}</h3><p>{b.text}</p></article>)}</div></div><div class="booking-demo"><p class="eyebrow">So einfach kann Service sein</p><h3>Dein Projekt. Ein klarer Ablauf.</h3><div class="phone-flow">{s.process.map((step,i)=><div class="phone-step"><div class="mini-phone"><span class="phone-island"></span><small>FIXORA</small><Icon name={step.icon}/><strong>{step.title}</strong><div class="mini-lines"><i></i><i></i><i></i></div><span class="mini-button">{i===3?'Entwurf bereit':'Weiter'}</span></div><span>{step.title}</span></div>)}</div><p class="phone-note">Ablauf-Vorschau · keine echte Terminbuchung</p></div></section>}
{s.kind==='homeservice'&&<div class="feature-band"><div class="shell">{s.aboutPoints.map((p,i)=><span><Icon name={['house','wrench','shield-check','calendar-days'][i]}/>{p}</span>)}</div></div>}
{s.kind==='gardens'&&<section class="shell space split garden-about" id="ueber"><div class="garden-photo-wrap"><img class="split-photo" src={asset(s.hero)} alt="naturnahe Pflanzung und Natursteinweg" width="800" height="650" loading="lazy"/><span class="garden-stamp"><Icon name="leaf"/>Mit der Natur gedacht.</span></div><div><p class="eyebrow">Gärten mit Charakter</p><h2>{s.aboutTitle}</h2><p>{s.aboutText}</p><ul class="check-list">{s.aboutPoints.map(p=><li><Icon name="check"/>{p}</li>)}</ul><a class="cta ghost" href="#kontakt">Erzähl uns von deinem Garten</a></div></section>}
{s.kind==='gardens'&&<section class="space soft-section" id="ideen"><div class="shell"><div class="section-intro"><p class="eyebrow">Raum für Ideen</p><h2>Ein Garten. Viele Möglichkeiten.</h2><p>Beispielvisualisierungen für unterschiedliche Wünsche. Keine ausgeführten Kundenprojekte.</p></div><div class="garden-tabs" role="group" aria-label="Gartenideen filtern">{['Alle Ideen','Pflanzen','Wege & Terrassen'].map((title,i)=><button type="button" aria-pressed={i===0?'true':'false'} data-garden-filter={i}>{title}</button>)}</div><div class="garden-gallery">{[{title:'Natürlich geborgen',tag:'Pflanzen',cat:1,pos:'center',photo:'garden-planting.webp'},{title:'Draußen zu Hause',tag:'Terrasse',cat:2,pos:'center',photo:'garden-terrace.webp'},{title:'Wege ins Grüne',tag:'Naturstein',cat:2,pos:'70% bottom',photo:s.hero}].map(item=><article data-garden-item={item.cat}><img src={asset(item.photo)} style={`object-position:${item.pos}`} alt={`${item.title}`} width="600" height="750" loading="lazy"/><div><span>{item.tag}</span><h3>{item.title}</h3></div></article>)}</div></div></section>}
<section id="ablauf" class="shell space"><div class="section-intro"><p class="eyebrow">Von der Idee zum Ergebnis</p><h2>{s.kind==='gardens'?'Dein Garten beginnt mit einem Gespräch.':'Klar besprochen. Gut vorbereitet.'}</h2></div><div class="steps">{s.process.map(step=><article><span class="step-icon"><Icon name={step.icon}/></span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div></section>
{s.kind!=='gardens'&&<section class="soft-section space"><div class="shell split"><img class="split-photo" src={asset(s.hero)} alt={s.heroAlt} width="800" height="600" loading="lazy"/><div><p class="eyebrow">Auf die Details kommt es an</p><h2>{s.kind==='electrical'?'Technik, die zu deinem Alltag passt.':'Mehr Zeit für das, was dir wichtig ist.'}</h2><p>{s.kind==='electrical'?'Von der einzelnen Leuchte bis zur geplanten Modernisierung: Eine gute Lösung beginnt mit den richtigen Fragen. Dieses Konzept zeigt, wie ein Betrieb seine Leistungen klar und verständlich präsentieren kann.':'Eine Leuchte, die noch wartet. Ein Regal, das endlich hängen soll. Ein Zuhause, das Schritt für Schritt so wird, wie du es möchtest. Wähle eine Leistung und teste die Projektanfrage.'}</p><a class="cta" href="#kontakt">Dein Vorhaben besprechen</a></div></div></section>}
<section class="shell space split" id="fragen"><div class="section-intro"><p class="eyebrow">Gut zu wissen</p><h2>Ein paar Antworten.<br/>Ganz unkompliziert.</h2><p>Die wichtigsten Fragen zum Servicekonzept und zur Demo.</p></div><div class="faq">{s.faq.map(([q,a])=><details><summary>{q}<Icon name="chevron-down"/></summary><p>{a}</p></details>)}</div></section>
<section class="soft-section space" id="kontakt"><div class="shell split"><div class="section-intro"><p class="eyebrow">Dein nächster Schritt</p><h2>{s.kind==='gardens'?'Was wünschst du dir für deinen Garten?':'Was können wir für dich vorbereiten?'}</h2><p>Wähle eine Leistung und beschreibe kurz dein Vorhaben. In dieser Demo siehst du direkt eine Zusammenfassung — ohne Versand, Zahlung oder echte Buchung.</p><ul class="check-list"><li><Icon name="map-pin"/>München & Umgebung · Beispielregion</li><li><Icon name="message-circle"/>Alles beginnt mit deiner Idee</li></ul></div><ServiceQuote services={s.services} name={s.name}/></div></section>
<ReviewCarousel project={s.kind} />
</main><footer class="shell site-footer"><div class="footer-main"><div><ServiceBrand name={s.name} tagline={s.tagline} kind={s.kind}/><p>Guter Service beginnt mit einem klaren Gespräch.</p></div><div><strong>Entdecken</strong><nav>{links.slice(0,3).map(l=><a href={l.href}>{l.label}</a>)}</nav></div><div><strong>Dein Projekt</strong><nav><a href="#kontakt">Anfrage ausprobieren</a><a href="#fragen">Häufige Fragen</a></nav></div><div><strong>Persönlich geplant</strong><nav><a href="#leistungen">Leistungen entdecken</a><a href="#kontakt">Dein Vorhaben besprechen</a></nav></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} {s.name}</span><a href="#main">Nach oben</a></div></footer>
<script>
const filters=document.querySelectorAll<HTMLButtonElement>('[data-garden-filter]'); filters.forEach(button=>button.addEventListener('click',()=>{filters.forEach(b=>b.setAttribute('aria-pressed',String(b===button))); document.querySelectorAll<HTMLElement>('[data-garden-item]').forEach(item=>{item.hidden=button.dataset.gardenFilter!=='0'&&item.dataset.gardenItem!==button.dataset.gardenFilter;});}));
</script>
{import.meta.env.DEV && <script is:inline>if(location.hash.includes('figmacapture=')){const capture=document.createElement('script');capture.src='https://mcp.figma.com/mcp/html-to-design/capture.js';capture.async=true;document.head.appendChild(capture);}</script>}
<SiteMotion /></body></html>
