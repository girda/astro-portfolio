---
import Icon from "./Icon.astro";
interface Props {
  links: { label: string; href: string }[];
  name: string;
  label?: string;
}
const { links, name, label = "Menü" } = Astro.props;
const id = `demo-menu-${name.toLowerCase().replace(/[^a-z0-9]/g, "")}`;
---

<button
  class="demo-menu-trigger"
  type="button"
  aria-label={label}
  aria-haspopup="dialog"
  aria-controls={id}
  aria-expanded="false"
>
  <Icon name="menu" />
</button>
<dialog class="demo-menu" id={id} data-demo-menu>
  <div class="demo-menu-top">
    <strong>{name}</strong>
    <button type="button" data-menu-close aria-label={label==="Меню"?"Закрыть меню":label==="Menu"?"Close menu":"Menü schließen"}>
      <Icon name="x" />
    </button>
  </div>
  <nav aria-label={label}>
    {links.map((link, i) => (
      <a href={link.href} style={`--i:${i}`}>
        <span>{link.label}</span>
        <Icon name="chevron-right" />
      </a>
    ))}
  </nav>
  <p>Ein Designkonzept von HIRDA</p>
</dialog>
<script>
  import { onPageReady } from './page-lifecycle';
  onPageReady(() => {
    const events = new AbortController();
    const options = {signal: events.signal};
    const desktop = matchMedia('(min-width:901px)');
    for (const menu of document.querySelectorAll<HTMLDialogElement>('[data-demo-menu]')) {
      const trigger = document.querySelector<HTMLButtonElement>(`[aria-controls="${menu.id}"]`);
      if (!trigger) continue;
      const close = () => menu.close();
      trigger.addEventListener('click', () => {
        if (menu.open) return;
        menu.showModal(); trigger.setAttribute('aria-expanded', 'true');
      }, options);
      menu.querySelector('[data-menu-close]')?.addEventListener('click', close, options);
      menu.querySelectorAll('a').forEach(link => link.addEventListener('click', close, options));
      menu.addEventListener('close', () => trigger.setAttribute('aria-expanded', 'false'), options);
      desktop.addEventListener('change', () => { if (desktop.matches && menu.open) close(); }, options);
    }
    return () => events.abort();
  });
</script>
